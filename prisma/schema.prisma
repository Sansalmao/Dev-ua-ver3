// ============================================================================
//  UA WG LACNOG — schema.prisma (Versión Corregida para SQLite)
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
//  USER
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String?

  // Valores esperados: 'PROFESOR' | 'ESTUDIANTE'
  profileType  String

  isAdmin      Boolean  @default(false)

  // Valores esperados: 'PENDING' | 'VERIFIED' | 'REJECTED'
  teacherVerificationStatus String @default("PENDING")

  ownedCommunities Community[] @relation("CommunityOwner")
  joinRequests     JoinRequest[] @relation("JoinRequester")
  reviewedRequests JoinRequest[] @relation("JoinReviewer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileType])
  @@index([teacherVerificationStatus])
}

// ─────────────────────────────────────────────────────────────────────────────
//  COMMUNITY
// ─────────────────────────────────────────────────────────────────────────────

model Community {
  id    String @id @default(cuid())
  name  String
  topic String

  // Valores esperados: 'TEACHER' | 'STUDENT'
  profileTrack String

  // Valores esperados: 'CONCEPTOS_CLAVE' | 'IMPLEMENTACION_TECNICA'
  stage        String @default("CONCEPTOS_CLAVE")

  graduated    Boolean   @default(false)
  graduatedAt  DateTime?

  teacher      User      @relation("CommunityOwner", fields: [teacherId], references: [id])
  teacherId    String

  joinRequests JoinRequest[]
  challenges   Challenge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId])
  @@index([profileTrack])
  @@index([stage])
}

// ─────────────────────────────────────────────────────────────────────────────
//  JOIN REQUEST
// ─────────────────────────────────────────────────────────────────────────────

model JoinRequest {
  id String @id @default(cuid())

  requester   User   @relation("JoinRequester", fields: [requesterId], references: [id])
  requesterId String

  community   Community @relation(fields: [communityId], references: [id])
  communityId String

  // Valores esperados: 'PENDING' | 'APPROVED' | 'REJECTED'
  status       String @default("PENDING")
  rejectReason String?

  reviewedBy   User?   @relation("JoinReviewer", fields: [reviewedById], references: [id])
  reviewedById String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requesterId, communityId])
  @@index([communityId, status])
  @@index([requesterId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
//  CHALLENGE
// ─────────────────────────────────────────────────────────────────────────────

model Challenge {
  id      String @id @default(cuid())
  title   String
  summary String?

  // Valores esperados: 'CONCEPTOS_CLAVE' | 'IMPLEMENTACION_TECNICA'
  requiredStage String

  community   Community @relation(fields: [communityId], references: [id])
  communityId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([communityId, requiredStage])
}
