// ============================================================================
//  UA WG LACNOG — schema.prisma (Versión Corregida para SQLite)
// ============================================================================

generator client {
  // En Prisma 7 los driver adapters son GA: ya NO se declara "driverAdapters"
  // en previewFeatures (hacerlo provoca un error de validación).
  provider = "prisma-client-js"
}

datasource db {
  // Prisma 7: la datasource del schema solo lleva `provider`.
  // La URL de conexión para Migrate vive ahora en prisma.config.ts, y el
  // runtime se conecta con el `adapter` (ver src/lib/prisma.js).
  provider = "sqlite"
}

// ─────────────────────────────────────────────────────────────────────────────
//  USER
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id String @id @default(cuid())

  // ── Campos "core" que Better Auth requiere en el modelo user ─────────────
  // `displayName` hace las veces del campo `name` de Better Auth (mapeado en
  // src/lib/auth-server.ts vía `user.fields.name = "displayName"`, para no
  // duplicar columnas ni tocar los endpoints que ya leen `displayName`).
  displayName   String?
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?

  // ── Campos propios de la app (auditoría v2.2 + informe v2.0) ─────────────
  // Valores esperados: 'PROFESOR' | 'ESTUDIANTE'
  profileType  String

  isAdmin      Boolean  @default(false)

  // Valores esperados: 'PENDING' | 'VERIFIED' | 'REJECTED'
  teacherVerificationStatus String @default("PENDING")

  // T4.4 — progreso del preview de la Ruta A. Depende de la confirmación de
  // producto (E5). El endpoint route-preview-progress.js lo usa.
  hasCompletedRouteAPreview Boolean @default(false)

  // ── Relaciones de Better Auth (sesión + credenciales) ─────────────────────
  sessions Session[]
  accounts Account[]

  ownedCommunities Community[] @relation("CommunityOwner")
  joinRequests     JoinRequest[] @relation("JoinRequester")
  reviewedRequests JoinRequest[] @relation("JoinReviewer")

  submissions         Submission[] @relation("SubmissionAuthor")
  reviewedSubmissions Submission[] @relation("SubmissionReviewer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileType])
  @@index([teacherVerificationStatus])
}

// ─────────────────────────────────────────────────────────────────────────────
//  BETTER AUTH — Session / Account / Verification
//  Nombres y campos siguen el esquema "core" que espera el adapter de Prisma
//  (@better-auth/prisma-adapter). No renombrar sin actualizar auth-server.ts.
// ─────────────────────────────────────────────────────────────────────────────

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Credenciales por proveedor. Para email+password, Better Auth crea una fila
// con providerId = "credential" y guarda el hash en `password` (NO en User).
model Account {
  id         String @id @default(cuid())
  accountId  String
  providerId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  accessToken            String?
  refreshToken           String?
  idToken                String?
  accessTokenExpiresAt   DateTime?
  refreshTokenExpiresAt  DateTime?
  scope                  String?
  password               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Tokens de verificación de email / reset de password / etc.
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  @@index([identifier])
}

// ─────────────────────────────────────────────────────────────────────────────
//  COMMUNITY
// ─────────────────────────────────────────────────────────────────────────────

model Community {
  id    String @id @default(cuid())
  name  String
  topic String

  // Valores esperados: 'TEACHER' | 'STUDENT'
  profileTrack String

  // Valores esperados: 'CONCEPTOS_CLAVE' | 'IMPLEMENTACION_TECNICA'
  stage        String @default("CONCEPTOS_CLAVE")

  graduated    Boolean   @default(false)
  graduatedAt  DateTime?

  teacher      User      @relation("CommunityOwner", fields: [teacherId], references: [id])
  teacherId    String

  joinRequests JoinRequest[]
  challenges   Challenge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId])
  @@index([profileTrack])
  @@index([stage])
}

// ─────────────────────────────────────────────────────────────────────────────
//  JOIN REQUEST
// ─────────────────────────────────────────────────────────────────────────────

model JoinRequest {
  id String @id @default(cuid())

  requester   User   @relation("JoinRequester", fields: [requesterId], references: [id])
  requesterId String

  community   Community @relation(fields: [communityId], references: [id])
  communityId String

  // Valores esperados: 'PENDING' | 'APPROVED' | 'REJECTED'
  status       String @default("PENDING")
  rejectReason String?

  reviewedBy   User?   @relation("JoinReviewer", fields: [reviewedById], references: [id])
  reviewedById String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requesterId, communityId])
  @@index([communityId, status])
  @@index([requesterId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
//  CHALLENGE
// ─────────────────────────────────────────────────────────────────────────────

model Challenge {
  id      String @id @default(cuid())
  title   String
  summary String?

  // Valores esperados: 'CONCEPTOS_CLAVE' | 'IMPLEMENTACION_TECNICA'
  requiredStage String

  community   Community @relation(fields: [communityId], references: [id])
  communityId String

  submissions Submission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([communityId, requiredStage])
}

// ─────────────────────────────────────────────────────────────────────────────
//  SUBMISSION  (soluciones/entregas de los miembros a un reto)
//
//  Conecta con el ChallengeFlow del frontend: el estudiante envía el repo de
//  su solución. La entrega nace PENDING y alguien del staff de la comunidad la
//  aprueba/rechaza (por ahora, el dueño; con la capa de roles se ampliará a
//  otros roles internos como "manager").
// ─────────────────────────────────────────────────────────────────────────────

model Submission {
  id String @id @default(cuid())

  challenge   Challenge @relation(fields: [challengeId], references: [id])
  challengeId String

  author   User   @relation("SubmissionAuthor", fields: [authorId], references: [id])
  authorId String

  // URL del repositorio / solución entregada.
  repoUrl String

  // Lenguaje elegido. Valores esperados: 'java' | 'python' | 'sql' | ...
  language String?

  // Valores esperados: 'PENDING' | 'APPROVED' | 'REJECTED'
  status String @default("PENDING")

  // Calificación opcional que asigna quien revisa (0–5).
  rating Float?

  rejectReason String?

  // Rol del miembro DENTRO de la comunidad (una vez aprobado).
  // Valores: 'ADMIN' | 'MANAGER' | 'MEMBER'. Default MEMBER.
  role String @default("MEMBER")

  reviewedBy   User?     @relation("SubmissionReviewer", fields: [reviewedById], references: [id])
  reviewedById String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Un autor tiene una sola entrega por reto (puede actualizarla, no duplicarla).
  @@unique([challengeId, authorId])
  @@index([challengeId, status])
  @@index([authorId, status])
}
