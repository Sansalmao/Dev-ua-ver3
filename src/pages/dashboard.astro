import "../styles/global.css";
import { getUserCommunityContext } from "@lib/community-context.js";
import { prisma } from "@lib/prisma.js";

const user = Astro.locals.user;
if (!user) {
    return Astro.redirect("/");
}

// ── Identidad del usuario logueado (para el pie del sidebar) ─────────────────
const meRecord = await prisma.user.findUnique({
    where: { id: user.userId },
    select: { displayName: true, email: true },
});
const meName = meRecord?.displayName?.trim() || meRecord?.email || "Usuario";
function computeInitials(name: string) {
    const base = name.includes("@") ? name.split("@")[0] : name;
    const words = base.trim().split(/[\s._-]+/).filter(Boolean);
    const letters =
        words.length >= 2
            ? words[0][0] + words[1][0]
            : (words[0] ?? "").slice(0, 2);
    return letters.toUpperCase() || "U";
}
const meInitials = computeInitials(meName);

// Propias ∪ miembro, sin duplicados, marcando la propiedad.
const { owned, member } = await getUserCommunityContext(user.userId);
const seen = new Set();
const communities = [];
for (const c of [
    ...owned.map((x) => ({ ...x, owned: true })),
    ...member.map((x) => ({ ...x, owned: false })),
]) {
    if (seen.has(c.id)) continue;
    seen.add(c.id);
    communities.push({
        id: c.id,
        name: c.name,
        profileTrack: c.profileTrack,
        stage: c.stage,
        owned: c.owned,
    });
}

// ── RUTAS (vista "Rutas de Aprendizaje") ────────────────────────────────────
const full = await prisma.community.findMany({
    where: { id: { in: communities.map((c) => c.id) } },
    select: {
        id: true,
        name: true,
        topic: true,
        profileTrack: true,
        stage: true,
        graduated: true,
        teacher: { select: { displayName: true, email: true } },
        _count: { select: { challenges: true } },
    },
});

const ownedIds = new Set(communities.filter((c) => c.owned).map((c) => c.id));

const routes = await Promise.all(
    full.map(async (c) => {
        // Retos de esta comunidad con una entrega APROBADA del usuario actual.
        const completed = await prisma.challenge.count({
            where: {
                communityId: c.id,
                submissions: {
                    some: { authorId: user.userId, status: "APPROVED" },
                },
            },
        });
        return {
            id: c.id,
            // El prototipo usa `name` como etiqueta de tipo y `subtitle` como título.
            name: c.topic,
            subtitle: c.name,
            modules: c._count.challenges,
            completed,
            assignee: c.teacher?.displayName || c.teacher?.email || "—",
            // El filtro del prototipo trabaja en minúsculas.
            stage: String(c.stage).toLowerCase(),
            profileTrack:
                String(c.profileTrack).toUpperCase() === "TEACHER"
                    ? "teacher"
                    : "student",
            graduated: c.graduated,
            owned: ownedIds.has(c.id),
        };
    }),
);

const bootstrap = { meId: user.userId, communities, routes };

// ── RESUMEN: KPIs reales ────────────────────────────────────────────────────
const communityIds = communities.map((c) => c.id);
const ownedIdsArr = [...ownedIds];
const isProfesor = user.profileType === "PROFESOR";

const [
    totalChallenges,
    myApproved,
    myPendingSubs,
    pendingToReview,
    totalMembers,
    pendingJoinRequests,
] = await Promise.all([
    // Retos disponibles en mis comunidades.
    prisma.challenge.count({ where: { communityId: { in: communityIds } } }),
    // Retos que YO completé (entrega aprobada).
    prisma.submission.count({
        where: {
            authorId: user.userId,
            status: "APPROVED",
            challenge: { communityId: { in: communityIds } },
        },
    }),
    // Mis entregas esperando revisión.
    prisma.submission.count({
        where: { authorId: user.userId, status: "PENDING" },
    }),
    // Entregas que YO debo revisar (solo en comunidades que soy dueño).
    prisma.submission.count({
        where: {
            status: "PENDING",
            challenge: { communityId: { in: ownedIdsArr } },
        },
    }),
    // Miembros aprobados en mis comunidades.
    prisma.joinRequest.count({
        where: { status: "APPROVED", communityId: { in: communityIds } },
    }),
    // Solicitudes de ingreso pendientes en mis comunidades propias.
    prisma.joinRequest.count({
        where: { status: "PENDING", communityId: { in: ownedIdsArr } },
    }),
]);

const kpis = {
    challengesDone: myApproved,
    challengesTotal: totalChallenges,
    challengesPct: totalChallenges
        ? Math.round((myApproved / totalChallenges) * 100)
        : 0,
    communities: communities.length,
    owned: ownedIdsArr.length,
    // Para profesor: lo que debe revisar. Para estudiante: lo suyo en revisión.
    pending: isProfesor ? pendingToReview : myPendingSubs,
    pendingJoins: pendingJoinRequests,
    members: totalMembers,
};

// ── RESUMEN: feed de actividad ──────────────────────────────────────────────
const [recentSubs, recentJoins] = await Promise.all([
    prisma.submission.findMany({
        where: { challenge: { communityId: { in: communityIds } } },
        select: {
            id: true,
            status: true,
            createdAt: true,
            reviewedAt: true,
            author: { select: { displayName: true, email: true } },
            challenge: {
                select: { title: true, community: { select: { name: true } } },
            },
        },
        orderBy: { createdAt: "desc" },
        take: 8,
    }),
    prisma.joinRequest.findMany({
        where: { communityId: { in: communityIds } },
        select: {
            id: true,
            status: true,
            createdAt: true,
            reviewedAt: true,
            requester: { select: { displayName: true, email: true } },
            community: { select: { name: true } },
        },
        orderBy: { createdAt: "desc" },
        take: 8,
    }),
]);

/** "Hace 2 horas", "Ayer", "Hace 3 días"… */
function timeAgo(date: Date): string {
    const ms = Date.now() - date.getTime();
    const min = Math.floor(ms / 60000);
    if (min < 1) return "Recién";
    if (min < 60) return `Hace ${min} minuto${min === 1 ? "" : "s"}`;
    const h = Math.floor(min / 60);
    if (h < 24) return `Hace ${h} hora${h === 1 ? "" : "s"}`;
    const d = Math.floor(h / 24);
    if (d === 1) return "Ayer";
    if (d < 30) return `Hace ${d} días`;
    const mo = Math.floor(d / 30);
    return `Hace ${mo} mes${mo === 1 ? "" : "es"}`;
}

type FeedItem = { at: Date; teal: boolean; html: string; meta: string };
const feedItems: FeedItem[] = [];

for (const s of recentSubs) {
    const who = s.author?.displayName || s.author?.email || "Alguien";
    const comm = s.challenge?.community?.name ?? "";
    const title = s.challenge?.title ?? "un reto";
    if (s.status === "APPROVED" && s.reviewedAt) {
        feedItems.push({
            at: s.reviewedAt,
            teal: false,
            html: `<strong>${who}</strong> completó el reto "${title}"`,
            meta: comm,
        });
    } else if (s.status === "PENDING") {
        feedItems.push({
            at: s.createdAt,
            teal: true,
            html: `<strong>${who}</strong> envió una entrega para "${title}" — pendiente de aprobación`,
            meta: comm,
        });
    } else if (s.status === "REJECTED" && s.reviewedAt) {
        feedItems.push({
            at: s.reviewedAt,
            teal: false,
            html: `La entrega de <strong>${who}</strong> para "${title}" fue rechazada`,
            meta: comm,
        });
    }
}

for (const j of recentJoins) {
    const who = j.requester?.displayName || j.requester?.email || "Alguien";
    const comm = j.community?.name ?? "";
    if (j.status === "APPROVED" && j.reviewedAt) {
        feedItems.push({
            at: j.reviewedAt,
            teal: true,
            html: `<strong>${who}</strong> se unió a la comunidad`,
            meta: comm,
        });
    } else if (j.status === "PENDING") {
        feedItems.push({
            at: j.createdAt,
            teal: false,
            html: `<strong>${who}</strong> solicitó unirse a la comunidad`,
            meta: comm,
        });
    }
}

const feed = feedItems
    .sort((a, b) => b.at.getTime() - a.at.getTime())
    .slice(0, 6)
    .map((f) => ({
        teal: f.teal,
        html: f.html,
        time: [timeAgo(f.at), f.meta].filter(Boolean).join(" · "),
    }));
