---
// ============================================================================
//  Dashboard v2.0 — reubicado desde el prototipo (T1.4 del informe).
//
//  Se conservan su <style> y <script> ORIGINALES:
//    • <style is:global>  → tiene su propio design system (ámbar/teal). Según
//      el informe NO se reescribe con Tailwind. `is:global` evita que Astro
//      le agregue scoping y rompa los selectores.
//    • <script is:inline> → el markup usa handlers inline (onclick="switchView(...)"),
//      así que las funciones deben quedar en el ámbito global, sin bundling.
//
//  Protección de ruta: la app es SSR y el middleware ya resolvió la sesión de
//  Better Auth, así que basta con leer Astro.locals.user (no hay que tocar cookies).
//
//  ESTADO: los datos siguen siendo los MOCK del prototipo (members, solutions,
//  skillRoutes). El cableado a la API es el paso siguiente.
// ============================================================================
const user = Astro.locals.user;
if (!user) {
    return Astro.redirect("/");
}
---

<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>&gt;_ ua wg lacnog — Comunidad de Práctica</title>
</head>
<body>
<div id="app">

  <!-- ═══ SIDEBAR ═══ -->
  <aside id="sidebar">
    <div class="sb-logo">
      <div class="sb-logo-mark">&gt;_</div>
      <div>
        <div class="sb-logo-text">ua wg lacnog</div>
        <div class="sb-logo-sub">Comunidad de Práctica</div>
      </div>
    </div>
    <nav class="sb-nav">
      <div class="sb-section">Principal</div>
      <div class="sb-item active" data-nav="overview" onclick="navTo('overview',this)">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="1" width="6" height="6" rx="1.5"/><rect x="9" y="1" width="6" height="6" rx="1.5"/><rect x="1" y="9" width="6" height="6" rx="1.5"/><rect x="9" y="9" width="6" height="6" rx="1.5"/></svg>
