/* ── UTILIDADES ── */
function toast(msg) {
  var el = document.getElementById('toast');
  el.textContent = msg;
  el.classList.add('show');
  clearTimeout(toast._t);
  toast._t = setTimeout(function() { el.classList.remove('show'); }, 2800);
}

function reRender() {
  var v = state.currentView;
  if (v === 'members-view')   renderMembers();
  if (v === 'solutions-view') renderSolutions();
  if (v === 'skills-view')    renderSkills();
}

/* ── NAVEGACIÓN ── */
function switchView(id, el) {
  document.querySelectorAll('.view-section').forEach(function(s) { s.classList.remove('active'); });
  document.querySelectorAll('.view-tab').forEach(function(t) { t.classList.remove('active'); });
  document.getElementById(id).classList.add('active');
  el.classList.add('active');
  state.currentView = id;
  reRender();
}

function navTo(id, el) {
  document.querySelectorAll('.sb-item').forEach(function(i) { i.classList.remove('active'); });
  el.classList.add('active');
  var tab = document.querySelector('.view-tab[data-view="' + id + '"]');
  if (tab) switchView(id, tab);
}

/* ── RBAC ── */
function cycleRole() {
  var roles = ['admin', 'manager', 'member'];
  state.role = roles[(roles.indexOf(state.role) + 1) % roles.length];
  var badge = document.getElementById('role-badge');
  badge.textContent = state.role;
  badge.setAttribute('data-role', state.role);
  toast('🔄 Rol cambiado a: ' + state.role);
  reRender();
}

/* ── RENDER MIEMBROS ── */
function renderMembers() {
  var tbody     = document.getElementById('members-tbody');
  var theadRow  = document.getElementById('members-thead-row');
  var isManager = state.role === 'manager';
  var isMember  = state.role === 'member';

  /* Banners RBAC */
  document.getElementById('members-rbac-banner').classList.toggle('hidden', !isManager);
  document.getElementById('members-member-banner').classList.toggle('hidden', !isMember);

  tbody.innerHTML = '';

  if (isMember) {
    /* ── VISTA MEMBER: solo su propia fila, solo columnas Miembro + Rol ── */
    theadRow.innerHTML = '<th>Miembro</th><th>Rol</th>';

    /* El usuario propio es siempre el primer elemento del array (fnee) */
    var me = members[0];
    var row = document.createElement('tr');
    row.innerHTML =
      '<td><div class="member-cell">' +
        '<div class="m-avatar" style="background:' + me.color + '">' + me.initials + '</div>' +
        '<span>' + me.name + '</span>' +
      '</div></td>' +
      '<td><span class="role-pill role-member">' + me.role + '</span></td>';
    tbody.appendChild(row);
    return; /* no continuar con el render completo */
  }

  /* ── VISTA ADMIN / MANAGER: tabla completa ── */
  theadRow.innerHTML =
    '<th>Miembro</th><th>Rol</th><th>Ruta de Skills</th>' +
    '<th style="min-width:140px">Progreso</th><th>Acciones</th>';

  members.forEach(function(m) {
    var isRestricted = isManager && (m.role === 'admin' || m.role === 'manager');
    var roleClass = m.role === 'admin' ? 'role-admin' : m.role === 'manager' ? 'role-manager' : 'role-member';

    var isImpl   = m.ruta === 'Implementación Técnica';
    var rutaSvg  = isImpl
      ? '<svg width="11" height="11" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 8h12M9 3l5 5-5 5"/></svg>'
      : '<svg width="11" height="11" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="8" cy="8" r="6"/><path d="M8 5v3l2 2"/></svg>';
    var rutaBadge = '<span class="ruta-tag ' + (isImpl ? 'ruta-impl' : 'ruta-basic') + '">' + rutaSvg + m.ruta + '</span>';

    var actions;
    if (isRestricted) {
      actions = '<span class="muted-sm">🔒 Restringido</span>';
    } else if (state.role === 'admin') {
      actions =
        '<button class="m-btn m-btn-edit" onclick="toast(\'✏ Editando: ' + m.name + '\')">' +
          '<svg width="11" height="11" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 2l3 3-9 9H2v-3L11 2z"/></svg>Editar</button> ' +
        '<button class="m-btn m-btn-delete" onclick="toast(\'🗑 Eliminado: ' + m.name + '\')">' +
          '<svg width="11" height="11" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 4h12M5 4V2h6v2M6 7v5M10 7v5M3 4l1 9h8l1-9"/></svg>Eliminar</button>';
    } else {
      /* manager sobre filas no restringidas */
      actions =
        '<button class="action-btn" onclick="toast(\'✏ Editando: ' + m.name + '\')">✏ Editar</button>' +
        '<button class="action-btn" onclick="toast(\'⚙ Rol: ' + m.name + '\')">⚙ Rol</button>';
    }

    var row = document.createElement('tr');
    if (isRestricted) row.className = 'row-disabled';
    row.innerHTML =
      '<td><div class="member-cell"><div class="m-avatar" style="background:' + m.color + '">' + m.initials + '</div><span>' + m.name + '</span></div></td>' +
      '<td><span class="role-pill ' + roleClass + '">' + m.role + '</span></td>' +
      '<td>' + rutaBadge + '</td>' +
      '<td><div class="prog-cell"><div class="gp-bar-wrap"><div class="gp-bar" style="width:' + m.progress + '%"></div></div><span class="prog-pct">' + m.progress + '%</span></div></td>' +
      '<td>' + actions + '</td>';
    tbody.appendChild(row);
  });
}

/* ── RENDER RETOS ── */
function renderSolutions() {
  var grid    = document.getElementById('solutions-grid');
  var counter = document.getElementById('sol-counter');
  var rutaF   = document.getElementById('filter-skill').value;
  var sortF   = document.getElementById('filter-sort').value;
  var canApprove = state.role !== 'member';

  var filtered = solutions.filter(function(s) { return !rutaF || s.ruta === rutaF; });
  filtered.sort(function(a, b) {
    if (sortF === 'rating')  return b.rating - a.rating;
    if (sortF === 'pending') return (b.pending ? 1 : 0) - (a.pending ? 1 : 0);
    return b.date.localeCompare(a.date);
  });

  counter.textContent = filtered.length + ' reto' + (filtered.length !== 1 ? 's' : '');
  grid.innerHTML = '';
  var pending = 0;

  filtered.forEach(function(s) {
    if (s.pending) pending++;

    var statusPill = s.pending
      ? '<span class="pill sol-status-pending"><svg width="12" height="12" viewBox="0 0 16 16" fill="var(--amber)"><path d="M9 1L4 9h4v6l6-8H9V1z"/></svg>Pendiente</span>'
      : '<span class="pill sol-status-approved"><svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="#1a7a3a" stroke-width="2"><path d="M2 8l4 4 8-8"/></svg>Aprobada</span>';

    var isImpl = s.ruta === 'Implementación Técnica';
    var rutaTag = isImpl
      ? '<span class="sol-ruta-tag sol-ruta-tag-impl">' + ICON_IT + 'Implementación Técnica</span>'
      : '<span class="sol-ruta-tag sol-ruta-tag-basic">' + ICON_CB + 'Conceptos Básicos</span>';

    var isJava = s.lang === 'Java';
    var langTag = '<span class="sol-lang-tag ' + (isJava ? 'java' : 'python') + '">' + (isJava ? ICON_JAVA : ICON_PYTHON) + s.lang + '</span>';

    var full = Math.floor(s.rating), hasHalf = (s.rating - full) >= 0.3;
    var stars = '<span class="c-amber">★</span>'.repeat(full)
      + (hasHalf ? '<span class="c-amber" style="opacity:.5">★</span>' : '')
      + '<span style="color:var(--border)">★</span>'.repeat(5 - full - (hasHalf ? 1 : 0));

    var actions = (canApprove && s.pending)
      ? '<div class="sol-actions-v2">' +
          '<button class="sol-action-btn sol-btn-approve" onclick="approveSolution(this,' + JSON.stringify(s.title) + ')">Aprobar</button>' +
          '<button class="sol-action-btn sol-btn-reject"  onclick="rejectSolution(this,' + JSON.stringify(s.title) + ')">Rechazar</button>' +
        '</div>'
      : '';

    var card = document.createElement('div');
    card.className = 'sol-card';
    card.innerHTML =
      '<div class="sol-row-top"><div class="sol-title-v2">' + s.title + '</div>' + statusPill + '</div>' +
      '<div class="sol-row-meta"><div class="sol-author-v2"><div class="sol-author-icon">' + ICON_PERSON + '</div>' + s.author + '</div><div class="sol-date-v2">' + s.date + '</div></div>' +
      '<div class="sol-tag-row">' + rutaTag + '</div>' +
      '<div class="sol-row-lang">' + langTag + '<span class="sol-stars">' + stars + ' <span>' + s.rating + '</span></span><button class="sol-github-btn" onclick="toast(\'🔗 Repo: ' + s.title + '\')">' + ICON_GH + 'GitHub Repo</button></div>' +
      actions;
    grid.appendChild(card);
  });

  document.getElementById('sb-pending-count').textContent = pending;
}

function _mutSolution(btn, title, fn) {
  btn.closest('.sol-card').style.opacity = '0.5';
  var idx = solutions.findIndex(function(s) { return s.title === title; });
  if (idx !== -1) fn(idx);
  setTimeout(renderSolutions, 300);
}
function approveSolution(btn, title) {
  _mutSolution(btn, title, function(i) { solutions[i].pending = false; toast('✓ Reto aprobado: ' + title); });
}
function rejectSolution(btn, title) {
  _mutSolution(btn, title, function(i) { solutions.splice(i, 1); toast('✗ Reto rechazado: ' + title); });
}

/* ── RENDER RUTAS v4 ── */
function renderSkills() {
  var grid     = document.getElementById('skills-grid');
  var canEdit  = state.role === 'admin';
  var stageF   = document.getElementById('filter-stage').value;
  var trackF   = document.getElementById('filter-track').value;
  document.getElementById('skills-admin-banner').classList.toggle('hidden', canEdit);
  document.getElementById('skills-current-role').textContent = state.role;
  grid.innerHTML = '';

  /* SVG reutilizables para los tres estados de ícono */
  var SVG_CHECK  = '<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M2 8l4 4 8-8"/></svg>';
  var SVG_CURR   = '<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="8" cy="8" r="3"/><circle cx="8" cy="8" r="6"/></svg>';
  var SVG_LOCK   = '<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="3" y="7" width="10" height="8" rx="1.5"/><path d="M5 7V5a3 3 0 016 0v2"/></svg>';
  var SVG_ARROW  = '<svg width="11" height="11" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 8h12M9 3l5 5-5 5"/></svg>';
  var SVG_DOT    = '<svg width="11" height="11" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="8" cy="8" r="6"/><path d="M8 5v3l2 2"/></svg>';

  var filtered = skillRoutes.filter(function(r) {
    return (!stageF || r.stage === stageF) && (!trackF || r.profileTrack === trackF);
  });

  if (filtered.length === 0) {
    grid.innerHTML = '<div style="grid-column:1/-1;padding:30px;text-align:center;color:var(--muted);font-size:12.5px;background:var(--surface);border:1px dashed var(--border);border-radius:var(--radius)">Ninguna ruta coincide con los filtros seleccionados</div>';
    return;
  }

  filtered.forEach(function(r) {
    var pct  = Math.round((r.completed / r.modules) * 100);
    var card = document.createElement('div');
    card.className = 'skill-card-v4';

    /* ── Construir fila de íconos ──
       Regla: íconos anteriores al índice `completed` = done (verde),
       el índice exacto `completed` = current (naranja, si no está al 100%),
       el resto = locked (gris). Si completed === 0 todos son locked. */
    var icons = '';
    for (var i = 0; i < r.modules; i++) {
      if (i < r.completed) {
        icons += '<div class="sk4-icon done">'    + SVG_CHECK + '</div>';
      } else if (i === r.completed && r.completed < r.modules) {
        icons += '<div class="sk4-icon current">' + SVG_CURR  + '</div>';
      } else {
        icons += '<div class="sk4-icon locked">'  + SVG_LOCK  + '</div>';
      }
    }

    /* ── Barra de progreso ──
       Si el porcentaje es 0 se omite la barra de relleno
       (el contenedor `sk4-bar-wrap` aparece vacío = gris completo). */
    var barHtml = pct > 0
      ? '<div class="sk4-bar" style="width:' + pct + '%">' +
          '<span class="sk4-bar-pct">' + pct + '%</span>' +
        '</div>'
      : '';

    /* ── Badge de etapa (informe v1.5, N4) ──
       Reutiliza el mismo componente .ruta-tag ya usado en Miembros,
       evitando CSS nuevo. Texto resuelto por perfil vía STAGE_LABELS. */
    var isImpl = r.stage === 'implementacion_tecnica';
    var stageLabel = STAGE_LABELS[r.profileTrack][r.stage];
    var stageBadge = '<span class="ruta-tag ' + (isImpl ? 'ruta-impl' : 'ruta-basic') + '">' + (isImpl ? SVG_ARROW : SVG_DOT) + stageLabel + '</span>';

    /* ── Botón de promoción de etapa (informe v1.5, N3 — recomendación provisional) ──
       Solo visible para admin, y solo en rutas que aún están en conceptos_clave. */
    var promoteBtn = (canEdit && !isImpl)
      ? '<button class="btn btn-outline btn-sm" style="margin-top:10px;width:100%" onclick="promoteRouteStage(\'' + r.id + '\')">→ Promover a Implementación Técnica</button>'
      : '';

    card.innerHTML =
      /* Encabezado: etiqueta tipo + título + etapa + track */
      '<div class="sk4-header">' +
        '<div class="sk4-type">' + r.name + '</div>' +
        '<div class="sk4-title">' + r.subtitle + '</div>' +
        '<div style="display:flex;align-items:center;gap:8px;margin-top:8px;flex-wrap:wrap">' +
          stageBadge +
          '<span class="muted-sm">' + TRACK_LABELS[r.profileTrack] + '</span>' +
        '</div>' +
      '</div>' +

      /* Fila de progreso: nombre | barra | Tema X/Y */
      '<div class="sk4-prog-row">' +
        '<div class="sk4-name">' + r.assignee + '</div>' +
        '<div class="sk4-bar-wrap">' + barHtml + '</div>' +
        '<div class="sk4-tema"><b>Tema:</b> ' + r.completed + '/' + r.modules + '</div>' +
      '</div>' +

      /* Línea divisoria */
      '<hr class="sk4-divider">' +

      /* Sección de desafíos */
      '<div class="sk4-challenges">' +
        '<div class="sk4-ch-header">' +
          '<div class="sk4-ch-title">Desafíos de Código</div>' +
          '<div class="sk4-ch-level">Nivel: ' + r.level + '</div>' +
        '</div>' +
        '<div class="sk4-icons">' + icons + '</div>' +
        promoteBtn +
      '</div>';

    grid.appendChild(card);
  });
}

/* ── Promoción manual de etapa (informe v1.5, N3) ──
   Acción provisional reservada al rol admin, mientras el equipo define
   si la transición debe ser manual, aprobada o basada en métricas. */
function promoteRouteStage(routeId) {
  var route = skillRoutes.filter(function(r) { return r.id === routeId; })[0];
  if (!route || route.stage === 'implementacion_tecnica') return;
  route.stage = 'implementacion_tecnica';
  toast('→ "' + route.subtitle + '" promovida a Implementación Técnica');
  renderSkills();
}

/* ── INIT ── */
(function() {
  renderMembers();
  renderSolutions();
  renderSkills();
})();

</script>
