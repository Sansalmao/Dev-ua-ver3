                '<svg width="14" height="14" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg"><path d="M15.9 2C9.1 2 9.5 4.9 9.5 4.9l.01 3.1h6.5v.93H6.4S2 8.4 2 15.3s3.85 6.65 3.85 6.65H8.1v-3.2s-.13-3.85 3.79-3.85h6.52s3.67.06 3.67-3.54V5.93S22.6 2 15.9 2zm-3.6 2.07c.66 0 1.19.53 1.19 1.19S12.96 6.45 12.3 6.45s-1.19-.53-1.19-1.19.53-1.19 1.19-1.19z" fill="#306998"/><path d="M16.1 30c6.8 0 6.4-2.9 6.4-2.9l-.01-3.1h-6.5v-.93h9.62S30 23.6 30 16.7s-3.85-6.65-3.85-6.65H23.9v3.2s.13 3.85-3.79 3.85h-6.52S9.92 17.04 9.92 20.64V26.07S9.4 30 16.1 30zm3.6-2.07c-.66 0-1.19-.53-1.19-1.19s.53-1.19 1.19-1.19 1.19.53 1.19 1.19-.53 1.19-1.19 1.19z" fill="#FFD43B"/></svg>';
            var ICON_GH =
                '<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.2 11.38.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49 1 .11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 013-.4c1.02.004 2.04.14 3 .4 2.28-1.55 3.29-1.23 3.29-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.63-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58C20.57 21.8 24 17.3 24 12c0-6.63-5.37-12-12-12z"/></svg>';
            var ICON_PERSON =
                '<svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="var(--accent)" stroke-width="1.6"><circle cx="8" cy="5" r="3"/><path d="M2 14c0-3.3 2.7-6 6-6s6 2.7 6 6"/></svg>';
            var ICON_CB =
                '<svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M8 1l1.5 4.5H14l-3.75 2.75 1.44 4.42L8 10 4.31 12.67l1.44-4.42L2 5.5h4.5z"/></svg>';
            var ICON_IT =
                '<svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 6l-3 2 3 2M12 6l3 2-3 2M9 3l-2 10"/></svg>';

            /* ── UTILIDADES ── */
            function toast(msg) {
                var el = document.getElementById("toast");
                el.textContent = msg;
                el.classList.add("show");
                clearTimeout(toast._t);
                toast._t = setTimeout(function () {
                    el.classList.remove("show");
                }, 2800);
            }

            function reRender() {
                var v = state.currentView;
                if (v === "members-view") renderMembers();
                if (v === "solutions-view") renderSolutions();
                if (v === "skills-view") renderSkills();
            }

            /* ── MAPEO API → prototipo ── */
            var STAGE_ES = {
                CONCEPTOS_CLAVE: "Conceptos Básicos",
                IMPLEMENTACION_TECNICA: "Implementación Técnica",
            };
            function stageLabelEs(stage) {
                return STAGE_ES[stage] || stage;
            }
            function roleLower(role) {
                return String(role || "MEMBER").toLowerCase();
            }

            function initialsFrom(name) {
                var parts = String(name || "")
                    .trim()
                    .split(/\s+/)
                    .filter(Boolean);
                if (parts.length === 0) return "??";
                if (parts.length === 1)
                    return parts[0].slice(0, 2).toUpperCase();
                return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
            }

            /* Color determinista por id: el mismo miembro siempre recibe el mismo color. */
            var AVATAR_COLORS = [
                "#E9642C",
                "#7CD4CC",
                "#5B8DEF",
                "#9B7EDE",
                "#F5A623",
                "#50C878",
                "#FF6B6B",
                "#4ECDC4",
                "#A29BFE",
                "#FD79A8",
                "#74B9FF",
                "#55EFC4",
            ];
            function colorFor(id) {
                var h = 0,
                    s = String(id || "");
                for (var i = 0; i < s.length; i++)
                    h = (h * 31 + s.charCodeAt(i)) >>> 0;
                return AVATAR_COLORS[h % AVATAR_COLORS.length];
            }

            function currentCommunity() {
                var list = bootstrap.communities || [];
                for (var i = 0; i < list.length; i++)
                    if (list[i].id === state.communityId) return list[i];
                return null;
            }

            /* ── CARGA DE MIEMBROS ── */
            function loadMembers(communityId) {
                var tbody = document.getElementById("members-tbody");
                if (!tbody) return;
                tbody.innerHTML =
                    '<tr><td colspan="5" class="muted-sm" style="padding:18px">Cargando miembros…</td></tr>';

                fetch("/api/communities/" + communityId + "/members", {
                    credentials: "include",
                    headers: { Accept: "application/json" },
                })
                    .then(function (res) {
                        return res.text().then(function (raw) {
                            var data = raw ? JSON.parse(raw) : null;
                            if (!res.ok)
                                throw new Error(
                                    (data && (data.error || data.message)) ||
                                        "HTTP " + res.status,
                                );
                            return data;
                        });
                    })
                    .then(function (data) {
                        var comm = data.community;
                        members = data.members.map(function (m) {
                            var display = m.displayName || m.email;
                            return {
                                id: m.id,
                                name:
                                    display +
                                    (m.id === bootstrap.meId ? " (tú)" : ""),
                                initials: initialsFrom(display),
                                color: colorFor(m.id),
                                role: roleLower(m.role),
                                progress:
                                    typeof m.progress === "number"
                                        ? m.progress
                                        : 0,
                                ruta: stageLabelEs(comm.stage),
                                isMe: m.id === bootstrap.meId,
                            };
                        });

                        state.role = roleLower(data.viewerRole);

                        var sbCount =
                            document.getElementById("sb-members-count");
                        if (sbCount) sbCount.textContent = data.memberCount;
                        var titleSpan =
                            document.querySelector(".topbar-title span");
                        if (titleSpan) titleSpan.textContent = "/ " + comm.name;
                        var roleBadge = document.getElementById("role-badge");
                        if (roleBadge) {
                            roleBadge.textContent = state.role;
                            roleBadge.setAttribute("data-role", state.role);
                        }

                        renderMembers();
                    })
                    .catch(function (err) {
                        members = [];
                        renderMembers();
                        var tb = document.getElementById("members-tbody");
                        if (tb)
                            tb.innerHTML =
                                '<tr><td colspan="5" style="padding:18px;color:#b23b3b">No se pudieron cargar los miembros: ' +
                                err.message +
                                "</td></tr>";
                        toast("⚠ " + err.message);
                    });
            }

            function cycleMemberRole(memberId, name) {
                fetch("/api/communities/" + state.communityId + "/members/" + memberId + "/role", {
                    method: "PATCH",
                    credentials: "include",
                    headers: { Accept: "application/json" },
                })
                    .then(function (res) {
                        return res.text().then(function (raw) {
                            var data = raw ? JSON.parse(raw) : null;
                            if (!res.ok) throw new Error((data && (data.error || data.message)) || "HTTP " + res.status);
                            return data;
                        });
                    })
                    .then(function (data) {
                        toast("⚙ " + name + " ahora es " + roleLower(data.role) + ".");
                        loadMembers(state.communityId);
                    })
                    .catch(function (err) {
                        toast("⚠ " + (err.message || "No se pudo cambiar el rol."));
                    });
            }

            /* ── CARGA DE RETOS/ENTREGAS ── */
            function langLabel(l) {
                if (!l) return null;
                var v = String(l).toLowerCase();
                return v.charAt(0).toUpperCase() + v.slice(1); // java → Java
            }

            function loadSubmissions(communityId) {
                var grid = document.getElementById("solutions-grid");
                if (grid) {
                    grid.innerHTML =
                        '<div class="muted-sm" style="grid-column:1/-1;padding:18px">Cargando retos…</div>';
                }

                fetch("/api/communities/" + communityId + "/submissions", {
                    credentials: "include",
                    headers: { Accept: "application/json" },
                })
                    .then(function (res) {
                        return res.text().then(function (raw) {
                            var data = raw ? JSON.parse(raw) : null;
                            if (!res.ok)
                                throw new Error(
                                    (data && (data.error || data.message)) ||
                                        "HTTP " + res.status,
                                );
                            return data;
                        });
                    })
                    .then(function (data) {
                        solutions = (data.submissions || []).map(function (s) {
                            return {
                                id: s.id,
                                title: s.challenge ? s.challenge.title : "(reto)",
                                author: s.author
                                    ? s.author.displayName || s.author.email
                                    : "—",
                                lang: langLabel(s.language),
                                ruta: stageLabelEs(
                                    s.challenge ? s.challenge.requiredStage : "",
                                ),
                                rating: typeof s.rating === "number" ? s.rating : 0,
                                date: String(s.createdAt || "").slice(0, 10),
                                pending: s.status === "PENDING",
                                repoUrl: s.repoUrl || null,
                            };
                        });
                        renderSolutions();
                    })
                    .catch(function (err) {
                        solutions = [];
                        renderSolutions();
                        var g = document.getElementById("solutions-grid");
                        if (g)
                            g.innerHTML =
                                '<div style="grid-column:1/-1;padding:18px;color:#b23b3b">No se pudieron cargar los retos: ' +
                                err.message +
                                "</div>";
                    });
            }

            function onCommunityChange(id) {
                state.communityId = id;
                loadMembers(id);
                loadSubmissions(id);
            }

            /* ── NAVEGACIÓN ── */
            function switchView(id, el) {
                document
                    .querySelectorAll(".view-section")
                    .forEach(function (s) {
                        s.classList.remove("active");
                    });
                document.querySelectorAll(".view-tab").forEach(function (t) {
                    t.classList.remove("active");
                });
                document.getElementById(id).classList.add("active");
                el.classList.add("active");
                state.currentView = id;
                reRender();
            }

            function navTo(id, el) {
                document.querySelectorAll(".sb-item").forEach(function (i) {
                    i.classList.remove("active");
                });
                el.classList.add("active");
                var tab = document.querySelector(
                    '.view-tab[data-view="' + id + '"]',
                );
                if (tab) switchView(id, tab);
            }
            /* ── RBAC ── */

            /* ── RENDER MIEMBROS ── */
            function renderMembers() {
                var tbody = document.getElementById("members-tbody");
                if (!tbody) return;
                var theadRow = document.getElementById("members-thead-row");
                var isManager = state.role === "manager";
                var isMember = state.role === "member";

                /* Banners RBAC */
                document
                    .getElementById("members-rbac-banner")
                    .classList.toggle("hidden", !isManager);
                document
                    .getElementById("members-member-banner")
                    .classList.toggle("hidden", !isMember);

                tbody.innerHTML = "";

                if (isMember) {
                    /* ── VISTA MEMBER: solo su propia fila, solo columnas Miembro + Rol ── */
                    theadRow.innerHTML = "<th>Miembro</th><th>Rol</th>";

                    /* La fila propia se identifica por isMe (no se asume que sea la primera). */
                    var me =
                        members.filter(function (m) {
                            return m.isMe;
                        })[0] || members[0];
                    if (!me) {
                        return;
                    }
                    var row = document.createElement("tr");
                    row.innerHTML =
                        '<td><div class="member-cell">' +
                        '<div class="m-avatar" style="background:' +
                        me.color +
                        '">' +
                        me.initials +
                        "</div>" +
                        "<span>" +
                        me.name +
                        "</span>" +
                        "</div></td>" +
                        '<td><span class="role-pill role-member">' +
                        me.role +
                        "</span></td>";
                    tbody.appendChild(row);
                    return;
                }

                /* ── VISTA ADMIN / MANAGER: tabla completa ── */
                theadRow.innerHTML =
                    "<th>Miembro</th><th>Rol</th><th>Ruta de Skills</th>" +
                    '<th style="min-width:140px">Progreso</th><th>Acciones</th>';

                members.forEach(function (m) {
                    var isRestricted =
                        isManager &&
                        (m.role === "admin" || m.role === "manager");
                    var roleClass =
                        m.role === "admin"
                            ? "role-admin"
                            : m.role === "manager"
                              ? "role-manager"
                              : "role-member";

                    var isImpl = m.ruta === "Implementación Técnica";
                    var rutaSvg = isImpl
                        ? '<svg width="11" height="11" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 8h12M9 3l5 5-5 5"/></svg>'
                        : '<svg width="11" height="11" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="8" cy="8" r="6"/><path d="M8 5v3l2 2"/></svg>';
                    var rutaBadge =
                        '<span class="ruta-tag ' +
                        (isImpl ? "ruta-impl" : "ruta-basic") +
                        '">' +
                        rutaSvg +
                        m.ruta +
                        "</span>";

                    var actions;
                    if (isRestricted) {
                        actions =
                            '<span class="muted-sm">🔒 Restringido</span>';
                    } else if (state.role === "admin") {
                        actions =
                            '<button class="m-btn m-btn-edit" onclick="toast(\'✏ Editando: ' +
                            m.name +
                            "')\">" +
                            '<svg width="11" height="11" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 2l3 3-9 9H2v-3L11 2z"/></svg>Editar</button> ' +
                            '<button class="m-btn m-btn-delete" onclick="toast(\'🗑 Eliminado: ' +
                            m.name +
                            "')\">" +
                            '<svg width="11" height="11" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 4h12M5 4V2h6v2M6 7v5M10 7v5M3 4l1 9h8l1-9"/></svg>Eliminar</button>';
                    } else {
                        /* manager sobre filas no restringidas */
                        actions =
                            '<button class="action-btn" onclick="toast(\'✏ Editando: ' +
                            m.name +
                            "')\">✏ Editar</button>" +
                            '<button class="action-btn" onclick="toast(\'⚙ Rol: ' +
                            m.name +
                            "')\">⚙ Rol</button>";
                    }

                    var row = document.createElement("tr");
                    if (isRestricted) row.className = "row-disabled";
                    row.innerHTML =
                        '<td><div class="member-cell"><div class="m-avatar" style="background:' +
                        m.color +
                        '">' +
                        m.initials +
                        "</div><span>" +
                        m.name +
                        "</span></div></td>" +
                        '<td><span class="role-pill ' +
                        roleClass +
                        '">' +
                        m.role +
                        "</span></td>" +
                        "<td>" +
                        rutaBadge +
                        "</td>" +
                        '<td><div class="prog-cell"><div class="gp-bar-wrap"><div class="gp-bar" style="width:' +
                        m.progress +
                        '%"></div></div><span class="prog-pct">' +
                        m.progress +
                        "%</span></div></td>" +
                        "<td>" +
                        actions +
                        "</td>";
                    tbody.appendChild(row);
                });
            }

            /* ── RENDER RETOS ── */
            function renderSolutions() {
                var grid = document.getElementById("solutions-grid");
                var counter = document.getElementById("sol-counter");
                var rutaF = document.getElementById("filter-skill").value;
                var sortF = document.getElementById("filter-sort").value;
                var canApprove = state.role !== "member";

                var filtered = solutions.filter(function (s) {
                    return !rutaF || s.ruta === rutaF;
                });
                filtered.sort(function (a, b) {
                    if (sortF === "rating") return b.rating - a.rating;
                    if (sortF === "pending")
                        return (b.pending ? 1 : 0) - (a.pending ? 1 : 0);
                    return b.date.localeCompare(a.date);
                });

                counter.textContent =
                    filtered.length +
                    " reto" +
                    (filtered.length !== 1 ? "s" : "");
                grid.innerHTML = "";
                var pending = 0;

                filtered.forEach(function (s) {
                    if (s.pending) pending++;

                    var statusPill = s.pending
                        ? '<span class="pill sol-status-pending"><svg width="12" height="12" viewBox="0 0 16 16" fill="var(--accent)"><path d="M9 1L4 9h4v6l6-8H9V1z"/></svg>Pendiente</span>'
                        : '<span class="pill sol-status-approved"><svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="#1a7a3a" stroke-width="2"><path d="M2 8l4 4 8-8"/></svg>Aprobada</span>';

                    var isImpl = s.ruta === "Implementación Técnica";
                    var rutaTag = isImpl
                        ? '<span class="sol-ruta-tag sol-ruta-tag-impl">' +
                          ICON_IT +
                          "Implementación Técnica</span>"
                        : '<span class="sol-ruta-tag sol-ruta-tag-basic">' +
                          ICON_CB +
                          "Conceptos Básicos</span>";

                    var langTag = "";
                    if (s.lang) {
                        var lk = s.lang.toLowerCase();
                        var langIcon =
                            lk === "java"
                                ? ICON_JAVA
                                : lk === "python"
                                  ? ICON_PYTHON
                                  : "";
                        langTag =
                            '<span class="sol-lang-tag ' +
                            (lk === "java" ? "java" : "python") +
                            '">' +
                            langIcon +
                            s.lang +
                            "</span>";
                    }

                    var full = Math.floor(s.rating),
                        hasHalf = s.rating - full >= 0.3;
                    var stars =
                        '<span class="c-amber">★</span>'.repeat(full) +
                        (hasHalf
                            ? '<span class="c-amber" style="opacity:.5">★</span>'
                            : "") +
                        '<span style="color:var(--border)">★</span>'.repeat(
                            5 - full - (hasHalf ? 1 : 0),
                        );

                    var actions =
                        canApprove && s.pending
                            ? '<div class="sol-actions-v2">' +
                              '<button class="sol-action-btn sol-btn-approve" onclick=\'approveSolution(this,' +
                              JSON.stringify(s.id) +
                              ')\'>Aprobar</button>' +
                              '<button class="sol-action-btn sol-btn-reject" onclick=\'rejectSolution(this,' +
                              JSON.stringify(s.id) +
                              ')\'>Rechazar</button>' +
                              "</div>"
                            : "";
                    var card = document.createElement("div");
                    card.className = "sol-card";
                    card.innerHTML =
                        '<div class="sol-row-top"><div class="sol-title-v2">' +
                        s.title +
                        "</div>" +
                        statusPill +
                        "</div>" +
                        '<div class="sol-row-meta"><div class="sol-author-v2"><div class="sol-author-icon">' +
                        ICON_PERSON +
                        "</div>" +
                        s.author +
                        '</div><div class="sol-date-v2">' +
                        s.date +
                        "</div></div>" +
                        '<div class="sol-tag-row">' +
                        rutaTag +
                        "</div>" +
                        '<div class="sol-row-lang">' +
                        langTag +
                        '<span class="sol-stars">' +
                        stars +
                        " <span>" +
                        s.rating +
                        '</span></span>' +
                        (s.repoUrl
                            ? '<a class="sol-github-btn" href="' + s.repoUrl +
                              '" target="_blank" rel="noopener noreferrer">' + ICON_GH + 'GitHub Repo</a>'
                            : "") +
                        "</div>" +
                        actions;
                    grid.appendChild(card);
                });

                document.getElementById("sb-pending-count").textContent =
                    pending;
            }

            /* ── Aprobar / rechazar una entrega (API real) ────────────────── */
            function _patchSubmission(btn, id, action, okMsg) {
                var card = btn.closest(".sol-card");
                if (card) card.style.opacity = "0.5";
                var buttons = card ? card.querySelectorAll("button") : [];
                buttons.forEach(function (b) {
                    b.disabled = true;
                });

                fetch("/api/submissions/" + id, {
                    method: "PATCH",
                    credentials: "include",
                    headers: {
                        "Content-Type": "application/json",
                        Accept: "application/json",
                    },
                    body: JSON.stringify({ action: action }),
                })
                    .then(function (res) {
                        return res.text().then(function (raw) {
                            var data = raw ? JSON.parse(raw) : null;
                            if (!res.ok)
                                throw new Error(
                                    (data && (data.error || data.message)) ||
                                        "HTTP " + res.status,
                                );
                            return data;
                        });
                    })
                    .then(function () {
                        toast(okMsg);
                        /* Recargar desde el servidor: es la fuente de verdad. */
                        if (state.communityId) loadSubmissions(state.communityId);
                    })
                    .catch(function (err) {
                        if (card) card.style.opacity = "";
                        buttons.forEach(function (b) {
                            b.disabled = false;
                        });
                        toast("⚠ " + err.message);
                    });
            }

            function approveSolution(btn, id) {
                _patchSubmission(btn, id, "APPROVE", "✓ Reto aprobado");
            }
            function rejectSolution(btn, id) {
                _patchSubmission(btn, id, "REJECT", "✗ Reto rechazado");
            }

            /* ── RENDER RUTAS v4 ── */
            function renderSkills() {
                var grid = document.getElementById("skills-grid");
                var stageF = document.getElementById("filter-stage").value;
                var trackF = document.getElementById("filter-track").value;
                var adminBanner = document.getElementById("skills-admin-banner");
                if (adminBanner) adminBanner.classList.add("hidden");
                grid.innerHTML = "";

                /* SVG reutilizables para los tres estados de ícono */
                var SVG_CHECK =
                    '<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M2 8l4 4 8-8"/></svg>';
                var SVG_CURR =
                    '<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="8" cy="8" r="3"/><circle cx="8" cy="8" r="6"/></svg>';
                var SVG_LOCK =
                    '<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="3" y="7" width="10" height="8" rx="1.5"/><path d="M5 7V5a3 3 0 016 0v2"/></svg>';
                var SVG_ARROW =
                    '<svg width="11" height="11" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 8h12M9 3l5 5-5 5"/></svg>';
                var SVG_DOT =
                    '<svg width="11" height="11" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="8" cy="8" r="6"/><path d="M8 5v3l2 2"/></svg>';

                var filtered = skillRoutes.filter(function (r) {
                    return (
                        (!stageF || r.stage === stageF) &&
                        (!trackF || r.profileTrack === trackF)
                    );
                });

                if (filtered.length === 0) {
                    var msg = skillRoutes.length === 0
                        ? 'Todavía no perteneces a ninguna comunidad. <a href="/" style="color:var(--accent);font-weight:700">Explorar comunidades</a>'
                        : "Ninguna ruta coincide con los filtros seleccionados";
                    grid.innerHTML =
                        '<div style="grid-column:1/-1;padding:30px;text-align:center;color:var(--text-secondary);font-size:12.5px;background:var(--surface);border:1px dashed var(--border);border-radius:var(--radius)">' +
                        msg +
                        "</div>";
                    return;
                }

                filtered.forEach(function (r) {
                    var pct = Math.round((r.completed / r.modules) * 100);
                    var card = document.createElement("div");
                    card.className = "skill-card-v4";

                    /* ── Construir fila de íconos ── */
                    var icons = "";
                    for (var i = 0; i < r.modules; i++) {
                        if (i < r.completed) {
                            icons +=
                                '<div class="sk4-icon done">' +
                                SVG_CHECK +
                                "</div>";
                        } else if (
                            i === r.completed &&
                            r.completed < r.modules
                        ) {
                            icons +=
                                '<div class="sk4-icon current">' +
                                SVG_CURR +
                                "</div>";
                        } else {
                            icons +=
                                '<div class="sk4-icon locked">' +
                                SVG_LOCK +
                                "</div>";
                        }
                    }

                    /* ── Barra de progreso ── */
                    var barHtml =
                        pct > 0
                            ? '<div class="sk4-bar" style="width:' +
                              pct +
                              '%">' +
                              '<span class="sk4-bar-pct">' +
                              pct +
                              "%</span>" +
                              "</div>"
                            : "";

                    /* ── Badge de etapa ── */
                    var isImpl = r.stage === "implementacion_tecnica";
                    var stageLabel = STAGE_LABELS[r.profileTrack][r.stage];
                    var stageBadge =
                        '<span class="ruta-tag ' +
                        (isImpl ? "ruta-impl" : "ruta-basic") +
                        '">' +
                        (isImpl ? SVG_ARROW : SVG_DOT) +
                        stageLabel +
                        "</span>";

                    /* ── Acciones del dueño ──────────────────────────────────
                       Ambas exigen ser el profesor DUEÑO y verificado: el
                       servidor lo valida igual, esto solo evita ofrecer un
                       botón que daría 403.
                         • Promover: CONCEPTOS_CLAVE → IMPLEMENTACION_TECNICA
                         • Graduar:  solo desde IMPLEMENTACION_TECNICA          */
                    var promoteBtn =
                        r.owned && !isImpl && !r.graduated
                            ? '<button class="btn btn-outline btn-sm" style="margin-top:10px;width:100%" onclick="promoteRouteStage(\'' +
                              r.id +
                              "')\">→ Promover a Implementación Técnica</button>"
                            : "";

                    var graduateBtn =
                        r.owned && isImpl && !r.graduated
                            ? '<button class="btn btn-primary btn-sm" style="margin-top:8px;width:100%" onclick="graduateRoute(\'' +
                              r.id +
                              "')\">🎓 Graduar comunidad</button>"
                            : "";

                    var graduatedNote = r.graduated
                        ? '<div class="muted-sm" style="margin-top:10px;text-align:center">🎓 Comunidad graduada</div>'
                        : "";

                    card.innerHTML =
                        /* Encabezado: etiqueta tipo + título + etapa + track */
                        '<div class="sk4-header">' +
                        '<div class="sk4-type">' +
                        r.name +
                        "</div>" +
                        '<div class="sk4-title">' +
                        r.subtitle +
                        "</div>" +
                        '<div style="display:flex;align-items:center;gap:8px;margin-top:8px;flex-wrap:wrap">' +
                        stageBadge +
                        '<span class="muted-sm">' +
                        TRACK_LABELS[r.profileTrack] +
                        "</span>" +
                        "</div>" +
                        "</div>" +
                        /* Fila de progreso: nombre | barra | Tema X/Y */
                        '<div class="sk4-prog-row">' +
                        '<div class="sk4-name">' +
                        r.assignee +
                        "</div>" +
                        '<div class="sk4-bar-wrap">' +
                        barHtml +
                        "</div>" +
                        '<div class="sk4-tema"><b>Tema:</b> ' +
                        r.completed +
                        "/" +
                        r.modules +
                        "</div>" +
                        "</div>" +
                        /* Línea divisoria */
                        '<hr class="sk4-divider">' +
                        /* Sección de desafíos */
                        '<div class="sk4-challenges">' +
                        '<div class="sk4-ch-header">' +
                        '<div class="sk4-ch-title">Desafíos de Código</div>' +
                        '<div class="sk4-ch-level">' +
                        r.modules +
                        " reto" +
                        (r.modules === 1 ? "" : "s") +
                        "</div>" +
                        "</div>" +
                        '<div class="sk4-icons">' +
                        icons +
                        "</div>" +
                        promoteBtn +
                        graduateBtn +
                        graduatedNote +
                        "</div>";

                    grid.appendChild(card);
                });
            }

            /* ── Promoción de etapa ────────────────────────────── */
            function promoteRouteStage(routeId) {
                var route = skillRoutes.filter(function (r) {
                    return r.id === routeId;
                })[0];
                if (!route || route.stage === "implementacion_tecnica") return;

                fetch("/api/communities/" + routeId + "/promote", {
                    method: "PATCH",
                    credentials: "include",
                    headers: { Accept: "application/json" },
                })
                    .then(function (res) {
                        return res.text().then(function (raw) {
                            var data = raw ? JSON.parse(raw) : null;
                            if (!res.ok)
                                throw new Error(
                                    (data && (data.error || data.message)) ||
                                        "HTTP " + res.status,
                                );
                            return data;
                        });
                    })
                    .then(function (data) {
                        route.stage = String(
                            data.community.stage || "IMPLEMENTACION_TECNICA",
                        ).toLowerCase();
                        toast('→ "' + route.subtitle + '" promovida a Implementación Técnica');
                        renderSkills();
                    })
                    .catch(function (err) {
                        toast("⚠ " + err.message);
                    });
            }

            /* ── EXPONER HANDLERS EN window ───────────────────────────────── */
            Object.assign(window, {
                switchView: switchView,
                navTo: navTo,
                onCommunityChange: onCommunityChange,
                renderSkills: renderSkills,
                renderSolutions: renderSolutions,
                promoteRouteStage: promoteRouteStage,
                graduateRoute: graduateRoute,
                approveSolution: approveSolution,
                rejectSolution: rejectSolution,
                toast: toast,
            });

            /* ── Graduar comunidad (API real) ───────────────────────────────
               El servidor exige: profesor dueño + verificado + la comunidad en
               IMPLEMENTACION_TECNICA. */
            function graduateRoute(routeId) {
                var route = skillRoutes.filter(function (r) {
                    return r.id === routeId;
                })[0];
                if (!route || route.graduated) return;

                if (
                    !window.confirm(
                        'Vas a graduar "' +
                            route.subtitle +
                            '". Esta acción no se puede deshacer. ¿Continuar?',
                    )
                ) {
                    return;
                }

                fetch("/api/communities/" + routeId + "/graduate", {
                    method: "PATCH",
                    credentials: "include",
                    headers: { Accept: "application/json" },
                })
                    .then(function (res) {
                        return res.text().then(function (raw) {
                            var data = raw ? JSON.parse(raw) : null;
                            if (!res.ok)
                                throw new Error(
                                    (data && (data.error || data.message)) ||
                                        "HTTP " + res.status,
                                );
                            return data;
                        });
                    })
                    .then(function () {
                        route.graduated = true;
                        toast('🎓 "' + route.subtitle + '" fue graduada');
                        renderSkills();
                    })
                    .catch(function (err) {
                        toast("⚠ " + err.message);
                    });
            }

            /* ── INIT ── */
            (function () {
                renderSkills();

                var list = bootstrap.communities || [];
                if (list.length > 0) {
                    /* Comunidad por defecto: la primera (propias van antes que membresías). */
                    state.communityId = list[0].id;
                    var sel = document.getElementById("community-select");
                    if (sel) sel.value = state.communityId;
                    loadMembers(state.communityId);
                    loadSubmissions(state.communityId);
                } else {
                    var sbCount = document.getElementById("sb-members-count");
                    if (sbCount) sbCount.textContent = "0";
                }
            })();
        </script>
        <script>
            import "../lib/enhance-selects";
        </script>
    </body>
</html>
