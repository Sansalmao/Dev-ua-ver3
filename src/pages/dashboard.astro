        <span>Miembros</span>
        <span class="sb-badge" id="sb-members-count">12</span>
      </div>
      <div class="sb-item" data-nav="solutions-view" onclick="navTo('solutions-view',this)">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 3H3a1 1 0 00-1 1v9a1 1 0 001 1h10a1 1 0 001-1V4a1 1 0 00-1-1h-2"/><path d="M6 1h4a1 1 0 011 1v2H5V2a1 1 0 011-1z"/><path d="M5 8h6M5 11h4"/></svg>
        <span>Retos</span>
        <span class="sb-badge teal" id="sb-pending-count">3</span>
      </div>
      <div class="sb-section">Comunidad</div>
      <div class="sb-item" onclick="toast('📅 UA Day 2026 — 28 de mayo, Ciudad de México')">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="3" width="14" height="12" rx="1"/><path d="M5 1v4M11 1v4M1 7h14"/></svg>
        <span>Eventos</span>
      </div>
      <div class="sb-item" onclick="toast('📘 UA Academic Curricula — 5 módulos activos')">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 1L2 5v2l6-4 6 4V5L8 1z"/><path d="M4 8v5h8V8M8 13v-3"/></svg>
        <span>Currículum</span>
      </div>
