          <div class="kpi-card">
            <div class="kpi-icon teal"><svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="var(--teal-dark)" stroke-width="1.5"><circle cx="6" cy="5" r="3"/><path d="M1 13c0-2.8 2.2-5 5-5s5 2.2 5 5"/><circle cx="12" cy="5" r="2"/><path d="M12 9c1.7 0 3 1.3 3 3"/></svg></div>
