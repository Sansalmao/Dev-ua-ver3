                color: var(--teal-dark);
                border-color: var(--teal);
            }
            /* Member action buttons */
            .m-btn {
                display: inline-flex;
                align-items: center;
                gap: 4px;
                border-radius: var(--radius-xs);
                padding: 4px 10px;
                font-size: 11px;
                font-weight: 700;
                cursor: pointer;
                transition: all 0.15s;
                border: 1px solid;
            }
            .m-btn-edit {
                background: var(--accent-bg-soft);
                color: var(--accent);
                border-color: var(--accent-border-soft);
