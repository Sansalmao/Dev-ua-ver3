---
// Por ahora, esta página se genera como HTML estático con los datos de educator_basica
// como ruta por defecto

import BaseLayout from "../layouts/BaseLayout.astro";
import NavBar from "../components/NavBar.astro";
import ProgressPanel from "../components/ProgressPanel.astro";
import TopicCard from "../components/TopicCard.astro";
import { RUTAS, ICONS } from "../lib/rutas";

// Ruta por defecto para el build estático.
// El cliente sobreescribirá esto desde localStorage en Semana 3.
const RUTA_DEFAULT = "educator_basica";
const ruta = RUTAS[RUTA_DEFAULT];

// En SSG todos los temas comienzan como "nuevo".
// El estado real (progreso / completado) lo gestiona JS desde localStorage.
const total = ruta.temas.length;
const completados = 0;
const pct = 0;
---

<BaseLayout title={`${ruta.titulo} — Skills UA`} description={ruta.desc}>
    <NavBar slot="navbar" />

    <div id="view-grid" class="grid-view">
        <header class="grid-head" id="grid-head">
            <div class="grid-title-row">
                <div class="grid-title-group">
                    <span class="grid-prefix">›_</span>
                    <h1 class="grid-title" id="grid-titulo">{ruta.titulo}</h1>
                    <span class="grid-badge" id="grid-badge"
                        >✦ {ruta.subtitulo}</span
                    >
                </div>
                <button type="button" class="btn-change" id="btn-cambiar">
                    <svg
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <path d="M19 12H5M12 19l-7-7 7-7"></path>
                    </svg>
                    Volver al Inicio
                </button>
            </div>
            <p class="grid-desc" id="grid-desc">{ruta.desc}</p>
        </header>

        <div class="grid-layout">
            <aside class="grid-side">
                <ProgressPanel
                    completados={completados}
                    total={total}
                    pct={pct}
                />
            </aside>

            <div class="grid-topics" id="topics-container">
                {
                    ruta.temas.map((tema) => (
                        <TopicCard
                            id={tema.id}
                            titulo={tema.titulo}
                            nivel={tema.nivel}
                            duracion={tema.duracion}
                            descripcion={tema.descripcion}
                            estado="nuevo"
                        >
                            {/* set:html inyecta el SVG como HTML directamente en el slot */}
                            <span
                                slot="icon"
                                set:html={ICONS[tema.icon] ?? ICONS["doc"]}
                            />
                        </TopicCard>
                    ))
                }
            </div>
        </div>
    </div>
</BaseLayout>

<style>
    .grid-view {
        max-width: 1140px;
        margin: 0 auto;
        padding: 36px 40px 80px;
    }

    /* ── Encabezado ── */
    .grid-head {
        margin-bottom: 24px;
    }

    .grid-title-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 8px;
    }

    .grid-title-group {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .grid-prefix {
        font-family: var(--font-mono);
        font-size: 20px;
        font-weight: 700;
        color: var(--accent);
    }

    .grid-title {
        font-size: clamp(22px, 3vw, 26px);
        font-weight: 700;
        color: var(--text);
        letter-spacing: -0.01em;
        line-height: 1.2;
    }

    .grid-badge {
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--accent);
        background: var(--accent-bg-soft);
        border: 1px solid var(--accent-border-light);
        padding: 4px 12px;
        border-radius: 100px;
        white-space: nowrap;
    }

    .grid-desc {
        font-size: 14px;
        color: var(--text-secondary);
        line-height: 1.6;
        max-width: 660px;
    }

    /* ── Botón volver ── */
    .btn-change {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 18px;
        border-radius: 8px;
        background: var(--accent);
        color: var(--card-bg);
        font-family: var(--font-body);
        font-size: 13px;
        font-weight: 600;
        border: none;
        cursor: pointer;
        white-space: nowrap;
        flex-shrink: 0;
        transition:
            background var(--transition-fast),
            transform var(--transition-fast);
    }

    .btn-change:hover {
        background: var(--accent-hover);
        transform: translateX(-2px);
    }
    .btn-change:active {
        transform: translateX(0);
    }

    /* ── Layout principal ── */
    .grid-layout {
        display: flex;
        gap: 20px;
        align-items: flex-start;
    }

    .grid-side {
        flex-shrink: 0;
        position: sticky;
        top: 88px;
    }

    /* ── Grid de cards ── */
    .grid-topics {
        flex: 1;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
        gap: 16px;
    }

    /* ── Responsive ── */
    @media (max-width: 900px) {
        .grid-view {
            padding: 24px 20px 60px;
        }

        .grid-layout {
            flex-direction: column;
        }

        .grid-side {
            position: static;
            width: 100%;
        }

        .grid-side :global(.progress-panel) {
            max-width: 100%;
        }
    }

    @media (max-width: 640px) {
        .grid-title-row {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>
