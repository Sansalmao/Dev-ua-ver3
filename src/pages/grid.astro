---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
import NavBar from "../components/NavBar.astro";
import ProgressPanel from "../components/ProgressPanel.astro";
import TopicCard from "../components/TopicCard.astro";
import Toast from "../components/Toast.astro";
import { RUTAS, ICONS } from "../lib/rutas";

const RUTA_DEFAULT = "educator_basica";
const ruta = RUTAS[RUTA_DEFAULT];
const total = ruta.temas.length;
---

<BaseLayout title={`${ruta.titulo} — Skills UA`} description={ruta.desc}>
    <NavBar slot="navbar" />

    <div id="view-grid" class="grid-view" style="opacity:0">
        <header class="grid-head">
            <div class="grid-title-row">
                <div class="grid-title-group">
                    <span class="grid-prefix">›_</span>
                    <h1 class="grid-title" id="grid-titulo">{ruta.titulo}</h1>
                    <span class="grid-badge" id="grid-badge">
                        ✦ {ruta.subtitulo}
                    </span>
                </div>
                <button type="button" class="btn-change" id="btn-cambiar">
                    <svg
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <path d="M19 12H5M12 19l-7-7 7-7"></path>
                    </svg>
                    Volver al Inicio
                </button>
            </div>
            <p class="grid-desc" id="grid-desc">{ruta.desc}</p>
        </header>

        <div class="grid-layout">
            <aside class="grid-side">
                <ProgressPanel completados={0} total={total} pct={0} />
            </aside>

            <div class="grid-topics" id="topics-container">
                {
                    ruta.temas.map((tema) => (
                        <TopicCard
                            id={tema.id}
                            titulo={tema.titulo}
                            nivel={tema.nivel}
                            duracion={tema.duracion}
                            descripcion={tema.descripcion}
                            estado="nuevo"
                            slug={tema.slug}
                        >
                            <span
                                slot="icon"
                                set:html={ICONS[tema.icon] ?? ICONS["doc"]}
                            />
                        </TopicCard>
                    ))
                }
            </div>
        </div>
    </div>

    <Toast />
</BaseLayout>

<script>
    const STORAGE_KEY = "ua_skills";

    interface TemaEstado {
        visitado: boolean;
        completado: boolean;
    }

    interface StoreShape {
        rol: string | null;
        ruta: string | null;
        temas: Record<string, TemaEstado>;
    }

    function cargarEstado(): StoreShape {
        try {
            const raw = localStorage.getItem(STORAGE_KEY);
            if (raw) {
                const p = JSON.parse(raw);
                if (p && typeof p === "object") {
                    return {
                        rol: p.rol ?? null,
                        ruta: p.ruta ?? null,
                        temas: p.temas ?? {},
                    };
                }
            }
        } catch {}
        return { rol: null, ruta: null, temas: {} };
    }

    function guardarEstado(store: StoreShape) {
        try {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(store));
        } catch {}
    }

    // ── IMPORTACIONES ESTÁTICAS ───────────────────────────────────────────────
    import { RUTAS, resolverRuta } from "../lib/rutas";
    import {
        getSession,
        getTopicProgress,
        saveTopicProgress,
    } from "../lib/api-client";

    let isLoggedIn = false;

    function persistTema(
        store: StoreShape,
        id: string,
        estado: TemaEstado,
    ) {
        store.temas[id] = estado;
        guardarEstado(store);
        if (isLoggedIn) {
            saveTopicProgress(id, estado).catch((err) => {
                console.error("[grid] No se pudo guardar el progreso en la cuenta:", err);
            });
        }
    }

    // ── TOAST ─────────────────────────────────────────────────────────────────
    function toast(message: string, duration = 2800) {
        document.dispatchEvent(
            new CustomEvent("toast:show", {
                detail: { message, duration },
            }),
        );
    }

    // ── PROGRESS PANEL ────────────────────────────────────────────────────────
    function actualizarPanel(completados: number, total: number) {
        const pct = total > 0 ? Math.round((completados / total) * 100) : 0;

        const numEl = document.querySelector<HTMLElement>("[data-prog-num]");
        const totEl = document.querySelector<HTMLElement>("[data-prog-tot]");
        const barEl = document.querySelector<HTMLElement>("[data-prog-bar]");
        const pctEl = document.querySelector<HTMLElement>("[data-prog-pct]");

        if (numEl) numEl.textContent = String(completados);
        if (totEl) totEl.textContent = `/${total}`;
        if (barEl) barEl.style.width = `${pct}%`;
        if (pctEl) pctEl.textContent = `${pct}% COMPLETADO`;
    }

    // ── CARD DOM ──────────────────────────────────────────────────────────────
    function actualizarCardDOM(
        id: string,
        estado: "nuevo" | "progreso" | "completado",
    ) {
        const card = document.querySelector<HTMLElement>(
            `.topic-card[data-id="${id}"]`,
        );
        if (!card) return;

        card.classList.remove("visited", "completed");
        if (estado === "progreso") card.classList.add("visited");
        if (estado === "completado") card.classList.add("completed");

        const titleEl = card.querySelector<HTMLElement>(".tc-title");
        if (titleEl) {
            titleEl.querySelectorAll(".tc-sbadge").forEach((b) => b.remove());
            if (estado === "progreso") {
                const badge = document.createElement("span");
                badge.className = "tc-sbadge prog";
                badge.textContent = "en progreso";
                titleEl.appendChild(badge);
            } else if (estado === "completado") {
                const badge = document.createElement("span");
                badge.className = "tc-sbadge done";
                badge.textContent = "✓ completado";
                titleEl.appendChild(badge);
            }
        }

        const btn = card.querySelector<HTMLElement>(".btn-iniciar");
        if (btn) {
            const nuevoTexto =
                estado === "completado"
                    ? "$ revisar"
                    : estado === "progreso"
                      ? "$ continuar"
                      : "$ iniciar";

            // Limpiar hijos de texto sin tocar atributos del elemento
            btn.textContent = nuevoTexto;
        }

        const foot = card.querySelector<HTMLElement>(".tc-foot");
        if (!foot) return;

        let progEl = card.querySelector<HTMLElement>(".tc-prog");

        if (estado === "nuevo") {
            progEl?.remove();
        } else {
            const pct = estado === "completado" ? 100 : 60;
            const colorClass = estado === "completado" ? "green" : "orange";
            const label = `Progreso: ${pct}%`;

            if (!progEl) {
                progEl = document.createElement("div");
                progEl.className = "tc-prog";
                progEl.innerHTML = `
                    <div class="tc-prog-lbl">${label}</div>
                    <div class="tc-prog-bg">
                        <div class="tc-prog-fill ${colorClass}"
                             style="width: 0%"></div>
                    </div>
                `;
                foot.appendChild(progEl);

                requestAnimationFrame(() => {
                    const fill =
                        progEl!.querySelector<HTMLElement>(".tc-prog-fill");
                    if (fill) fill.style.width = `${pct}%`;
                });
            } else {
                const lbl = progEl.querySelector<HTMLElement>(".tc-prog-lbl");
                const fill = progEl.querySelector<HTMLElement>(".tc-prog-fill");
                if (lbl) lbl.textContent = label;
                if (fill) {
                    fill.classList.remove("orange", "green");
                    fill.classList.add(colorClass);
                    fill.style.width = `${pct}%`;
                }
            }
        }
    }

    // ── BOTONES ───────────────────────────────────────────────────────────────
    function registrarBotones(
        store: StoreShape,
        temas: (typeof RUTAS)[string]["temas"],
    ) {
        const container = document.getElementById("topics-container");
        if (!container) return;

        container.addEventListener("click", (e) => {
            const btn = (e.target as HTMLElement).closest(".btn-iniciar");
            if (!btn) return;

            const id = (btn as HTMLElement).dataset.id;
            if (!id) return;

            const esEnlace =
                btn.tagName === "A" &&
                (btn as HTMLAnchorElement).getAttribute("href") !== "#";

            const est = store.temas[id] ?? {
                visitado: false,
                completado: false,
            };

            if (esEnlace) {
                if (!est.visitado && !est.completado) {
                    persistTema(store, id, { visitado: true, completado: false });
                }
                return;
            }

            // A partir de aquí: botones sin slug
            if (est.completado) {
                toast("Módulo completado — revisando contenido");
                return;
            }

            persistTema(store, id, { visitado: true, completado: false });
            actualizarCardDOM(id, "progreso");

            const completadosActuales = temas.filter(
                (t) => store.temas[t.id]?.completado,
            ).length;
            actualizarPanel(completadosActuales, temas.length);
            toast("Módulo iniciado — progreso guardado");

            setTimeout(() => {
                persistTema(store, id, { visitado: true, completado: true });
                actualizarCardDOM(id, "completado");

                const completadosFinal = temas.filter(
                    (t) => store.temas[t.id]?.completado,
                ).length;
                actualizarPanel(completadosFinal, temas.length);
                toast("✓ Módulo completado");
            }, 1500);
        });
    }
    // ── RESTAURAR CARDS ───────────────────────────────────────────────────────
    function restaurarCards(
        store: StoreShape,
        temas: (typeof RUTAS)[string]["temas"],
    ) {
        temas.forEach((tema) => {
            const est = store.temas[tema.id];
            if (!est) return;

            const estado: "progreso" | "completado" | "nuevo" = est.completado
                ? "completado"
                : est.visitado
                  ? "progreso"
                  : "nuevo";

            if (estado !== "nuevo") actualizarCardDOM(tema.id, estado);
        });

        const completados = temas.filter(
            (t) => store.temas[t.id]?.completado,
        ).length;
        actualizarPanel(completados, temas.length);
    }

    // ── ENCABEZADO ────────────────────────────────────────────────────────────
    function actualizarEncabezado(rutaData: (typeof RUTAS)[string]) {
        const tituloEl = document.getElementById("grid-titulo");
        const badgeEl = document.getElementById("grid-badge");
        const descEl = document.getElementById("grid-desc");

        if (tituloEl) tituloEl.textContent = rutaData.titulo;
        if (badgeEl) badgeEl.textContent = `✦ ${rutaData.subtitulo}`;
        if (descEl) descEl.textContent = rutaData.desc;
    }

    // ── INIT ──────────────────────────────────────────────────────────────────

    document.addEventListener("DOMContentLoaded", () => {
        const store = cargarEstado();

        const claveRuta =
            store.rol && store.ruta
                ? resolverRuta(store.rol, store.ruta)
                : "educator_basica";

        const rutaData = RUTAS[claveRuta];
        if (!rutaData) return;

        actualizarEncabezado(rutaData);
        restaurarCards(store, rutaData.temas);
        registrarBotones(store, rutaData.temas);

        // ── Progreso por cuenta ──
        getSession()
            .then((user) => {
                if (!user) return;
                isLoggedIn = true;
                return getTopicProgress().then(({ progress }) => {
                    store.temas = progress;
                    guardarEstado(store); // refresca la caché local con lo real de la cuenta
                    restaurarCards(store, rutaData.temas);
                });
            })
            .catch((err) => {
                console.error("[grid] No se pudo hidratar el progreso de la cuenta:", err);
            });

        const grid = document.getElementById("view-grid");
        if (grid) {
            grid.style.transition = "opacity 0.2s ease";
            grid.style.opacity = "1";
        }

        document
            .getElementById("btn-cambiar")
            ?.addEventListener("click", () => {
                // Animación de salida antes de navegar al home.
                // grid.astro no tiene view-home, así que en lugar de
                // volverAlHome() hacemos un fade-out del contenedor y
                // luego navegamos.
                const gridEl = document.getElementById("view-grid");
                if (gridEl) {
                    gridEl.style.transition =
                        "opacity 0.2s ease, transform 0.2s ease";
                    gridEl.style.opacity = "0";
                    gridEl.style.transform = "translateY(12px)";
                    setTimeout(() => {
                        window.location.href = "/";
                    }, 220);
                } else {
                    window.location.href = "/";
                }
            });
    });
</script>
