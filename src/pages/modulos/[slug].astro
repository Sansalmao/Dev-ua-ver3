---
export const prerender = true;
import ModuleLayout from "../../layouts/ModuleLayout.astro";
import { moduleFrontmatterSchema } from "../../lib/module-schema";

export async function getStaticPaths() {
    const modules = import.meta.glob<{
        frontmatter?: unknown;
        default: any;
    }>("../../data/modulos/**/*.mdx", {
        eager: true,
    });

    const paths = [];

    for (const [filePath, module] of Object.entries(modules)) {
        try {
            // 3. Extraer frontmatter del módulo MDX
            const { frontmatter } = module;

            // 4. Validar con Zod
            const validatedFrontmatter = moduleFrontmatterSchema.parse(
                frontmatter ?? {},
            );

            // 5. Saltar borradores
            if (validatedFrontmatter.draft) continue;

            // 6. Extraer slug: eliminar "./" y ".mdx"
            const slug = filePath.split("/").pop()?.replace(".mdx", "");
            if (!slug) continue;

            // 7. Agregar ruta
            paths.push({
                params: { slug },
                props: {
                    Content: module.default,
                    frontmatter: validatedFrontmatter,
                },
            });
        } catch (error) {
            console.error(`❌ Error procesando ${filePath}:`, error);
        }
    }

    return paths;
}

// 9. Recibir props de la ruta
const { Content, frontmatter } = Astro.props;
---

<ModuleLayout
    title={frontmatter.title}
    description={frontmatter.description}
    padre="módulos"
    padreHref="/"
    titulo={frontmatter.title}
    subtitulo={frontmatter.description}
    dificultad={frontmatter.difficulty}
    duracion={frontmatter.duration}
    objetivo={frontmatter.objective}
    progreso={frontmatter.progress}
    filename={frontmatter.title.toLowerCase().replace(/\s+/g, "-") + ".md"}
    sections={frontmatter.sections}
>
    <Content />
</ModuleLayout>
