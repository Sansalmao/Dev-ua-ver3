---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    title="Inicio"
    description="Skills UA — Aprende Aceptación Universal"
>
    <div style="padding: 2rem; max-width: 760px; margin: 0 auto;">
        <!-- Verifica --font-display y --text -->
        <h1
            style="font-family: var(--font-display); color: var(--accent); margin-bottom: 1rem;"
        >
            Skills UA
        </h1>

        <!-- Verifica --text-secondary -->
        <p style="color: var(--text-secondary); margin-bottom: 0.5rem;">
            Texto secundario — Sora 400 — var(--text-secondary)
        </p>

        <!-- Verifica --text-muted -->
        <p style="color: var(--text-muted); margin-bottom: 1rem;">
            Texto muted — placeholders — var(--text-muted)
        </p>

        <!-- Verifica --font-mono y semáforos -->
        <div
            style="
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 10px;
      overflow: hidden;
      margin-bottom: 1rem;
    "
        >
            <!-- File header con dots de semáforo -->
            <div
                style="
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.6rem 1rem;
        border-bottom: 1px solid var(--border);
      "
            >
                <span
                    style="width:12px;height:12px;border-radius:50%;background:var(--red);display:inline-block;"
                ></span>
                <span
                    style="width:12px;height:12px;border-radius:50%;background:var(--yellow);display:inline-block;"
                ></span>
                <span
                    style="width:12px;height:12px;border-radius:50%;background:var(--green);display:inline-block;"
                ></span>
                <span
                    style="font-family:var(--font-mono);font-size:0.75rem;color:var(--text-muted);margin-left:0.5rem;"
                >
                    global.css
                </span>
            </div>

            <!-- Verifica variables dentro de una card -->
            <div style="padding: 1rem;">
                <code
                    style="
          font-family: var(--font-mono);
          color: var(--green-text);
          font-size: 0.85rem;
          display: block;
          margin-bottom: 0.5rem;
        "
                >
                    $ npm run dev → localhost:4321 ✓
                </code>
                <p
                    style="font-family: var(--font-mono); color: var(--text-muted); font-size: 0.8rem;"
                >
                    Variables CSS heredadas correctamente
                </p>
            </div>
        </div>

        <!-- Verifica --accent-soft -->
        <div
            style="
      background: var(--accent-soft);
      border: 1px solid var(--accent);
      border-radius: 10px;
      padding: 1rem;
    "
        >
            <p
                style="color: var(--accent); font-weight: 700; font-family: var(--font-display);"
            >
                Design system activo — Guía Visual v2.0
            </p>
            <p
                style="color: var(--text-secondary); font-size: 0.875rem; margin-top: 0.25rem;"
            >
                Sora + JetBrains Mono · Paleta UA WG LACNOG
            </p>
        </div>
    </div>
</BaseLayout>
