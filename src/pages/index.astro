---
export const prerender = false;
import BaseLayout from "../layouts/BaseLayout.astro";
import NavBar from "../components/NavBar.astro";
import HeroSection from "../components/HeroSection.astro";
import DecoCard from "../components/DecoCard.astro";
import ReadmeCard from "../components/ReadmeCard.astro";
import ProfileModal from "../components/ProfileModal.astro";
import AuthModal from "../components/AuthModal.astro";
import Toast from "../components/Toast.astro";
import ProgressPanel from "../components/ProgressPanel.astro";
import ChallengesPanel from "../components/ChallengesPanel.astro";
import ChallengeFlow from "../components/ChallengeFlow.astro";
import { getTotalChallenges } from "../lib/challenges-data";

const totals = {
    educator_basica: getTotalChallenges("educator", "basica"),
    educator_avanzada: getTotalChallenges("educator", "avanzada"),
    learner_basica: getTotalChallenges("learner", "basica"),
    learner_avanzada: getTotalChallenges("learner", "avanzada"),
};
---

<BaseLayout
    title="~/skills UA — Aceptación Universal"
    description="Plataforma de aprendizaje en Aceptación Universal — UA Working Group LACNOG"
>
    <NavBar slot="navbar" />

    <!-- VISTA A: Home -->
    <div id="view-home">
        <HeroSection />

        <div class="home-cards">
            <DecoCard
                filename="Skills.md"
                dotColor="yellow"
                title="Creación de capacidades"
                description="Dominar la UA no requiere aprender una nueva categoría de codificación, sino que se basa en las habilidades existentes para ampliar los sistemas con el fin de reconocer y admitir direcciones URL y de correo electrónico en todas las longitudes de caracteres, idiomas y escrituras."
            >
                <svg
                    slot="icon"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                >
                    <path d="M12 20h9"></path><path d="M12 4h9"></path>
                    <path d="M4 9h16"></path><path d="M4 15h16"></path>
                </svg>
            </DecoCard>

            <DecoCard
                filename="Aprendizaje.md"
                dotColor="yellow"
                title="Aprendizaje flexible"
                description="Módulos de microaprendizaje integrados en los cursos existentes de los programas técnicos: ciencias de la computación, tecnología de la información, ingeniería informática y similares."
            >
                <svg
                    slot="icon"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                >
                    <path d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3z"></path>
                    <path d="M12 12l8-4.5"></path><path d="M12 12v9"
                    ></path><path d="M12 12L4 7.5"></path>
                </svg>
            </DecoCard>

            <DecoCard
                filename="WG-UA.md"
                dotColor="red"
                title="WG - UA de LACNOG"
                description="El objetivo del WG UA es crear una comunidad preocupada por mejorar la forma en que los nombres de dominio y direcciones de correo electrónico asimilan o conectan cuando incluyen caracteres multilingües."
                href="https://nog.lat/aceptacion-universal/"
                linkText="Ver proyecto"
            >
                <svg
                    slot="icon"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                >
                    <path d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="10" cy="7" r="4"></circle>
                    <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
            </DecoCard>
        </div>

        <ReadmeCard />
    </div>

    <!-- VISTA B: Grid — llenado dinámicamente por ProfileModal.astro -->
    <div id="view-grid">
        <div class="grid-head">
            <div class="grid-title-row">
                <div
                    style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;"
                >
                    <span class="grid-prefix">›_</span>
                    <h2 class="grid-title" id="grid-titulo"></h2>
                    <span class="grid-badge" id="grid-badge"></span>
                </div>
                <button type="button" class="btn-change" id="btn-cambiar">
                    <svg
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <path d="M19 12H5M12 19l-7-7 7-7"></path>
                    </svg>
                    Volver al Inicio
                </button>
            </div>
            <p class="grid-desc" id="grid-desc"></p>
        </div>

        <div class="grid-layout">
            <aside class="grid-side">
                <!-- Panel 1: Progreso de la ruta de temas (ya existente) -->
                <ProgressPanel completados={0} total={0} pct={0} />

                <!--
                    Panel 2: Retos de código — clickeable.
                    data-challenges-entry: selector para el JS de apertura.
                    El título cambia de "Tu Progreso" a "Retos de código"
                    y el icono bolt → consola cuando el panel está activo.
                    Por defecto inactivo (challenges-panel-card--locked)
                    hasta que el usuario inicia la ruta de temas.
                -->
                <div
                    class="challenges-panel-card"
                    id="challenges-entry-card"
                    data-challenges-entry
                    role="button"
                    tabindex="0"
                    aria-label="Abrir retos de código"
                >
                    <div class="cpc-header">
                        <p class="cpc-lbl" id="cpc-lbl">Retos de código</p>
                        <div class="cpc-icon" id="cpc-icon" aria-hidden="true">
                            <!-- Icono consola / terminal -->
                            <svg
                                width="14"
                                height="14"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <polyline points="4 17 10 11 4 5"></polyline>
                                <line x1="12" y1="19" x2="20" y2="19"></line>
                            </svg>
                        </div>
                    </div>

                    <div class="cpc-count">
                        <span class="cpc-num" id="cpc-done">0</span>
                        <span class="cpc-tot" id="cpc-total">/0</span>
                    </div>

                    <div class="cpc-bar-wrap" aria-hidden="true">
                        <div class="cpc-bar-fill" id="cpc-bar" style="width:0%">
                        </div>
                    </div>

                    <div class="cpc-pct" id="cpc-pct">0% COMPLETADO</div>

                    <div class="cpc-tip">
                        <div
                            class="cpc-bolt"
                            aria-hidden="true"
                            id="cpc-bolt-icon"
                        >
                            <!-- Bolt → activo, consola → expandido -->
                            <svg
                                width="14"
                                height="14"
                                viewBox="0 0 24 24"
                                fill="currentColor"
                                aria-hidden="true"
                            >
                                <polygon
                                    points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"
                                ></polygon>
                            </svg>
                        </div>
                        <div class="cpc-tip-text">
                            <p id="cpc-tip-title">
                                Comienza ahora. Explora los módulos y desbloquea
                                los retos de programación.
                            </p>
                        </div>
                    </div>
                </div>
            </aside>

            <div id="topics-container"></div>
        </div>
    </div>

    <!-- Modal -->
    <ProfileModal />
    <AuthModal />

    <!-- Toast singleton — gestionado por Toast.astro via evento "toast:show" -->
    <Toast />

    <!-- Panel de Retos de Código — oculto por defecto, activado por challenges:open -->
    <ChallengesPanel />

    <!-- Flow de Reto Individual — oculto por defecto, activado por challenge-flow:open -->
    <ChallengeFlow />
</BaseLayout>

<style>
    /* ── Vistas ── */
    #view-home {
        opacity: 1;
    }
    #view-home.oculto {
        display: none;
    }

    #view-grid {
        display: none;
        opacity: 1;
        padding: 36px 40px 80px;
        max-width: 1140px;
        margin: 0 auto;
    }

    #view-grid.visible {
        display: block;
    }

    /* ── Home cards ── */
    .home-cards {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
        max-width: 860px;
        margin: 0 auto 28px;
        padding: 0 24px;
    }

    /* ── Grid head ── */
    .grid-head {
        margin-bottom: 24px;
    }

    .grid-title-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 8px;
    }

    .grid-prefix {
        font-family: var(--font-mono);
        font-size: 20px;
        font-weight: 700;
        color: var(--accent);
    }

    .grid-title {
        font-size: clamp(22px, 3vw, 26px);
        font-weight: 700;
        color: var(--text);
        letter-spacing: -0.01em;
    }

    .grid-badge {
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--accent);
        background: var(--accent-bg-soft);
        border: 1px solid var(--accent-border-light);
        padding: 4px 12px;
        border-radius: 100px;
    }

    .grid-desc {
        font-size: 14px;
        color: var(--text-secondary);
        line-height: 1.6;
        max-width: 660px;
    }

    .btn-change {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 18px;
        border-radius: 8px;
        background: var(--accent);
        color: var(--card-bg);
        font-family: var(--font-body);
        font-size: 13px;
        font-weight: 600;
        border: none;
        cursor: pointer;
        white-space: nowrap;
        transition:
            background var(--transition-fast),
            transform var(--transition-fast);
    }

    .btn-change:hover {
        background: var(--accent-hover);
        transform: translateX(-2px);
    }
    .btn-change:active {
        transform: translateX(0);
    }

    /* ── Grid layout ── */
    .grid-layout {
        display: flex;
        gap: 20px;
        align-items: flex-start;
    }

    /* ── Panel lateral sticky ── */
    .grid-side {
        flex-shrink: 0;
        position: sticky;
        top: 88px;
        align-self: flex-start;
    }

    /* ── Topics container ── */
    #topics-container {
        flex: 1;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
        gap: 16px;
    }

    /* ── Keyframes de transición entre vistas ── */
    @keyframes homeExit {
        from {
            opacity: 1;
            transform: translateY(0);
        }
        to {
            opacity: 0;
            transform: translateY(-14px);
        }
    }

    @keyframes gridEnter {
        from {
            opacity: 0;
            transform: translateY(18px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes gridExit {
        from {
            opacity: 1;
            transform: translateY(0);
        }
        to {
            opacity: 0;
            transform: translateY(12px);
        }
    }

    @keyframes homeEnter {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ── Responsive ── */
    @media (max-width: 900px) {
        #view-grid {
            padding: 24px 20px 60px;
        }

        .home-cards {
            grid-template-columns: 1fr;
        }

        .grid-layout {
            flex-direction: column;
        }

        .grid-side {
            position: static;
            width: 100%;
        }

        #topics-container {
            grid-template-columns: 1fr;
        }
    }
</style>

<style>
    /* ═══════════════════════════════════════════════════════════════════
       Challenges Entry Card — segundo ProgressPanel en grid-side
       Hereda todos los tokens del sistema.
    ═══════════════════════════════════════════════════════════════════ */
    .challenges-panel-card {
        width: 100%;
        max-width: 204px;
        border-radius: 16px;
        border: 2px solid var(--accent-border-soft);
        padding: 20px;
        background: linear-gradient(
            145deg,
            var(--card-bg) 55%,
            var(--accent-bg-soft) 100%
        );
        cursor: pointer;
        margin-top: 14px;
        transition:
            box-shadow var(--transition-fast),
            border-color var(--transition-fast),
            transform var(--transition-fast);
        outline: none;
    }

    .challenges-panel-card:hover {
        border-color: var(--accent);
        box-shadow: var(--shadow-card-hover);
        transform: translateY(-2px);
    }

    .challenges-panel-card:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
    }

    .challenges-panel-card:active {
        transform: translateY(0);
    }

    /* Header del card: label + icono consola */
    .cpc-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 10px;
    }

    .cpc-lbl {
        font-family: var(--font-mono);
        font-size: 10px;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.1em;
    }

    .cpc-icon {
        color: var(--accent);
        opacity: 0.7;
    }

    /* Fracción X/N */
    .cpc-count {
        display: flex;
        align-items: baseline;
        gap: 2px;
        margin-bottom: 8px;
    }

    .cpc-num {
        font-size: 42px;
        font-weight: 700;
        color: var(--text);
        line-height: 1;
        font-variant-numeric: tabular-nums;
        transition: all 0.3s ease;
    }

    .cpc-tot {
        font-size: 22px;
        font-weight: 600;
        color: var(--muted-2);
    }

    /* Barra de progreso */
    .cpc-bar-wrap {
        width: 100%;
        height: 5px;
        background: var(--border);
        border-radius: 99px;
        overflow: hidden;
        margin-bottom: 6px;
    }

    .cpc-bar-fill {
        height: 100%;
        background: var(--accent);
        border-radius: 99px;
        transition: width 0.7s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .cpc-pct {
        font-family: var(--font-mono);
        font-size: 10px;
        font-weight: 600;
        color: var(--accent);
        margin-bottom: 14px;
        display: block;
    }

    /* CTA */
    .cpc-tip {
        display: flex;
        gap: 8px;
        align-items: flex-start;
    }

    .cpc-bolt {
        color: var(--accent);
        flex-shrink: 0;
        margin-top: 1px;
    }

    .cpc-tip-text p {
        font-size: 11px;
        color: var(--text-muted);
        line-height: 1.4;
    }
</style>

<script define:vars={{ totals }}>
    "use strict";
    (function () {
        var UA_STORAGE_KEY = "ua-challenges-v1";

        function getChallengesProgress() {
            try {
                var badgeEl = document.getElementById("grid-badge");
                var profile = "learner";
                var routeType = "basica";
                if (badgeEl) {
                    var label = badgeEl.textContent.trim();
                    profile = label.includes("Profesores")
                        ? "educator"
                        : "learner";
                    routeType = label.includes("SysAdmins & Devs")
                        ? "avanzada"
                        : "basica";
                }
                var key = profile + "_" + routeType;
                var total = totals[key];
                var storageKey =
                    "ua-challenges-v1-" +
                    profile +
                    (routeType === "avanzada" ? "-advanced" : "");
                var raw = localStorage.getItem(storageKey);
                if (!raw) {
                    return { done: 0, total: total, pct: 0 };
                }
                var state = JSON.parse(raw);
                var done = 0;
                Object.values(state.modules || {}).forEach(function (mod) {
                    (mod.challenges || []).forEach(function (c) {
                        if (c.status === "completed") done++;
                    });
                });
                return {
                    done: done,
                    total: total,
                    pct: Math.round((done / total) * 100) || 0,
                };
            } catch (e) {
                return { done: 0, total: totals.learner_basica, pct: 0 };
            }
        }

        function updateEntryCard() {
            var p = getChallengesProgress();
            var doneEl = document.getElementById("cpc-done");
            var totEl = document.getElementById("cpc-total");
            var barEl = document.getElementById("cpc-bar");
            var pctEl = document.getElementById("cpc-pct");
            if (doneEl) doneEl.textContent = p.done;
            if (totEl) totEl.textContent = "/" + p.total;
            if (barEl) barEl.style.width = p.pct + "%";
            if (pctEl) pctEl.textContent = p.pct + "% COMPLETADO";
        }

        function openChallenges() {
            var grid = document.getElementById("view-grid");
            var challenges = document.getElementById("view-challenges");
            if (!grid || !challenges) return;

            var badgeEl = document.getElementById("grid-badge");
            var profileLabel = badgeEl ? badgeEl.textContent.trim() : "";
            var profile = profileLabel.includes("Profesores")
                ? "educator"
                : "learner";
            var routeType = profileLabel.includes("SysAdmins & Devs")
                ? "avanzada"
                : "basica";

            grid.style.animation = "gridExit 220ms ease forwards";
            setTimeout(function () {
                grid.classList.remove("visible");
                grid.style.animation = "";
                document.dispatchEvent(
                    new CustomEvent("challenges:open", {
                        detail: {
                            profileLabel: profileLabel,
                            profile: profile,
                            routeType: routeType,
                        },
                    }),
                );
            }, 220);
        }

        document.addEventListener("DOMContentLoaded", function () {
            updateEntryCard();

            var badgeEl = document.getElementById("grid-badge");
            if (badgeEl) {
                var badgeObserver = new MutationObserver(function () {
                    updateEntryCard();
                });
                badgeObserver.observe(badgeEl, {
                    childList: true,
                    characterData: true,
                    subtree: true,
                });
            }

            var card = document.getElementById("challenges-entry-card");
            if (card) {
                card.addEventListener("click", function () {
                    var grid = document.getElementById("view-grid");
                    if (grid && grid.classList.contains("visible")) {
                        openChallenges();
                    }
                });
                card.addEventListener("keydown", function (e) {
                    if (e.key === "Enter" || e.key === " ") {
                        e.preventDefault();
                        card.click();
                    }
                });
            }
        });

        document.addEventListener("challenges:closed", function () {
            var grid = document.getElementById("view-grid");
            if (!grid) return;
            grid.style.animation = "gridEnter 260ms ease forwards";
            grid.classList.add("visible");
            setTimeout(function () {
                grid.style.animation = "";
            }, 260);
            updateEntryCard();
        });
    })();
</script>
