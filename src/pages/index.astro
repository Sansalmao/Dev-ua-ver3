---
import BaseLayout from "../layouts/BaseLayout.astro";
import NavBar from "../components/NavBar.astro";
import HeroSection from "../components/HeroSection.astro";
import DecoCard from "../components/DecoCard.astro";
import ReadmeCard from "../components/ReadmeCard.astro";
---

<BaseLayout
    title="~/skills UA — Aceptación Universal"
    description="Plataforma de aprendizaje en Aceptación Universal — UA Working Group LACNOG"
>
    <NavBar slot="navbar" />

    <!-- VISTA A: Home — visible al cargar -->
    <div id="view-home" class="view-home">
        <HeroSection />

        <div class="home-cards">
            <DecoCard
                filename="intro.md"
                dotColor="yellow"
                title="Introducción a la iniciativa"
            >
                <svg
                    slot="icon"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                >
                    <path d="M12 20h9"></path>
                    <path d="M12 4h9"></path>
                    <path d="M4 9h16"></path>
                    <path d="M4 15h16"></path>
                </svg>
            </DecoCard>

            <DecoCard
                filename="standards.md"
                dotColor="yellow"
                title="Estándares y compatibilidad"
            >
                <svg
                    slot="icon"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                >
                    <path d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3z"></path>
                    <path d="M12 12l8-4.5"></path>
                    <path d="M12 12v9"></path>
                    <path d="M12 12L4 7.5"></path>
                </svg>
            </DecoCard>

            <DecoCard
                filename="community.md"
                dotColor="red"
                title="Recursos y comunidad"
            >
                <svg
                    slot="icon"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                >
                    <path d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="10" cy="7" r="4"></circle>
                    <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
            </DecoCard>
        </div>

        <ReadmeCard />
    </div>

    <!-- VISTA B: Grid de temas — oculto por defecto. Hasta la semana 3 -->
    <div id="view-grid" class="view-grid-placeholder"></div>
</BaseLayout>

<style>
    /* VISTA HOME */
    #view-home {
        width: 100%;
        opacity: 1;
    }

    /* Clase que JS añade para ocultar el home del flujo */
    #view-home.oculto {
        display: none;
    }

    .home-cards {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
        max-width: 860px;
        margin: 0 auto 28px;
        padding: 0 24px;
    }

    /* VISTA GRID — oculta por defecto */
    #view-grid {
        display: none;
        opacity: 1;
    }

    /* Clase que JS añade para revelar el grid */
    #view-grid.visible {
        display: block;
    }

    @media (max-width: 900px) {
        .home-cards {
            grid-template-columns: 1fr;
        }
    }
</style>
