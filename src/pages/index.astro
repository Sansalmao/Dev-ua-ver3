---
import BaseLayout from "../layouts/BaseLayout.astro";
import NavBar from "../components/NavBar.astro";
import HeroSection from "../components/HeroSection.astro";
import DecoCard from "../components/DecoCard.astro";
import ReadmeCard from "../components/ReadmeCard.astro";
import ProfileModal from "../components/ProfileModal.astro";
---

<BaseLayout
    title="~/skills UA — Aceptación Universal"
    description="Plataforma de aprendizaje en Aceptación Universal — UA Working Group LACNOG"
>
    <NavBar slot="navbar" />

    <!-- VISTA A: Home -->
    <div id="view-home">
        <HeroSection />

        <div class="home-cards">
            <DecoCard
                filename="intro.md"
                dotColor="yellow"
                title="Introducción a la iniciativa"
            >
                <svg
                    slot="icon"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                >
                    <path d="M12 20h9"></path><path d="M12 4h9"></path>
                    <path d="M4 9h16"></path><path d="M4 15h16"></path>
                </svg>
            </DecoCard>

            <DecoCard
                filename="standards.md"
                dotColor="yellow"
                title="Estándares y compatibilidad"
            >
                <svg
                    slot="icon"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                >
                    <path d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3z"></path>
                    <path d="M12 12l8-4.5"></path><path d="M12 12v9"
                    ></path><path d="M12 12L4 7.5"></path>
                </svg>
            </DecoCard>

            <DecoCard
                filename="community.md"
                dotColor="red"
                title="Recursos y comunidad"
            >
                <svg
                    slot="icon"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                >
                    <path d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="10" cy="7" r="4"></circle>
                    <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
            </DecoCard>
        </div>

        <ReadmeCard />
    </div>

    <!-- VISTA B: Grid — llenado dinámicamente por ProfileModal.astro -->
    <div id="view-grid">
        <div class="grid-head">
            <div class="grid-title-row">
                <div
                    style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;"
                >
                    <span class="grid-prefix">›_</span>
                    <h2 class="grid-title" id="grid-titulo"></h2>
                    <span class="grid-badge" id="grid-badge"></span>
                </div>
                <button type="button" class="btn-change" id="btn-cambiar">
                    <svg
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <path d="M19 12H5M12 19l-7-7 7-7"></path>
                    </svg>
                    Volver al Inicio
                </button>
            </div>
            <p class="grid-desc" id="grid-desc"></p>
        </div>

        <div class="grid-layout">
            <div class="progress-panel">
                <div class="prog-lbl">Tu Progreso</div>
                <div class="prog-count">
                    <span class="num" id="prog-num">0</span>
                    <span class="tot" id="prog-tot">/0</span>
                </div>
                <div class="prog-bwrap" aria-hidden="true">
                    <div class="prog-bfill" id="prog-bar"></div>
                </div>
                <div class="prog-pct" id="prog-pct">0% COMPLETADO</div>
                <div class="prog-tip">
                    <span class="prog-bolt" aria-hidden="true">⚡</span>
                    <div class="prog-tip-t">
                        <p>Comienza ahora</p>
                        <p>
                            Explora los módulos y completa las lecciones a tu
                            ritmo.
                        </p>
                    </div>
                </div>
            </div>

            <div id="topics-container"></div>
        </div>
    </div>

    <!-- Modal -->
    <ProfileModal />

    <!-- Toast -->
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
</BaseLayout>

<style>
    /* ── Vistas ── */
    #view-home {
        opacity: 1;
    }
    #view-home.oculto {
        display: none;
    }

    #view-grid {
        display: none;
        opacity: 1;
        padding: 36px 40px 80px;
        max-width: 1140px;
        margin: 0 auto;
    }

    #view-grid.visible {
        display: block;
    }

    /* ── Home cards ── */
    .home-cards {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
        max-width: 860px;
        margin: 0 auto 28px;
        padding: 0 24px;
    }

    /* ── Grid head ── */
    .grid-head {
        margin-bottom: 24px;
    }

    .grid-title-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 8px;
    }

    .grid-prefix {
        font-family: var(--font-mono);
        font-size: 20px;
        font-weight: 700;
        color: var(--accent);
    }

    .grid-title {
        font-size: clamp(22px, 3vw, 26px);
        font-weight: 700;
        color: var(--text);
        letter-spacing: -0.01em;
    }

    .grid-badge {
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--accent);
        background: var(--accent-bg-soft);
        border: 1px solid var(--accent-border-light);
        padding: 4px 12px;
        border-radius: 100px;
    }

    .grid-desc {
        font-size: 14px;
        color: var(--text-secondary);
        line-height: 1.6;
        max-width: 660px;
    }

    .btn-change {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 18px;
        border-radius: 8px;
        background: var(--accent);
        color: var(--card-bg);
        font-family: var(--font-body);
        font-size: 13px;
        font-weight: 600;
        border: none;
        cursor: pointer;
        white-space: nowrap;
        transition:
            background var(--transition-fast),
            transform var(--transition-fast);
    }

    .btn-change:hover {
        background: var(--accent-hover);
        transform: translateX(-2px);
    }
    .btn-change:active {
        transform: translateX(0);
    }

    /* ── Grid layout ── */
    .grid-layout {
        display: flex;
        gap: 20px;
        align-items: flex-start;
    }

    /* ── Progress panel ── */
    .progress-panel {
        width: 204px;
        flex-shrink: 0;
        border-radius: 16px;
        border: 2px solid var(--accent-border-soft);
        padding: 20px;
        background: linear-gradient(
            145deg,
            var(--card-bg) 55%,
            var(--accent-bg-soft) 100%
        );
        position: sticky;
        top: 88px;
    }

    .prog-lbl {
        font-family: var(--font-mono);
        font-size: 10px;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-bottom: 10px;
    }

    .prog-count {
        display: flex;
        align-items: baseline;
        gap: 2px;
        margin-bottom: 8px;
    }

    .prog-count .num {
        font-size: 42px;
        font-weight: 700;
        color: var(--text);
        line-height: 1;
    }

    .prog-count .tot {
        font-size: 22px;
        font-weight: 600;
        color: var(--text-muted);
    }

    .prog-bwrap {
        width: 100%;
        height: 5px;
        background: var(--border);
        border-radius: 99px;
        overflow: hidden;
        margin-bottom: 6px;
    }

    .prog-bfill {
        height: 100%;
        background: var(--accent);
        border-radius: 99px;
        width: 0%;
        transition: width 0.7s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .prog-pct {
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--accent);
        font-weight: 600;
        margin-bottom: 16px;
    }

    .prog-tip {
        display: flex;
        gap: 8px;
        align-items: flex-start;
    }

    .prog-bolt {
        font-size: 14px;
        color: var(--accent);
        margin-top: 1px;
    }

    .prog-tip-t p:first-child {
        font-size: 11px;
        font-weight: 600;
        color: var(--text);
        margin-bottom: 3px;
    }

    .prog-tip-t p:last-child {
        font-size: 11px;
        color: var(--text-muted);
        line-height: 1.4;
    }

    /* ── Topics container ── */
    #topics-container {
        flex: 1;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
        gap: 16px;
    }

    /* ── Toast ── */
    .toast {
        position: fixed;
        bottom: 28px;
        left: 50%;
        transform: translateX(-50%) translateY(70px);
        background: #1c1917;
        color: #fafaf9;
        font-family: var(--font-mono);
        font-size: 12px;
        padding: 10px 22px;
        border-radius: 100px;
        z-index: 200;
        white-space: nowrap;
        pointer-events: none;
        transition:
            transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
            opacity 0.35s;
        opacity: 0;
    }

    .toast.show {
        transform: translateX(-50%) translateY(0);
        opacity: 1;
    }

    /* ── Keyframes de transición entre vistas ── */
    @keyframes homeExit {
        from {
            opacity: 1;
            transform: translateY(0);
        }
        to {
            opacity: 0;
            transform: translateY(-14px);
        }
    }

    @keyframes gridEnter {
        from {
            opacity: 0;
            transform: translateY(18px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes gridExit {
        from {
            opacity: 1;
            transform: translateY(0);
        }
        to {
            opacity: 0;
            transform: translateY(12px);
        }
    }

    @keyframes homeEnter {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ── Responsive ── */
    @media (max-width: 900px) {
        #view-grid {
            padding: 24px 20px 60px;
        }

        .home-cards {
            grid-template-columns: 1fr;
        }

        .grid-layout {
            flex-direction: column;
        }

        .progress-panel {
            position: static;
            width: 100%;
        }

        #topics-container {
            grid-template-columns: 1fr;
        }
    }
</style>
