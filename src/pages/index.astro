---
import BaseLayout from "../layouts/BaseLayout.astro";
import NavBar from "../components/NavBar.astro";
import HeroSection from "../components/HeroSection.astro";
import DecoCard from "../components/DecoCard.astro";
import ReadmeCard from "../components/ReadmeCard.astro";
import ProfileModal from "../components/ProfileModal.astro";
import Toast from "../components/Toast.astro";
import ProgressPanel from "../components/ProgressPanel.astro";
---

<BaseLayout
    title="~/skills UA — Aceptación Universal"
    description="Plataforma de aprendizaje en Aceptación Universal — UA Working Group LACNOG"
>
    <NavBar slot="navbar" />

    <!-- VISTA A: Home -->
    <div id="view-home">
        <HeroSection />

        <div class="home-cards">
            <DecoCard
                filename="Skills.md"
                dotColor="yellow"
                title="Creación de capacidades"
                description="Dominar la UA no requiere aprender una nueva categoría de codificación, sino que se basa en las habilidades existentes para ampliar los sistemas con el fin de reconocer y admitir direcciones URL y de correo electrónico en todas las longitudes de caracteres, idiomas y escrituras."
            >
                <svg
                    slot="icon"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                >
                    <path d="M12 20h9"></path><path d="M12 4h9"></path>
                    <path d="M4 9h16"></path><path d="M4 15h16"></path>
                </svg>
            </DecoCard>

            <DecoCard
                filename="Aprendizaje.md"
                dotColor="yellow"
                title="Aprendizaje flexible"
                description="Módulos de microaprendizaje integrados en los cursos existentes de los programas técnicos: ciencias de la computación, tecnología de la información, ingeniería informática y similares."
            >
                <svg
                    slot="icon"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                >
                    <path d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3z"></path>
                    <path d="M12 12l8-4.5"></path><path d="M12 12v9"
                    ></path><path d="M12 12L4 7.5"></path>
                </svg>
            </DecoCard>

            <DecoCard
                filename="WG-UA.md"
                dotColor="red"
                title="Proyecto del WG-UA de LACNOG"
                description="El objetivo del WG UA es crear una comunidad preocupada por mejorar la forma en que los nombres de dominio y direcciones de correo electrónico asimilan o conectan cuando incluyen caracteres multilingües."
                href="https://nog.lat/aceptacion-universal/"
                linkText="Ver proyecto"
            >
                <svg
                    slot="icon"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                >
                    <path d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="10" cy="7" r="4"></circle>
                    <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
            </DecoCard>
        </div>

        <ReadmeCard />
    </div>

    <!-- VISTA B: Grid — llenado dinámicamente por ProfileModal.astro -->
    <div id="view-grid">
        <div class="grid-head">
            <div class="grid-title-row">
                <div
                    style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;"
                >
                    <span class="grid-prefix">›_</span>
                    <h2 class="grid-title" id="grid-titulo"></h2>
                    <span class="grid-badge" id="grid-badge"></span>
                </div>
                <button type="button" class="btn-change" id="btn-cambiar">
                    <svg
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <path d="M19 12H5M12 19l-7-7 7-7"></path>
                    </svg>
                    Volver al Inicio
                </button>
            </div>
            <p class="grid-desc" id="grid-desc"></p>
        </div>

        <div class="grid-layout">
            <aside class="grid-side">
                <ProgressPanel completados={0} total={0} pct={0} />
            </aside>

            <div id="topics-container"></div>
        </div>
    </div>

    <!-- Modal -->
    <ProfileModal />

    <!-- Toast singleton — gestionado por Toast.astro via evento "toast:show" -->
    <Toast />
</BaseLayout>

<style>
    /* ── Vistas ── */
    #view-home {
        opacity: 1;
    }
    #view-home.oculto {
        display: none;
    }

    #view-grid {
        display: none;
        opacity: 1;
        padding: 36px 40px 80px;
        max-width: 1140px;
        margin: 0 auto;
    }

    #view-grid.visible {
        display: block;
    }

    /* ── Home cards ── */
    .home-cards {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
        max-width: 860px;
        margin: 0 auto 28px;
        padding: 0 24px;
    }

    /* ── Grid head ── */
    .grid-head {
        margin-bottom: 24px;
    }

    .grid-title-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 8px;
    }

    .grid-prefix {
        font-family: var(--font-mono);
        font-size: 20px;
        font-weight: 700;
        color: var(--accent);
    }

    .grid-title {
        font-size: clamp(22px, 3vw, 26px);
        font-weight: 700;
        color: var(--text);
        letter-spacing: -0.01em;
    }

    .grid-badge {
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--accent);
        background: var(--accent-bg-soft);
        border: 1px solid var(--accent-border-light);
        padding: 4px 12px;
        border-radius: 100px;
    }

    .grid-desc {
        font-size: 14px;
        color: var(--text-secondary);
        line-height: 1.6;
        max-width: 660px;
    }

    .btn-change {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 18px;
        border-radius: 8px;
        background: var(--accent);
        color: var(--card-bg);
        font-family: var(--font-body);
        font-size: 13px;
        font-weight: 600;
        border: none;
        cursor: pointer;
        white-space: nowrap;
        transition:
            background var(--transition-fast),
            transform var(--transition-fast);
    }

    .btn-change:hover {
        background: var(--accent-hover);
        transform: translateX(-2px);
    }
    .btn-change:active {
        transform: translateX(0);
    }

    /* ── Grid layout ── */
    .grid-layout {
        display: flex;
        gap: 20px;
        align-items: flex-start;
    }

    /* ── Panel lateral sticky ── */
    .grid-side {
        flex-shrink: 0;
        position: sticky;
        top: 88px;
        align-self: flex-start;
    }

    /* ── Topics container ── */
    #topics-container {
        flex: 1;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
        gap: 16px;
    }

    /* ── Keyframes de transición entre vistas ── */
    @keyframes homeExit {
        from {
            opacity: 1;
            transform: translateY(0);
        }
        to {
            opacity: 0;
            transform: translateY(-14px);
        }
    }

    @keyframes gridEnter {
        from {
            opacity: 0;
            transform: translateY(18px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes gridExit {
        from {
            opacity: 1;
            transform: translateY(0);
        }
        to {
            opacity: 0;
            transform: translateY(12px);
        }
    }

    @keyframes homeEnter {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ── Responsive ── */
    @media (max-width: 900px) {
        #view-grid {
            padding: 24px 20px 60px;
        }

        .home-cards {
            grid-template-columns: 1fr;
        }

        .grid-layout {
            flex-direction: column;
        }

        .grid-side {
            position: static;
            width: 100%;
        }

        #topics-container {
            grid-template-columns: 1fr;
        }
    }
</style>
