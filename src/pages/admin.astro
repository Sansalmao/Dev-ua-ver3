<script define:vars={{ pendingCount: kpis.pending }}>
    "use strict";

    var VIEW_LABELS = {
        requests: "Solicitudes",
        communities: "Comunidades",
        users: "Directorio",
    };

    /* ── Navegación ── */
    function switchView(view) {
        document.querySelectorAll(".view").forEach(function (v) {
            v.classList.remove("active");
        });
        var el = document.getElementById("view-" + view);
        if (el) el.classList.add("active");

        document.querySelectorAll(".nav-link[data-view]").forEach(function (b) {
            b.classList.toggle("active", b.dataset.view === view);
        });

        var tv = document.getElementById("topbar-view");
        if (tv) tv.textContent = VIEW_LABELS[view] || view;
    }

    /* ── Toast ── */
    function toast(msg, type) {
        var cont = document.getElementById("toast-container");
        if (!cont) return;
        var icons = { success: "✓", error: "✕", info: "ℹ" };
        var el = document.createElement("div");
        el.className = "toast toast-" + (type || "info");
        el.innerHTML =
            '<span class="toast-icon">' +
            (icons[type] || icons.info) +
            "</span>" +
            "<span>" +
            msg +
            "</span>";
        cont.appendChild(el);
        setTimeout(function () {
            el.classList.add("out");
            setTimeout(function () {
                el.remove();
            }, 300);
        }, 2600);
    }

    /* ── Verificar profesor (API real) ──────────────────────────────────────
       El servidor exige requireAdmin: acá solo se refleja el resultado. */
    var pending = pendingCount;

    function handleRequest(id, action) {
        var card = document.getElementById("req-" + id);
        if (!card) return;
        card.setAttribute("data-busy", "1");

        fetch("/api/admin/teachers/" + id + "/verify", {
            method: "PATCH",
            credentials: "include",
            headers: {
                "Content-Type": "application/json",
                Accept: "application/json",
            },
            body: JSON.stringify({ action: action }),
        })
            .then(function (res) {
                return res.text().then(function (raw) {
                    var data = raw ? JSON.parse(raw) : null;
                    if (!res.ok)
                        throw new Error(
                            (data && (data.error || data.message)) ||
                                "HTTP " + res.status,
                        );
                    return data;
                });
            })
            .then(function () {
                card.style.transition = "opacity .25s, transform .25s";
                card.style.opacity = "0";
                card.style.transform = "translateX(12px)";
                setTimeout(function () {
                    card.remove();
                    pending = Math.max(0, pending - 1);
                    updatePendingUI();
                }, 250);
                toast(
                    action === "APPROVE"
                        ? "Profesor verificado: ya puede crear comunidades"
                        : "Solicitud rechazada",
                    action === "APPROVE" ? "success" : "info",
                );
            })
            .catch(function (err) {
                card.removeAttribute("data-busy");
                toast(err.message, "error");
            });
    }

    function updatePendingUI() {
        var badge = document.getElementById("sidebar-badge");
        if (badge) {
            badge.textContent = pending;
            badge.style.display = pending === 0 ? "none" : "";
        }
        var chip = document.getElementById("pending-chip");
        if (chip)
            chip.textContent = pending + " pendiente" + (pending === 1 ? "" : "s");
        var kpi = document.querySelector("#view-requests .kpi-value");
        if (kpi) kpi.textContent = pending;

        if (pending === 0) {
            var list = document.getElementById("pending-list");
            if (list && !list.querySelector(".request-card")) {
                list.innerHTML =
                    '<div class="empty-state">No hay profesores pendientes de verificación</div>';
            }
        }
    }

    /* ── Filtro de comunidades (cliente) ── */
    function filterCommunities() {
        var q = (document.getElementById("search-comm").value || "")
            .trim()
            .toLowerCase();
        var stage = document.getElementById("filter-stage").value;
        var showGrad = document.getElementById("show-graduated").checked;

        var active = 0;
        var grad = 0;

        document.querySelectorAll(".comm-card").forEach(function (card) {
            var titulo = card.dataset.titulo || "";
            var fac = card.dataset.facilitador || "";
            var etapa = card.dataset.etapa || "";
            var isGrad = card.dataset.graduated === "1";

            var okQ = !q || titulo.indexOf(q) !== -1 || fac.indexOf(q) !== -1;
            var okStage = stage === "all" || etapa === stage;
            // La casilla solo aplica cuando NO se filtró explícitamente por graduadas.
            var okGrad = showGrad || stage === "graduada" || !isGrad;

            var visible = okQ && okStage && okGrad;
            card.style.display = visible ? "" : "none";
            if (visible) {
                if (isGrad) grad++;
                else active++;
            }
        });

        document.getElementById("active-count").textContent = active;
        document.getElementById("grad-count").textContent = grad;
    }

    /* ── Filtro del directorio (cliente) ── */
    function filterUsers() {
        var q = (document.getElementById("search-user").value || "")
            .trim()
            .toLowerCase();
        var prof = document.getElementById("filter-profile").value;
        var n = 0;

        document.querySelectorAll("[data-user-row]").forEach(function (row) {
            var okQ = !q || (row.dataset.name || "").indexOf(q) !== -1;
            var okP = prof === "all" || row.dataset.profile === prof;
            var visible = okQ && okP;
            row.style.display = visible ? "" : "none";
            if (visible) n++;
        });

        document.getElementById("users-count").textContent = n;
    }

    /* ── EXPONER EN window ──────────────────────────────────────────────────
       `define:vars` envuelve TODO el script en un IIFE: sin esto, los
       onclick/onchange del markup fallan con "... is not defined". */
    Object.assign(window, {
        switchView: switchView,
        handleRequest: handleRequest,
        filterCommunities: filterCommunities,
        filterUsers: filterUsers,
        toast: toast,
    });

    updatePendingUI();
</script>
</body>
</html>
