---
import "../styles/global.css";
import { prisma } from "@lib/prisma.js";

const user = Astro.locals.user;
if (!user) return Astro.redirect("/");
if (!user.isAdmin) return Astro.redirect("/dashboard");

const fmtDate = (d: Date) =>
    `${String(d.getDate()).padStart(2, "0")}/${String(d.getMonth() + 1).padStart(2, "0")}/${d.getFullYear()}`;

function initials(name: string) {
    const p = String(name || "").trim().split(/\s+/).filter(Boolean);
    if (!p.length) return "??";
    if (p.length === 1) return p[0].slice(0, 2).toUpperCase();
    return (p[0][0] + p[p.length - 1][0]).toUpperCase();
}

// ── Profesores pendientes de verificación ───────────────────────────────────
const pendingRaw = await prisma.user.findMany({
    where: { profileType: "PROFESOR", teacherVerificationStatus: "PENDING" },
    select: {
        id: true, email: true, displayName: true, country: true,
        institution: true, wantsCommunity: true, createdAt: true,
    },
    orderBy: { createdAt: "asc" },
});

// ── Historial (ya resueltos) ────────────────────────────────────────────────
const historyRaw = await prisma.user.findMany({
    where: {
        profileType: "PROFESOR",
        teacherVerificationStatus: { in: ["VERIFIED", "REJECTED"] },
    },
    select: {
        id: true, email: true, displayName: true, institution: true,
        teacherVerificationStatus: true, updatedAt: true,
    },
    orderBy: { updatedAt: "desc" },
    take: 10,
});

// ── Comunidades ─────────────────────────────────────────────────────────────
const commRaw = await prisma.community.findMany({
    select: {
        id: true, name: true, topic: true, profileTrack: true, stage: true,
        graduated: true, createdAt: true,
        teacher: { select: { displayName: true, email: true } },
        _count: { select: { challenges: true } },
    },
    orderBy: { createdAt: "desc" },
});

const commIds = commRaw.map((c) => c.id);

// Miembros aprobados por comunidad.
const memberCounts = await prisma.joinRequest.groupBy({
    by: ["communityId"],
    where: { status: "APPROVED", communityId: { in: commIds } },
    _count: { _all: true },
});
const membersBy = new Map(memberCounts.map((m) => [m.communityId, m._count._all]));

// Retos con al menos una entrega aprobada (= "completados" de la comunidad).
const doneRows = await prisma.challenge.findMany({
    where: { communityId: { in: commIds }, submissions: { some: { status: "APPROVED" } } },
    select: { communityId: true },
});
const doneBy = new Map<string, number>();
for (const r of doneRows) doneBy.set(r.communityId, (doneBy.get(r.communityId) ?? 0) + 1);

const communities = commRaw.map((c) => {
    const total = c._count.challenges;
    const done = doneBy.get(c.id) ?? 0;
    const teacherName = c.teacher?.displayName || c.teacher?.email || "—";
    return {
        id: c.id,
        name: c.name,
        topic: c.topic,
        teacher: teacherName,
        teacherInitials: initials(teacherName),
        stage: c.stage,
        stageKey: String(c.stage).toLowerCase(),
        graduated: c.graduated,
        members: membersBy.get(c.id) ?? 0,
        total,
        done,
        pct: total ? Math.round((done / total) * 100) : 0,
    };
});

// ── Usuarios ────────────────────────────────────────────────────────────────
const usersRaw = await prisma.user.findMany({
    select: {
        id: true, email: true, displayName: true, profileType: true,
        teacherVerificationStatus: true, isAdmin: true, institution: true,
        createdAt: true,
    },
    orderBy: { createdAt: "desc" },
});
const users = usersRaw.map((u) => {
    const name = u.displayName || u.email;
    return {
        id: u.id,
        name,
        initials: initials(name),
        email: u.email,
        profileType: u.profileType,
        verification: u.profileType === "PROFESOR" ? u.teacherVerificationStatus : null,
        isAdmin: u.isAdmin,
        institution: u.institution,
        createdAt: fmtDate(u.createdAt),
    };
});

const me = usersRaw.find((u) => u.id === user.userId);
const meLabel = me?.displayName || me?.email || "Admin";

const pendingTeachers = pendingRaw.map((t) => {
    const name = t.displayName || t.email;
    return {
        id: t.id,
        name,
        initials: initials(name),
        email: t.email,
        institution: t.institution,
        country: t.country,
        wantsCommunity: t.wantsCommunity,
        date: fmtDate(t.createdAt),
    };
});

const history = historyRaw.map((t) => {
    const name = t.displayName || t.email;
    return {
        id: t.id,
        name,
        initials: initials(name),
        email: t.email,
        institution: t.institution,
        status: t.teacherVerificationStatus,
        date: fmtDate(t.updatedAt),
    };
});

const kpis = {
    pending: pendingTeachers.length,
    teachersActive: users.filter((u) => u.verification === "VERIFIED").length,
    communitiesActive: communities.filter((c) => !c.graduated).length,
    students: users.filter((u) => u.profileType === "ESTUDIANTE").length,
    graduated: communities.filter((c) => c.graduated).length,
};

const today = fmtDate(new Date());
---

<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>&gt;_ ua wg lacnog — Platform Admin Console</title>
</head>
<body>
<div id="app">

    <!-- ── SIDEBAR ── -->
    <aside id="sidebar">
        <div class="sidebar-logo">
            <div class="logo-box">
                <div class="name">ua wg lacnog</div>
                <div class="sub">Platform Admin Console</div>
            </div>
        </div>

        <nav class="sidebar-nav">
            <div class="nav-section-label">Panel</div>

            <button class="nav-link active" data-view="requests" onclick="switchView('requests')">
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                Solicitudes
                {kpis.pending > 0 && <span class="pending-badge" id="sidebar-badge">{kpis.pending}</span>}
            </button>

            <button class="nav-link" data-view="communities" onclick="switchView('communities')">
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
                Comunidades
            </button>

            <button class="nav-link" data-view="users" onclick="switchView('users')">
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                Directorio
            </button>

            <div class="nav-section-label" style="margin-top:1rem">Plataforma</div>
            <a class="nav-link" href="/dashboard">
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
                Ir al Dashboard
            </a>
        </nav>

        <div class="sidebar-profile">
            <div class="profile-inner">
                <div class="avatar av-md av-amber">{meLabel.slice(0, 2).toUpperCase()}</div>
                <div style="flex:1;min-width:0">
                    <div style="font-size:.8125rem;font-weight:700;color:var(--gray-800);overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{meLabel}</div>
                    <span class="badge badge-amber" style="margin-top:.125rem">admin</span>
                </div>
            </div>
        </div>
    </aside>

    <!-- ── MAIN ── -->
    <div id="main">
        <div id="topbar">
            <div class="topbar-title">
                <span class="topbar-prompt">&gt;_</span>
                <span class="topbar-section">Platform Admin Console</span>
                <span class="topbar-slash">/</span>
                <span class="topbar-view" id="topbar-view">Solicitudes</span>
            </div>
            <div class="topbar-right">
                <div class="status-dot"><div class="dot"></div>Datos en vivo</div>
                <div class="divider-v"></div>
                <span id="topbar-date">{today}</span>
            </div>
        </div>

        <div id="content">

            <!-- ═══ VIEW 1: SOLICITUDES ═══ -->
            <div id="view-requests" class="view active">
                <div class="kpi-grid">
                    <div class="kpi-card">
                        <div class="kpi-icon" style="background:var(--amber-light)">
                            <svg fill="none" viewBox="0 0 24 24" stroke="var(--amber)" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        </div>
                        <div class="kpi-value" style="color:var(--amber)">{kpis.pending}</div>
                        <div class="kpi-label">Solicitudes Pendientes</div>
                    </div>
                    <div class="kpi-card">
                        <div class="kpi-icon" style="background:var(--teal-light)">
                            <svg fill="none" viewBox="0 0 24 24" stroke="#2a9d96" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        </div>
                        <div class="kpi-value" style="color:var(--teal-dark)">{kpis.teachersActive}</div>
                        <div class="kpi-label">Profesores Verificados</div>
                    </div>
                    <div class="kpi-card">
                        <div class="kpi-icon" style="background:var(--gray-100)">
                            <svg fill="none" viewBox="0 0 24 24" stroke="var(--gray-600)" stroke-width="2"><path d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
                        </div>
                        <div class="kpi-value" style="color:var(--gray-800)">{kpis.communitiesActive}</div>
                        <div class="kpi-label">Comunidades Activas</div>
                    </div>
                    <div class="kpi-card">
                        <div class="kpi-icon" style="background:var(--gray-100)">
                            <svg fill="none" viewBox="0 0 24 24" stroke="var(--gray-600)" stroke-width="2"><path d="M12 14l9-5-9-5-9 5 9 5z"/><path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/></svg>
                        </div>
                        <div class="kpi-value" style="color:var(--gray-800)">{kpis.students}</div>
                        <div class="kpi-label">Estudiantes Registrados</div>
                    </div>
                    <div class="kpi-card">
                        <div class="kpi-icon" style="background:var(--amber-light)">
                            <svg fill="none" viewBox="0 0 24 24" stroke="var(--amber)" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                        </div>
                        <div class="kpi-value" style="color:var(--amber)">{kpis.graduated}</div>
                        <div class="kpi-label">Comunidades Graduadas</div>
                    </div>
                </div>

                <section style="margin-bottom:2rem">
                    <div class="section-header">
                        <div class="section-title">
                            Profesores por verificar
                            <span class="count-chip" id="pending-chip" style="background:#FEF2F2;color:#DC2626;border:1px solid #FCA5A5">{kpis.pending} pendiente{kpis.pending === 1 ? "" : "s"}</span>
                        </div>
                        <span style="font-size:.6875rem;color:var(--gray-400)">Al aprobar, el profesor podrá crear comunidades</span>
                    </div>
                    <div class="request-list" id="pending-list">
                        {pendingTeachers.length === 0 ? (
                            <div class="empty-state">No hay profesores pendientes de verificación</div>
                        ) : pendingTeachers.map((t) => (
                            <div class="request-card" id={`req-${t.id}`} data-req={t.id}>
                                <div class="req-avatar-info">
                                    <div class="avatar av-md av-amber">{t.initials}</div>
                                    <div>
                                        <div class="req-name">{t.name}</div>
                                        <div class="req-email">{t.email}</div>
                                    </div>
                                </div>
                                <div class="req-tema-wrap">
                                    <div class="req-tema-label">Institución</div>
                                    <div class="req-tema">{t.institution || "No declarada"}</div>
                                </div>
                                <div class="req-right">
                                    {t.wantsCommunity && <span class="badge badge-amber">Desea crear comunidad</span>}
                                    {t.country && <span class="badge badge-gray">{t.country}</span>}
                                    <span class="req-date">{t.date}</span>
                                </div>
                                <div class="req-actions">
                                    <button class="btn btn-danger" onclick={`handleRequest('${t.id}','REJECT')`}>Rechazar</button>
                                    <button class="btn btn-primary" onclick={`handleRequest('${t.id}','APPROVE')`}>Aprobar</button>
                                </div>
                            </div>
                        ))}
                    </div>
                </section>

                <section>
                    <div class="section-header">
                        <div class="section-title">
                            Historial de Verificaciones
                            <span class="count-chip" id="history-chip" style="background:var(--gray-100);color:var(--gray-500);border:1px solid var(--gray-200)">{history.length} registro{history.length === 1 ? "" : "s"}</span>
                        </div>
                    </div>
                    <div class="table-wrap">
                        <table>
                            <thead>
                                <tr><th>Profesor</th><th>Institución</th><th>Fecha</th><th>Estado</th></tr>
                            </thead>
                            <tbody id="history-tbody">
                                {history.length === 0 ? (
                                    <tr><td colspan="4" style="color:var(--gray-400);padding:1.5rem;text-align:center">Sin verificaciones todavía</td></tr>
                                ) : history.map((h) => (
                                    <tr>
                                        <td>
                                            <div style="display:flex;align-items:center;gap:.625rem">
                                                <div class="avatar av-sm av-teal">{h.initials}</div>
                                                <div>
                                                    <div style="font-weight:600">{h.name}</div>
                                                    <div style="font-size:.6875rem;color:var(--gray-400)">{h.email}</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td style="color:var(--gray-600)">{h.institution || "—"}</td>
                                        <td style="color:var(--gray-500)">{h.date}</td>
                                        <td>
                                            {h.status === "VERIFIED"
                                                ? <span class="badge badge-success">Aprobada</span>
                                                : <span class="badge badge-error">Rechazada</span>}
                                        </td>
                                    </tr>
                                ))}
                            </tbody>
                        </table>
                    </div>
                </section>
            </div>

            <!-- ═══ VIEW 2: COMUNIDADES ═══ -->
            <div id="view-communities" class="view">
                <div class="toolbar">
                    <div class="search-wrap">
                        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                        <input class="search-input" id="search-comm" type="text" placeholder="Buscar por nombre o facilitador…" oninput="filterCommunities()"/>
                    </div>
                    <div class="select-wrap">
                        <select class="stage-select" id="filter-stage" onchange="filterCommunities()">
                            <option value="all">Todas las etapas</option>
                            <option value="conceptos_clave">Conceptos Clave</option>
                            <option value="implementacion_tecnica">Implementación Técnica</option>
                            <option value="graduada">Graduadas</option>
                        </select>
                        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
                    </div>
                    <label class="toggle-wrap">
                        <div class="toggle">
                            <input type="checkbox" id="show-graduated" onchange="filterCommunities()"/>
                            <div class="toggle-track"></div>
                            <div class="toggle-thumb"></div>
                        </div>
                        Mostrar graduadas
                    </label>
                    <div class="toolbar-stats">
                        <strong id="active-count">{kpis.communitiesActive}</strong> activas &nbsp;·&nbsp; <strong id="grad-count">{kpis.graduated}</strong> graduada(s)
                    </div>
                </div>

                <div class="comm-grid" id="communities-grid">
                    {communities.length === 0 ? (
                        <div class="empty-state" style="grid-column:1/-1">Todavía no hay comunidades en la plataforma</div>
                    ) : communities.map((c) => (
                        <div
                            class="comm-card"
                            id={`card-${c.id}`}
                            data-community-id={c.id}
                            data-titulo={c.name.toLowerCase()}
                            data-facilitador={c.teacher.toLowerCase()}
                            data-etapa={c.graduated ? "graduada" : c.stageKey}
                            data-graduated={c.graduated ? "1" : "0"}
                        >
                            <div class="stage-bar" data-stage-bar style={`background:${c.graduated ? "var(--amber-mid)" : c.stageKey === "implementacion_tecnica" ? "#7CD4CC" : "var(--amber)"}`}></div>
                            <div class="comm-body">
                                <div class="comm-header">
                                    <div class="comm-title">{c.name}</div>
                                    {c.graduated
                                        ? <span class="badge badge-success" data-stage-badge>Graduada</span>
                                        : c.stageKey === "implementacion_tecnica"
                                            ? <span class="badge badge-teal" data-stage-badge>Implementación Técnica</span>
                                            : <span class="badge badge-amber" data-stage-badge>Conceptos Clave</span>}
                                </div>
                                <div class="comm-desc">{c.topic}</div>
                                <div class="comm-facilitator">
                                    <div class="avatar av-sm av-teal">{c.teacherInitials}</div>
                                    <div class="fac-meta">
                                        <span class="fac-label">Facilitador</span>
                                        <span class="fac-name">{c.teacher}</span>
                                    </div>
                                </div>
                                <div class="progress-section">
                                    <div class="progress-row">
                                        <span class="progress-label">Retos completados</span>
                                        <span class="progress-val">{c.done}/{c.total}</span>
                                    </div>
                                    <div class="progress-track">
                                        <div class="progress-fill" style={`width:${c.pct}%;background:${c.stageKey === "implementacion_tecnica" ? "#7CD4CC" : "var(--amber)"}`}></div>
                                    </div>
                                    <div class="progress-meta">
                                        <span>{c.pct}% completado</span>
                                        <span>{c.members} miembro{c.members === 1 ? "" : "s"}</span>
                                    </div>
                                </div>
                                <div class="comm-footer" data-action-area>
                                    <span class="muted-note">Solo el profesor dueño puede promover o graduar</span>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>

            <!-- ═══ VIEW 3: DIRECTORIO ═══ -->
            <div id="view-users" class="view">
                <div class="summary-grid" style="margin-bottom:1.5rem">
                    <div class="summary-card">
                        <div class="summary-icon" style="background:var(--gray-100)">
                            <svg fill="none" viewBox="0 0 24 24" stroke="var(--gray-600)" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
                        </div>
                        <div><div class="summary-val" style="color:var(--gray-800)">{users.length}</div><div class="summary-label">Usuarios totales</div></div>
                    </div>
                    <div class="summary-card">
                        <div class="summary-icon" style="background:var(--teal-light)">
                            <svg fill="none" viewBox="0 0 24 24" stroke="#2a9d96" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        </div>
                        <div><div class="summary-val" style="color:var(--teal-dark)">{users.filter((u) => u.profileType === "PROFESOR").length}</div><div class="summary-label">Profesores</div></div>
                    </div>
                    <div class="summary-card">
                        <div class="summary-icon" style="background:var(--gray-100)">
                            <svg fill="none" viewBox="0 0 24 24" stroke="var(--gray-600)" stroke-width="2"><path d="M12 14l9-5-9-5-9 5 9 5z"/><path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/></svg>
                        </div>
                        <div><div class="summary-val" style="color:var(--gray-800)">{kpis.students}</div><div class="summary-label">Estudiantes</div></div>
                    </div>
                    <div class="summary-card">
                        <div class="summary-icon" style="background:var(--amber-light)">
                            <svg fill="none" viewBox="0 0 24 24" stroke="var(--amber)" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        </div>
                        <div><div class="summary-val" style="color:var(--amber)">{kpis.teachersActive}</div><div class="summary-label">Profesores verificados</div></div>
                    </div>
                </div>

                <div class="toolbar" style="margin-bottom:1rem">
                    <div class="search-wrap">
                        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                        <input class="search-input" id="search-user" type="text" placeholder="Buscar por nombre o email…" oninput="filterUsers()"/>
                    </div>
                    <div class="select-wrap">
                        <select class="stage-select" id="filter-profile" onchange="filterUsers()">
                            <option value="all">Todos los perfiles</option>
                            <option value="PROFESOR">Profesores</option>
                            <option value="ESTUDIANTE">Estudiantes</option>
