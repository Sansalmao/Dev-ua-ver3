---
// Barra de navegación
---

<nav class="site-nav" aria-label="Navegación principal">
    <a
        class="nav-brand"
        href="/"
        aria-label="Ir al inicio de Skills UA"
        data-nav-home
    >
        <div class="dot-ready" aria-hidden="true"></div>
        <img
            src="/images/ua-icon.png"
            alt="UA Skills"
            class="nav-ua-icon"
            aria-hidden="true"
        />
        <span class="lbl">~/skills</span><span class="lbl ua">UA</span>
    </a>

    <div class="nav-links" aria-label="Secciones principales">
        <a class="nav-link" href="/" data-nav-home>
            <span class="prefix">$ UA</span>
            <span class="seg">- INICIO</span>
        </a>
        <a class="nav-link" href="#">
            <span class="prefix">$ man</span>
            <span class="seg">—proyecto</span>
        </a>
    </div>

    <div class="nav-right">
        <!-- Se llena en el cliente (getSession()): "Ingresar" o email + "Salir". -->
        <div id="nav-auth" class="nav-auth" aria-live="polite">
            <button
                type="button"
                class="btn-auth-login"
                data-open-auth-modal="register"
            >
                $ Registrarse
            </button>
        </div>

        <button type="button" class="btn-lang" aria-label="Cambiar idioma">
            <svg
                width="13"
                height="13"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
            >
                <circle cx="12" cy="12" r="10"></circle>
                <path
                    d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10
                     15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
                ></path>
            </svg>
            ES
        </button>
    </div>
</nav>

<script>
    document.querySelectorAll("[data-nav-home]").forEach((el) => {
        el.addEventListener("click", () => {
            sessionStorage.setItem("ua_force_home", "1");
        });
    });
</script>

<script>
    import { getSession, logout } from "../lib/api-client";

    function escapeHtml(str) {
        return String(str).replace(/[&<>"']/g, (c) => ({
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#39;",
        })[c]);
    }

    async function renderAuthState() {
        const container = document.getElementById("nav-auth");
        if (!container) return;

        const user = await getSession();

        if (!user) {
            container.innerHTML = `
                    <button type="button" class="btn-auth-login" data-open-auth-modal="register">
                        $ Registrarse
                    </button>
                `;
            return;
        }

        const label = escapeHtml(user.displayName || user.email);
        const emailAttr = escapeHtml(user.email);
        container.innerHTML = `
                <a class="auth-user-link" href="/dashboard" title="Ir a tu panel — ${emailAttr}">
                    <svg class="auth-user-ico" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="3" width="7" height="9" rx="1"></rect>
                        <rect x="14" y="3" width="7" height="5" rx="1"></rect>
                        <rect x="14" y="12" width="7" height="9" rx="1"></rect>
                        <rect x="3" y="16" width="7" height="5" rx="1"></rect>
                    </svg>
                    <span class="auth-user">${label}</span>
                </a>
                <button type="button" class="btn-auth-logout" id="btn-nav-logout">Salir</button>
            `;

        document
            .getElementById("btn-nav-logout")
            ?.addEventListener("click", async () => {
                try {
                    await logout();
                } finally {
                    location.reload();
                }
            });
    }

    renderAuthState();
    document.addEventListener("auth:changed", renderAuthState);
</script>

<style>
    .site-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 14px 40px;
        border-bottom: 1px solid var(--border);
        background: var(--bg);
        position: sticky;
        top: 0;
        z-index: 40;
    }

    .nav-brand {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
        color: inherit;
    }

    .nav-brand:hover {
        color: inherit;
    }

    /* UA icon — solo la imagen, sin fondo adicional */
    .nav-ua-icon {
        width: 28px;
        height: 28px;
        object-fit: contain;
        flex-shrink: 0;
    }

    .nav-brand .lbl {
        font-family: var(--font-mono);
        font-size: 14px;
        font-weight: 600;
        color: var(--text-secondary);
    }

    .nav-brand .ua {
        color: var(--accent);
    }

    .dot-ready {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--green);
        flex-shrink: 0;
    }

    .nav-links {
        display: flex;
        align-items: center;
        gap: 2px;
        min-width: 0;
    }

    .nav-link {
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 13px;
        color: inherit;
        white-space: nowrap;
        transition:
            background var(--transition-fast),
            color var(--transition-fast);
    }

    .nav-link:hover {
        background: var(--accent-soft);
        color: inherit;
    }

    .nav-link .prefix {
        font-family: var(--font-mono);
        font-weight: 600;
        color: var(--text-muted);
    }

    .nav-link .seg {
        color: var(--text-secondary);
    }

    .nav-right {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
    }

    .btn-icon,
    .btn-lang {
        border: 1px solid var(--border);
        transition:
            background var(--transition-fast),
            color var(--transition-fast),
            border-color var(--transition-fast);
    }

    .btn-lang {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 12px;
        border-radius: 8px;
        font-size: 12px;
        color: var(--text-secondary);
        font-family: var(--font-body);
        white-space: nowrap;
    }

    .btn-lang:hover {
        background: var(--accent-soft);
        color: var(--text);
    }

    .nav-auth {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-left: 4px;
        padding-left: 12px;
        border-left: 1px solid var(--border);
    }

    @media (max-width: 900px) {
        .site-nav {
            padding: 12px 20px;
            flex-wrap: wrap;
        }

        .nav-links {
            order: 3;
            width: 100%;
            overflow-x: auto;
            padding-bottom: 4px;
            scrollbar-width: thin;
        }
    }

    @media (max-width: 640px) {
        .site-nav {
            gap: 12px;
        }

        .nav-link {
            padding: 6px 10px;
        }

        .nav-link .seg {
            display: none;
        }

        .btn-lang {
            padding: 5px 10px;
        }
    }
</style>

<style is:global>
    .btn-auth-login,
    .btn-auth-logout {
        font-family: var(--font-mono);
        font-size: 12px;
        font-weight: 600;
        padding: 6px 14px;
        border-radius: 8px;
        white-space: nowrap;
        border: none;
        cursor: pointer;
        transition:
            background var(--transition-fast),
            color var(--transition-fast);
    }

    .btn-auth-login {
        background: transparent;
        color: var(--accent);
        font-weight: 700;
    }

    .btn-auth-login:hover {
        color: var(--accent-hover);
        background: var(--accent-soft);
    }

    .btn-auth-logout {
        border: 1px solid var(--border);
        background: transparent;
        color: var(--text-secondary);
    }

    .btn-auth-logout:hover {
        background: var(--accent-soft);
        color: var(--text);
    }

    .auth-user {
        font-size: 12px;
        color: var(--text-secondary);
        max-width: 140px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .auth-user-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 10px;
        border-radius: 8px;
        text-decoration: none;
        color: var(--text-secondary);
        transition:
            background var(--transition-fast),
            color var(--transition-fast);
    }

    .auth-user-link:hover {
        background: var(--accent-soft);
        color: var(--accent);
    }

    .auth-user-link:hover .auth-user {
        color: var(--accent);
    }

    .auth-user-ico {
        flex-shrink: 0;
        opacity: 0.75;
    }

    .auth-user-link:hover .auth-user-ico {
        opacity: 1;
    }
</style>
