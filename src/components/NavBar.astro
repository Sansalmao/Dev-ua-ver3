---
// Variables: Guía Visual v2.0
---

<nav class="site-nav" aria-label="Navegación principal">
    <a
        class="nav-brand"
        href="/"
        aria-label="Ir al inicio de Skills UA"
        data-nav-home
    >
        <div class="dot-ready" aria-hidden="true"></div>
        <span class="lbl">~/skills</span><span class="lbl ua">UA</span>
    </a>

    <div class="nav-links" aria-label="Secciones principales">
        <a class="nav-link" href="/" data-nav-home>
            <span class="prefix">$ UA</span>
            <span class="seg">- INICIO</span>
        </a>
        <a class="nav-link" href="#">
            <span class="prefix">$ cd</span>
            <span class="seg">/ blog</span>
        </a>
        <a class="nav-link" href="#">
            <span class="prefix">$ watch</span>
            <span class="seg">Eventos</span>
        </a>
        <a class="nav-link" href="#">
            <span class="prefix">$ man</span>
            <span class="seg">—proyecto</span>
        </a>
    </div>

    <div class="nav-right">
        <button type="button" class="btn-icon" aria-label="Cambiar tema">
            <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
            >
                <circle cx="12" cy="12" r="4"></circle>
                <path
                    d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41
                 M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
                ></path>
            </svg>
        </button>

        <button type="button" class="btn-lang" aria-label="Cambiar idioma">
            <svg
                width="13"
                height="13"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
            >
                <circle cx="12" cy="12" r="10"></circle>
                <path
                    d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10
                 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
                ></path>
            </svg>
            ES
        </button>
    </div>
</nav>

<script>
    document.querySelectorAll("[data-nav-home]").forEach((el) => {
        el.addEventListener("click", () => {
            sessionStorage.setItem("ua_force_home", "1");
        });
    });
</script>

<style>
    .site-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 14px 40px;
        border-bottom: 1px solid var(--border);
        background: var(--bg);
        position: sticky;
        top: 0;
        z-index: 40;
    }

    .nav-brand {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        flex-shrink: 0;
        color: inherit;
    }

    .nav-brand:hover {
        color: inherit;
    }

    .nav-brand .lbl {
        font-family: var(--font-mono);
        font-size: 14px;
        font-weight: 600;
        color: var(--text-secondary);
    }

    .nav-brand .ua {
        color: var(--accent);
    }

    .dot-ready {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--green);
        flex-shrink: 0;
    }

    .nav-links {
        display: flex;
        align-items: center;
        gap: 2px;
        min-width: 0;
    }

    .nav-link {
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 13px;
        color: inherit;
        white-space: nowrap;
        transition:
            background var(--transition-fast),
            color var(--transition-fast);
    }

    .nav-link:hover {
        background: var(--accent-soft);
        color: inherit;
    }

    .nav-link .prefix {
        font-family: var(--font-mono);
        font-weight: 600;
        color: var(--text-muted);
    }

    .nav-link .seg {
        color: var(--text-secondary);
    }

    .nav-right {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
    }

    .btn-icon,
    .btn-lang {
        border: 1px solid var(--border);
        transition:
            background var(--transition-fast),
            color var(--transition-fast),
            border-color var(--transition-fast);
    }

    .btn-icon {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--text-muted);
    }

    .btn-icon:hover {
        color: var(--text);
        background: var(--accent-soft);
    }

    .btn-lang {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 12px;
        border-radius: 8px;
        font-size: 12px;
        color: var(--text-secondary);
        font-family: var(--font-body);
        white-space: nowrap;
    }

    .btn-lang:hover {
        background: var(--accent-soft);
        color: var(--text);
    }

    @media (max-width: 900px) {
        .site-nav {
            padding: 12px 20px;
            flex-wrap: wrap;
        }

        .nav-links {
            order: 3;
            width: 100%;
            overflow-x: auto;
            padding-bottom: 4px;
            scrollbar-width: thin;
        }
    }

    @media (max-width: 640px) {
        .site-nav {
            gap: 12px;
        }

        .nav-link {
            padding: 6px 10px;
        }

        .nav-link .seg {
            display: none;
        }

        .btn-lang {
            padding: 5px 10px;
        }
    }
</style>
