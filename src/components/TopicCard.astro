---
export type TopicState = "nuevo" | "progreso" | "completado";

interface Props {
    id: string;
    titulo: string;
    nivel: "Básico" | "Avanzado";
    duracion: string;
    descripcion: string;
    estado: TopicState;
}

const { id, titulo, nivel, duracion, descripcion, estado } = Astro.props;

const nivelClass = nivel === "Avanzado" ? "avanzado" : "basico";
const cardClass =
    estado === "completado"
        ? "completed"
        : estado === "progreso"
          ? "visited"
          : "";

const botonTexto =
    estado === "completado"
        ? "$ revisar"
        : estado === "progreso"
          ? "$ continuar"
          : "$ iniciar";
---

<div class={`topic-card ${cardClass}`} data-id={id}>
    <div class="tc-top">
        <div class="tc-icon-box">
            <slot name="icon" />
        </div>

        <div class="tc-info">
            <div class="tc-title">
                {titulo}
                {
                    estado === "completado" && (
                        <span class="tc-sbadge done">✓ completado</span>
                    )
                }
                {
                    estado === "progreso" && (
                        <span class="tc-sbadge prog">en progreso</span>
                    )
                }
            </div>

            <div class="tc-badges">
                <span class={`tc-nivel ${nivelClass}`}>{nivel}</span>

                <span class="tc-dur">
                    <svg
                        width="11"
                        height="11"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        aria-hidden="true"
                    >
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    {duracion}
                </span>
            </div>
        </div>
    </div>

    <p class="tc-desc">{descripcion}</p>

    <div class="tc-foot">
        <button type="button" class="btn-iniciar" data-id={id}>
            {botonTexto}
        </button>

        {
            estado !== "nuevo" && (
                <div class="tc-prog">
                    <div class="tc-prog-lbl">
                        Progreso: {estado === "completado" ? "100" : "60"}%
                    </div>
                    <div class="tc-prog-bg">
                        <div
                            class={`tc-prog-fill ${estado === "completado" ? "green" : "orange"}`}
                            style={`width: ${estado === "completado" ? 100 : 60}%;`}
                        />
                    </div>
                </div>
            )
        }
    </div>
</div>

<style>
    .topic-card {
        border-radius: 16px;
        border: 1px solid var(--border);
        background: var(--card-bg);
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 14px;
        transition:
            box-shadow var(--transition-fast),
            border-color var(--transition-fast),
            transform var(--transition-fast);
    }

    .topic-card:hover {
        box-shadow: var(--shadow-card-hover);
        border-color: var(--accent-border-soft);
        transform: translateY(-2px);
    }

    .topic-card.visited {
        border-color: var(--accent-border-light);
    }

    .topic-card.completed {
        border-color: var(--success-border-light);
    }

    .tc-top {
        display: flex;
        align-items: flex-start;
        gap: 14px;
    }

    .tc-icon-box {
        width: 46px;
        height: 46px;
        flex-shrink: 0;
        border-radius: 10px;
        background: var(--accent-soft);
        border: 1px solid var(--accent-border-light);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--accent);
    }

    .tc-info {
        flex: 1;
        min-width: 0;
    }

    .tc-title {
        font-size: 15px;
        font-weight: 700;
        color: var(--text);
        line-height: 1.3;
        margin-bottom: 7px;
    }

    .tc-badges {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .tc-nivel {
        font-family: var(--font-mono);
        font-size: 10px;
        padding: 2px 9px;
        border-radius: 100px;
    }

    .tc-nivel.basico {
        background: var(--bg);
        color: var(--text-secondary);
    }

    .tc-nivel.avanzado {
        background: var(--accent-soft);
        color: var(--accent);
    }

    .tc-dur {
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--text-muted);
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .tc-sbadge {
        font-family: var(--font-mono);
        font-size: 10px;
        padding: 2px 7px;
        border-radius: 4px;
        margin-left: 5px;
        vertical-align: middle;
    }

    .tc-sbadge.prog {
        background: var(--accent-bg-soft);
        color: var(--accent);
    }

    .tc-sbadge.done {
        background: var(--green-bg);
        color: var(--green-text);
    }

    .tc-desc {
        font-size: 13px;
        color: var(--text-secondary);
        line-height: 1.55;
    }

    .tc-foot {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .btn-iniciar {
        flex-shrink: 0;
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 600;
        padding: 7px 14px;
        border-radius: 8px;
        border: 1px solid var(--accent-border-light);
        color: var(--accent);
        background: none;
        transition:
            background var(--transition-fast),
            color var(--transition-fast),
            border-color var(--transition-fast);
    }

    .btn-iniciar:hover {
        background: var(--accent);
        color: var(--card-bg);
        border-color: var(--accent);
    }

    .tc-prog {
        flex: 1;
    }

    .tc-prog-lbl {
        font-family: var(--font-mono);
        font-size: 10px;
        color: var(--text-muted);
        margin-bottom: 5px;
    }

    .tc-prog-bg {
        width: 100%;
        height: 4px;
        background: var(--border);
        border-radius: 99px;
        overflow: hidden;
    }

    .tc-prog-fill {
        height: 100%;
        border-radius: 99px;
        transition: width 0.5s ease;
    }

    .tc-prog-fill.orange {
        background: var(--accent);
    }

    .tc-prog-fill.green {
        background: var(--green);
    }

    @media (max-width: 640px) {
        .tc-foot {
            flex-direction: column;
            align-items: stretch;
        }
    }
</style>
