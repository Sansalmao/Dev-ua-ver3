---
const TURNSTILE_SITE_KEY = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
---

<div
    id="auth-modal-overlay"
    class="am-overlay"
    role="dialog"
    aria-modal="true"
    aria-labelledby="am-title"
>
    <div class="am-modal">
        <div class="am-card">
            <button
                type="button"
                id="auth-modal-close"
                class="am-close"
                aria-label="Cerrar"
            >
                <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    aria-hidden="true"
                >
                    <path d="M18 6L6 18M6 6l12 12"></path>
                </svg>
            </button>

            <div class="am-header">
                <div class="am-badge">COMUNIDAD GLOBAL</div>
                <h2 id="am-title" class="am-title" data-title>Registrarse</h2>
                <p class="am-subtitle" data-subtitle>
                    Crea una cuenta para seguir tu progreso, mostrar tu conjunto
                    de habilidades y formar parte de la comunidad.
                </p>
            </div>

            <p id="auth-error" class="am-error" hidden></p>

            <!-- ── REGISTRO ─────────────────────────────────────────────── -->
            <form id="auth-form-register" class="am-form" data-view="register">
                <div class="am-row">
                    <input
                        class="am-input"
                        type="text"
                        name="displayName"
                        placeholder="Nombre Completo"
                        autocomplete="name"
                    />
                    <input
                        class="am-input"
                        type="email"
                        name="email"
                        placeholder="Correo electrónico"
                        autocomplete="email"
                        required
                    />
                </div>
                <input
                    class="am-input"
                    type="password"
                    name="password"
                    placeholder="Contraseña"
                    autocomplete="new-password"
                    minlength="8"
                    required
                />

                <!-- Campos extra: solo Profesor/instructor -->
                <div id="auth-prof-extra" class="am-extra" hidden>
                    <div class="am-row">
                        <input
                            class="am-input"
                            type="text"
                            name="country"
                            placeholder="País"
                            autocomplete="country-name"
                        />
                        <input
                            class="am-input"
                            type="text"
                            name="institution"
                            placeholder="Institución"
                            autocomplete="organization"
                        />
                    </div>
                    <label class="am-check">
                        <input type="checkbox" name="wantsCommunity" />
                        <span>deseo crear una comunidad de práctica</span>
                    </label>
                </div>

                <!-- Toggle de perfil -->
                <div class="am-toggle" role="group" aria-label="Tipo de perfil">
                    <button
                        type="button"
                        class="am-toggle-btn"
                        data-profile="PROFESOR">Profesor / instructor</button
                    >
                    <button
                        type="button"
                        class="am-toggle-btn"
                        data-profile="ESTUDIANTE"
                        >Estudiante / Profesional</button
                    >
                </div>
                <input
                    type="hidden"
                    name="profileType"
                    id="auth-profile-value"
                    value=""
                />

                <!-- Turnstile -->
                <div class="am-turnstile">
                    <div
                        id="auth-turnstile"
                        class="cf-turnstile"
                        data-sitekey={TURNSTILE_SITE_KEY}
                    >
                    </div>
                </div>

                <button
                    type="submit"
                    id="auth-register-cta"
                    class="am-cta"
                    disabled
                >
                    $ seleccione un perfil para continuar
                </button>

                <p class="am-switch">
                    ¿Ya tienes una cuenta?
                    <button type="button" class="am-link" data-auth-goto="login"
                        >Iniciar sesión »</button
                    >
                </p>
            </form>

            <!-- ── INGRESO ──────────────────────────────────────────────── -->
            <form id="auth-form-login" class="am-form" data-view="login" hidden>
                <input
                    class="am-input"
                    type="email"
                    name="email"
                    placeholder="Correo electrónico"
                    autocomplete="email"
                    required
                />
                <input
                    class="am-input"
                    type="password"
                    name="password"
                    placeholder="Contraseña"
                    autocomplete="current-password"
                    required
                />
                <button type="submit" class="am-cta am-cta--ready"
                    >$ Ingresar</button
                >
                <p class="am-switch">
                    ¿No tienes una cuenta?
                    <button
                        type="button"
                        class="am-link"
                        data-auth-goto="register">Regístrate »</button
                    >
                </p>
            </form>
        </div>
    </div>
</div>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer
></script>

<script>
    import { register, login, ApiError } from "../lib/api-client";

    declare global {
        interface Window {
            turnstile?: {
                render: (
                    c: string | HTMLElement,
                    o: { sitekey: string },
                ) => string;
                reset: (id?: string) => void;
                getResponse: (id?: string) => string | undefined;
            };
        }
    }

    const overlay = document.getElementById("auth-modal-overlay")!;
    const closeBtn = document.getElementById("auth-modal-close")!;
    const errorEl = document.getElementById("auth-error")!;
    const titleEl = document.querySelector("[data-title]")!;
    const subtitleEl = document.querySelector("[data-subtitle]")!;
    const registerForm = document.getElementById(
        "auth-form-register",
    ) as HTMLFormElement;
    const loginForm = document.getElementById(
        "auth-form-login",
    ) as HTMLFormElement;
    const profExtra = document.getElementById("auth-prof-extra")!;
    const profileValue = document.getElementById(
        "auth-profile-value",
    ) as HTMLInputElement;
    const registerCta = document.getElementById(
        "auth-register-cta",
    ) as HTMLButtonElement;
    const toggleBtns = Array.from(
        document.querySelectorAll<HTMLButtonElement>(".am-toggle-btn"),
    );

    let turnstileWidgetId: string | undefined;
    let turnstileRendered = false;

    function showError(msg: string) {
        errorEl.textContent = msg;
        errorEl.hidden = false;
    }
    function clearError() {
        errorEl.hidden = true;
        errorEl.textContent = "";
    }

    function setView(view: "register" | "login") {
        clearError();
        registerForm.hidden = view !== "register";
        loginForm.hidden = view !== "login";
        titleEl.textContent =
            view === "register" ? "Registrarse" : "Iniciar sesión";
        (subtitleEl as HTMLElement).textContent =
            view === "register"
                ? "Crea una cuenta para seguir tu progreso, mostrar tu conjunto de habilidades y formar parte de la comunidad."
                : "Ingresa para continuar tu ruta.";
        if (view === "register") maybeRenderTurnstile();
    }

    function selectProfile(profile: string) {
        profileValue.value = profile;
        for (const b of toggleBtns) {
            b.classList.toggle(
                "am-toggle-btn--active",
                b.dataset.profile === profile,
            );
        }
        // Campos extra solo para Profesor.
        profExtra.hidden = profile !== "PROFESOR";
        // CTA se habilita al elegir perfil.
        registerCta.disabled = false;
        registerCta.classList.add("am-cta--ready");
        registerCta.textContent = "$ Crear cuenta";
    }

    function maybeRenderTurnstile() {
        if (turnstileRendered) return;
        const container = document.getElementById("auth-turnstile");
        const sitekey = container?.dataset.sitekey;
        if (!container || !sitekey || !window.turnstile) {
            setTimeout(maybeRenderTurnstile, 300);
            return;
        }
        turnstileWidgetId = window.turnstile.render(container, { sitekey });
        turnstileRendered = true;
    }

    function openModal(view: "register" | "login" = "register") {
        overlay.classList.add("am-overlay--open");
        document.body.style.overflow = "hidden";
        setView(view);
    }
    function closeModal() {
        overlay.classList.remove("am-overlay--open");
        document.body.style.overflow = "";
        clearError();
    }

    document.addEventListener("click", (e) => {
        const trigger = (e.target as HTMLElement).closest<HTMLElement>(
            "[data-open-auth-modal]",
        );
        if (trigger) {
            const v =
                trigger.dataset.openAuthModal === "login"
                    ? "login"
                    : "register";
            openModal(v);
        }
    });
    closeBtn.addEventListener("click", closeModal);
    overlay.addEventListener("click", (e) => {
        if (e.target === overlay) closeModal();
    });
    document.addEventListener("keydown", (e) => {
        if (
            e.key === "Escape" &&
            overlay.classList.contains("am-overlay--open")
        )
            closeModal();
    });

    for (const b of toggleBtns)
        b.addEventListener("click", () => selectProfile(b.dataset.profile!));
    for (const el of document.querySelectorAll<HTMLButtonElement>(
        "[data-auth-goto]",
    )) {
        el.addEventListener("click", () =>
            setView(el.dataset.authGoto as "register" | "login"),
        );
    }

    registerForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        clearError();
        if (!profileValue.value) {
            showError("Selecciona un perfil para continuar.");
            return;
        }
        const token = window.turnstile?.getResponse(turnstileWidgetId);
        if (!token) {
            showError("Completa la verificación anti-bot antes de continuar.");
            return;
        }
        const data = new FormData(registerForm);
        registerCta.disabled = true;
        registerCta.textContent = "Un momento…";
        try {
            await register({
                email: String(data.get("email")),
                password: String(data.get("password")),
                profileType: profileValue.value as "PROFESOR" | "ESTUDIANTE",
                displayName: String(data.get("displayName") ?? "") || undefined,
                turnstileToken: token,
                country: String(data.get("country") ?? "") || undefined,
                institution: String(data.get("institution") ?? "") || undefined,
                wantsCommunity: data.get("wantsCommunity") === "on",
            });
            document.dispatchEvent(new CustomEvent("auth:changed"));
            closeModal();
            location.reload();
        } catch (err) {
            window.turnstile?.reset(turnstileWidgetId);
            showError(
                err instanceof ApiError
                    ? err.message
                    : "No se pudo completar el registro.",
            );
            registerCta.disabled = false;
            registerCta.textContent = "$ Crear cuenta";
        }
    });

    loginForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        clearError();
        const data = new FormData(loginForm);
        const btn = loginForm.querySelector<HTMLButtonElement>(
            'button[type="submit"]',
        )!;
        btn.disabled = true;
        btn.textContent = "Un momento…";
        try {
            await login({
                email: String(data.get("email")),
                password: String(data.get("password")),
            });
            document.dispatchEvent(new CustomEvent("auth:changed"));
            closeModal();
            location.reload();
        } catch (err) {
            showError(
                err instanceof ApiError ? err.message : "No se pudo ingresar.",
            );
            btn.disabled = false;
            btn.textContent = "$ Ingresar";
        }
    });
</script>

<style>
    .am-overlay {
        position: fixed;
        inset: 0;
        z-index: 100;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(0, 0, 0, 0.32);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        overflow-y: auto;
    }
    .am-overlay--open {
        display: flex;
    }

    .am-modal {
        position: relative;
        width: 100%;
        max-width: 480px;
    }

    .am-card {
        position: relative;
        background: var(--card-bg, #fff);
        border: 1px solid var(--border, #ede8df);
        border-radius: 20px;
        padding: 22px 28px 20px;
        box-shadow: 0 22px 54px rgba(0, 0, 0, 0.18);
        text-align: left;
    }
    .am-close {
        position: absolute;
        top: 12px;
        right: 12px;
        background: none;
        border: none;
        color: var(--text-muted, #a0aab4);
        cursor: pointer;
        padding: 4px;
        border-radius: 8px;
        transition: color 0.15s ease;
        z-index: 2;
    }
    .am-close:hover {
        color: var(--text, #1a1a1a);
    }

    .am-header {
        text-align: center;
        margin-bottom: 12px;
    }
    .am-badge {
        display: inline-block;
        border: 1.5px solid var(--accent, #e5621a);
        color: var(--accent, #e5621a);
        font-size: 0.66rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        padding: 4px 13px;
        border-radius: 999px;
        margin-bottom: 9px;
    }
    .am-title {
        color: var(--accent, #e5621a);
        font-size: 1.55rem;
        font-weight: 800;
        line-height: 1.1;
        margin: 0 0 5px;
    }
    .am-subtitle {
        color: var(--text-secondary, #4b5563);
        font-size: 0.83rem;
        line-height: 1.5;
        max-width: 38ch;
        margin: 0 auto;
    }
    .am-error {
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #dc2626;
        font-size: 0.85rem;
        border-radius: 10px;
        padding: 8px 12px;
        margin: 0 0 14px;
    }
    .am-form {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }
    .am-row {
        display: flex;
        gap: 10px;
    }
    .am-row .am-input {
        flex: 1;
    }

    .am-input {
        width: 100%;
        border: 1.5px solid var(--border, #ede8df);
        border-radius: 12px;
        padding: 10px 14px;
        font-size: 0.9rem;
        color: var(--text, #1a1a1a);
        background: var(--card-bg, #fff);
        outline: none;
        transition: border-color 0.15s ease;
    }
    .am-input:focus {
        border-color: var(--accent, #e5621a);
    }
    .am-input::placeholder {
        color: var(--text-muted, #a0aab4);
    }

    .am-extra {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    .am-check {
        display: flex;
        align-items: center;
        gap: 9px;
        font-size: 0.9rem;
        color: var(--text-secondary, #4b5563);
        cursor: pointer;
    }
    .am-check input {
        width: 17px;
        height: 17px;
        accent-color: var(--accent, #e5621a);
    }

    .am-toggle {
        display: flex;
        gap: 0;
        border: 1.5px solid var(--border, #ede8df);
        border-radius: 12px;
        overflow: hidden;
        margin-top: 2px;
    }
    .am-toggle-btn {
        flex: 1;
        background: transparent;
        border: none;
        padding: 10px 8px;
        font-size: 0.92rem;
        font-weight: 600;
        color: var(--text-secondary, #4b5563);
        cursor: pointer;
        transition:
            background 0.15s ease,
            color 0.15s ease;
    }
    .am-toggle-btn--active {
        background: var(--accent, #e5621a);
        color: #fff;
    }

    .am-turnstile {
        display: flex;
        justify-content: center;
        margin: 2px 0;
    }

    .am-cta {
        width: 100%;
        border: none;
        border-radius: 12px;
        padding: 11px;
        font-size: 0.98rem;
        font-weight: 700;
        cursor: not-allowed;
        background: var(--accent, #e5621a);
        color: #fff;
        opacity: 0.6;
        transition:
            opacity 0.15s ease,
            background 0.15s ease;
    }
    .am-cta--ready {
        cursor: pointer;
        opacity: 1;
        box-shadow: 0 8px 20px rgba(229, 98, 26, 0.3);
    }
    .am-cta--ready:hover {
        background: var(--accent-hover, #c94f10);
    }
    .am-cta:disabled {
        cursor: not-allowed;
    }

    .am-switch {
        text-align: center;
        font-size: 0.9rem;
        color: var(--text-secondary, #4b5563);
        margin: 6px 0 0;
    }
    .am-link {
        background: none;
        border: none;
        color: var(--accent, #e5621a);
        font-weight: 700;
        cursor: pointer;
        padding: 0;
        font-size: 0.9rem;
    }
    .am-link:hover {
        text-decoration: underline;
    }

    @media (max-width: 520px) {
        .am-title {
            font-size: 1.6rem;
        }
        .am-row {
            flex-direction: column;
        }
    }
</style>
