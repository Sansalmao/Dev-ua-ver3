---
interface Props {
    dificultad: string; // Por ejemplo: "Básico", "Intermedio", "Avanzado"
    tiempo: string; // Por ejemplo: "1h 30min"
    objetivo: string; // Descripción breve del objetivo
    progreso: number; // 0-100
    filename?: string;
}

const { dificultad, tiempo, objetivo, progreso, filename } = Astro.props;
const safeProgress = Math.max(0, Math.min(100, progreso));
---

<div class="metadata-card">
    <div class="metadata-card__bar">
        <div class="metadata-card__dots">
            <div class="d-r" aria-hidden="true"></div>
            <div class="d-y" aria-hidden="true"></div>
            <div class="d-g" aria-hidden="true"></div>
            <span class="metadata-card__filename"
                >{filename ?? "modulo.md"}</span
            >
        </div>

        <div class="metadata-card__progress">
            <span class="metadata-card__percentage">{safeProgress}%</span>
            <div class="metadata-card__progress-track" aria-hidden="true">
                <div
                    class="metadata-card__progress-fill"
                    style="width: 0%;"
                    data-initial={safeProgress}
                >
                </div>
            </div>
        </div>
    </div>

    <div class="metadata-card__grid">
        <div class="metadata-card__row">
            <span class="metadata-card__key">DIFICULTAD</span>
            <span class="metadata-card__value">{dificultad}</span>
        </div>

        <div class="metadata-card__row">
            <span class="metadata-card__key">TIEMPO</span>
            <span class="metadata-card__value metadata-card__value--accent">
                {tiempo}
            </span>
        </div>

        <div class="metadata-card__row">
            <span class="metadata-card__key">OBJETIVO</span>
            <span class="metadata-card__value">{objetivo}</span>
        </div>
    </div>
</div>

<style>
    .metadata-card {
        border-radius: 10px;
        border: 1px solid var(--border);
        background: var(--card-bg);
        overflow: hidden;
        margin-bottom: 2rem;
    }

    .metadata-card__bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        padding: 8px 12px;
        background: var(--bg);
        border-bottom: 1px solid var(--border);
    }

    .metadata-card__dots {
        display: flex;
        align-items: center;
        gap: 6px;
        min-width: 0;
    }

    .metadata-card__filename {
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--text-muted);
        margin-left: 4px;
        white-space: nowrap;
    }

    .metadata-card__progress {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        min-width: 100px;
        flex-shrink: 0;
    }

    .metadata-card__percentage {
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 600;
        margin-bottom: 2px;
        color: var(--green-text);
    }

    .metadata-card__progress-track {
        width: 100%;
        height: 4px;
        background: var(--border);
        border-radius: 99px;
        overflow: hidden;
    }

    .metadata-card__progress-fill {
        height: 100%;
        background: var(--green);
        border-radius: 99px;
        transition: width 0.5s ease;
    }

    .metadata-card__grid {
        padding: 12px 16px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .metadata-card__row {
        display: grid;
        grid-template-columns: 7rem 1fr;
        align-items: baseline;
        gap: 16px;
    }

    .metadata-card__key {
        font-family: var(--font-mono);
        font-size: 0.65rem;
        font-weight: 600;
        color: var(--accent);
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }

    .metadata-card__value {
        font-family: var(--font-mono);
        font-size: 0.85rem;
        color: var(--text-secondary);
        line-height: 1.5;
    }

    .metadata-card__value--accent {
        color: var(--accent);
    }

    @media (max-width: 640px) {
        .metadata-card__bar {
            flex-wrap: wrap;
            align-items: flex-start;
        }

        .metadata-card__progress {
            width: 100%;
            align-items: stretch;
        }

        .metadata-card__row {
            grid-template-columns: 1fr;
            gap: 4px;
        }
    }
</style>

<script>
    function initProgressBar() {
        const fill = document.querySelector<HTMLElement>(
            ".metadata-card__progress-fill",
        );
        const label = document.querySelector<HTMLElement>(
            ".metadata-card__percentage",
        );

        if (!fill) return;

        // Leer el valor inicial que Astro escribió en el data-attribute
        const initial = Number(fill.dataset.initial ?? 0);

        // Delay de 300ms → la barra "carga" visualmente al abrir el módulo.
        setTimeout(() => {
            setProgress(initial, fill, label);
        }, 300);

        // Cada vez que el usuario visita un ítem, TabsNav emite tnav:progress.
        document.addEventListener("tnav:progress", (e: Event) => {
            const { pct } = (
                e as CustomEvent<{ done: number; total: number; pct: number }>
            ).detail;
            setProgress(pct, fill, label);
        });
    }

    /**
     * Actualiza el ancho del fill y el texto del label.
     */
    function setProgress(
        pct: number,
        fill: HTMLElement,
        label: HTMLElement | null,
    ) {
        fill.style.width = `${pct}%`;
        if (label) label.textContent = `${pct}%`;
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initProgressBar);
    } else {
        initProgressBar();
    }
</script>
