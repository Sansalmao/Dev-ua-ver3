---
interface Props {
    filename: string;
    dotColor: "red" | "yellow" | "green" | "neutral";
    title: string;
    description?: string;
}

const { filename, dotColor, title, description } = Astro.props;

const dotClass = {
    red: "d-r",
    yellow: "d-y",
    green: "d-g",
    neutral: "d-n",
}[dotColor];
---

<div class="deco-card">
    <div class="dc-head">
        <div class={dotClass} aria-hidden="true"></div>
        <span class="dc-fname">{filename}</span>
    </div>

    <div class="dc-body">
        <div class="icon-sm">
            <slot name="icon" />
        </div>

        <div class="dc-title">{title}</div>
        {description && <p class="dc-desc">{description}</p>}
    </div>
</div>

<style>
    .deco-card {
        border-radius: 14px;
        border: 1px solid var(--border);
        background: var(--card-bg);
        overflow: hidden;
        transition: box-shadow var(--transition-fast);
    }

    .deco-card:hover {
        box-shadow: var(--shadow-soft);
    }

    .dc-head {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 8px 12px;
        background: var(--bg);
        border-bottom: 1px solid var(--border);
    }

    .dc-fname {
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--text-muted);
    }

    .dc-body {
        padding: 18px;
    }

    .icon-sm {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: var(--accent-bg-soft);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 12px;
        color: var(--accent);
    }

    /* Sin "export default" — título directo con más peso */
    .dc-title {
        font-size: 14px;
        font-weight: 700;
        color: var(--text);
        margin-bottom: 8px;
    }

    /* Descripción justificada */
    .dc-desc {
        font-size: 12.5px;
        color: var(--text-secondary);
        line-height: 1.6;
        text-align: justify;
        margin: 0;
    }
</style>
