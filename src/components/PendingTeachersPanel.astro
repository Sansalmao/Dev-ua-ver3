---
//  Consume  GET /api/admin/teachers  y conecta los botones a
//  PATCH /api/admin/teachers/:id/verify, refrescando la lista sin recargar.
//  Usa `credentials: 'include'` para que viaje la cookie de sesión.
// ============================================================================
---

<section class="mx-auto max-w-3xl p-4">
    <div class="mb-4 flex items-center justify-between">
        <h2 class="text-lg font-bold text-neutral-800">
            Profesores pendientes
        </h2>
        <span
            id="pt-count"
            class="rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-semibold text-amber-700"
            >0</span
        >
    </div>

    <!-- Estados -->
    <p id="pt-loading" class="text-sm text-neutral-500">Cargando…</p>
    <p id="pt-error" class="hidden text-sm text-red-600"></p>
    <p id="pt-empty" class="hidden text-sm text-neutral-500">
        No hay profesores pendientes de verificación.
    </p>

    <!-- Lista -->
    <ul id="pt-list" class="flex flex-col gap-2"></ul>
</section>

<script>
    const API_LIST = "/api/admin/teachers";
    const API_VERIFY = (id) => `/api/admin/teachers/${id}/verify`;

    const $list = document.getElementById("pt-list");
    const $count = document.getElementById("pt-count");
    const $loading = document.getElementById("pt-loading");
    const $error = document.getElementById("pt-error");
    const $empty = document.getElementById("pt-empty");

    function showError(msg) {
        $error.textContent = msg;
        $error.classList.remove("hidden");
    }

    function row(t) {
        const li = document.createElement("li");
        li.className =
            "flex items-center justify-between gap-3 rounded-lg border border-neutral-200 bg-white px-4 py-3";
        li.dataset.id = t.id;

        const name = t.displayName || t.email;
        li.innerHTML = `
      <div class="min-w-0">
        <p class="truncate text-sm font-semibold text-neutral-800">${name}</p>
        <p class="truncate text-xs text-neutral-500">${t.email}</p>
      </div>
      <div class="flex shrink-0 gap-2">
        <button data-action="APPROVE"
          class="rounded-md bg-emerald-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-emerald-700 disabled:opacity-50">
          Aprobar
        </button>
        <button data-action="REJECT"
          class="rounded-md border border-neutral-300 px-3 py-1.5 text-xs font-semibold text-neutral-700 hover:bg-neutral-50 disabled:opacity-50">
          Rechazar
        </button>
      </div>`;

        li.querySelectorAll("button").forEach((btn) => {
            btn.addEventListener("click", () =>
                verify(t.id, btn.dataset.action, li),
            );
        });
        return li;
    }

    async function verify(id, action, li) {
        const buttons = li.querySelectorAll("button");
        buttons.forEach((b) => (b.disabled = true)); // estado de carga (T4.6)
        try {
            const res = await fetch(API_VERIFY(id), {
                method: "PATCH",
                headers: { "Content-Type": "application/json" },
                credentials: "include",
                body: JSON.stringify({ action }),
            });
            if (!res.ok) {
                const { error } = await res.json().catch(() => ({}));
                throw new Error(error || `Error ${res.status}`);
            }
            // Éxito → quitar la fila y actualizar contador, sin recargar.
            li.remove();
            const n = $list.children.length;
            $count.textContent = String(n);
            if (n === 0) $empty.classList.remove("hidden");
        } catch (e) {
            showError(e.message);
            buttons.forEach((b) => (b.disabled = false));
        }
    }

    async function load() {
        try {
            const res = await fetch(API_LIST, { credentials: "include" });
            if (!res.ok) {
                const { error } = await res.json().catch(() => ({}));
                throw new Error(error || `Error ${res.status}`);
            }
            const { teachers } = await res.json();
            $loading.classList.add("hidden");
            $count.textContent = String(teachers.length);

            if (teachers.length === 0) {
                $empty.classList.remove("hidden");
                return;
            }
            teachers.forEach((t) => $list.appendChild(row(t)));
        } catch (e) {
            $loading.classList.add("hidden");
            showError(e.message);
        }
    }

    load();
</script>
