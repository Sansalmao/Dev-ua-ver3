    .step-enter {
        animation: stepIn 0.25s ease both;
    }

    @keyframes pulseOnce {
        0% {
            box-shadow: 0 0 0 0 rgba(234, 88, 12, 0.4);
        }
        70% {
            box-shadow: 0 0 0 8px rgba(234, 88, 12, 0);
        }
        100% {
            box-shadow: 0 0 0 0 rgba(234, 88, 12, 0);
        }
