        background: var(--card-bg);
        border-radius: 20px;
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.18);
        transform: translateY(16px);
        opacity: 0;
        transition:
            transform 0.3s ease,
            opacity 0.3s ease;
        overflow: hidden;
    }

    .modal-overlay.open .modal-panel {
        transform: translateY(0);
