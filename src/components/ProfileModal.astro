</style>

<script>
    import { RUTAS, BASICA_POR_ROL, ICONS, resolverRuta } from "../lib/rutas";

    // ── STORAGE ──────────────────────────────────────────────────────────────────

    const STORAGE_KEY = "ua_skills_v2";

    function cargarEstado() {
        try {
            const raw = localStorage.getItem(STORAGE_KEY);
            if (raw) {
                const p = JSON.parse(raw);
                if (p && typeof p === "object")
                    return {
                        rol: p.rol ?? null,
                        ruta: p.ruta ?? null,
                        temas: p.temas ?? {},
                    };
            }
        } catch (e) {}
        return { rol: null, ruta: null, temas: {} };
    }

    const store = cargarEstado();

    function guardar() {
        try {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(store));
        } catch (e) {}
    }

    function setStore(cambios: Record<string, unknown>) {
        Object.assign(store, cambios);
        guardar();
    }

    function setTema(id: string, cambios: Record<string, unknown>) {
        store.temas[id] = {
            ...(store.temas[id] ?? { visitado: false, completado: false }),
            ...cambios,
        };
        guardar();
    }

    // ── GUARD: solo ejecutar en index.astro ──────────────────────────────────────

    const overlay = document.getElementById("modal-overlay");
    const viewHome = document.getElementById("view-home");
    const viewGrid = document.getElementById("view-grid");
    const topicsCont = document.getElementById("topics-container");

    if (!overlay || !viewHome || !viewGrid || !topicsCont) {
        throw new Error(
            "[ProfileModal] Elementos requeridos no encontrados en el DOM. ¿Estás en index.astro?",
        );
    }

    // A partir de aquí todos los elementos están garantizados como no-nulos.
    const step1El = document.getElementById("step-1") as HTMLElement;
    const step2El = document.getElementById("step-2") as HTMLElement;
    const stepLbl = document.getElementById("step-lbl") as HTMLElement;
    const modalTitle = document.getElementById("modal-title") as HTMLElement;
    const footHint = document.getElementById("foot-hint") as HTMLElement;
    const footS2 = document.getElementById("foot-s2") as HTMLElement;
    const progFill = document.getElementById("modal-prog-fill") as HTMLElement;
    let rolActual: string | null = null;

    // ── TOAST ────────────────────────────────────────────────────────────────────

    function toast(msg: string, duration = 2800) {
        document.dispatchEvent(
            new CustomEvent("toast:show", {
                detail: { message: msg, duration },
            }),
        );
    }

    // ── ANIMACIONES ──────────────────────────────────────────────────────────────

    function runAnim(
        el: HTMLElement,
        keyframeName: string,
        duration: number,
    ): Promise<void> {
        return new Promise((resolve) => {
            el.style.animation = `${keyframeName} ${duration}ms ease forwards`;
            el.addEventListener(
                "animationend",
                () => {
                    el.style.animation = "";
                    resolve();
                },
                { once: true },
            );
        });
    }

    // ── MODAL ────────────────────────────────────────────────────────────────────

    function abrirModal() {
        overlay.classList.add("open");
        document.body.style.overflow = "hidden";

        // Foco al primer elemento interactivo para accesibilidad
        const primerBoton = overlay.querySelector<HTMLElement>("[data-rol]");
        primerBoton?.focus();
    }

    function cerrarModal() {
        overlay.classList.remove("open");
        document.body.style.overflow = "";
        setTimeout(irAPaso1, 300);
    }

    function irAPaso1() {
        step1El.classList.remove("hidden");
        step1El.classList.add("step-enter");
        step2El.classList.add("hidden");
        footHint.style.display = "block";
        footS2.style.display = "none";
        stepLbl.textContent = "Paso 1 de 2";
        modalTitle.textContent = "Selecciona tu Perfil";
        progFill.style.width = "50%";
        document
            .querySelectorAll(".sel-card")
            .forEach((c) => c.classList.remove("chosen", "pulse"));
        rolActual = null;
        setTimeout(() => step1El.classList.remove("step-enter"), 300);
    }

    function irAPaso2(rol: string) {
        // Inyectar textos ANTES de mostrar el paso
        const d = BASICA_POR_ROL[rol];
        document.getElementById("basica-export")!.textContent = d.export;
        document.getElementById("basica-titulo")!.textContent = d.titulo;
        document.getElementById("basica-desc")!.textContent = d.desc;

        step1El.classList.add("hidden");
        step2El.classList.remove("hidden");
        step2El.classList.add("step-enter");
        footHint.style.display = "none";
        footS2.style.display = "flex";
        stepLbl.textContent = "Paso 2 de 2";
        modalTitle.textContent = "Configura tu Ruta de Skills";
        progFill.style.width = "100%";
        setTimeout(() => step2El.classList.remove("step-enter"), 300);
    }

    // ── GRID ─────────────────────────────────────────────────────────────────────

    function construirCard(
        t: (typeof RUTAS)[string]["temas"][number],
        esAvanzada: boolean = false,
    ): string {
        const est = store.temas[t.id] ?? { visitado: false, completado: false };
        const nivelClass = t.nivel === "Avanzado" ? "avanzado" : "basico";

        let botonHtml = "";
        let progHtml = "";

        if (esAvanzada) {
            // Botón deshabilitado para rutas avanzadas
            botonHtml = `
                <button type="button" class="btn-iniciar btn-disabled" disabled data-id="${t.id}">
                    🔒 Próximamente
                </button>
            `;
        } else {
            const btnLabel = est.completado
                ? "$ revisar"
                : est.visitado
                  ? "$ continuar"
                  : "$ iniciar";
            if (t.slug) {
                botonHtml = `<a href="/modulos/${t.slug}" class="btn-iniciar" data-id="${t.id}" data-slug="${t.slug}">${btnLabel}</a>`;
            } else {
                botonHtml = `<button type="button" class="btn-iniciar" data-id="${t.id}">${btnLabel}</button>`;
            }

            if (est.visitado) {
                progHtml = `
                    <div class="tc-prog">
                        <div class="tc-prog-lbl">Progreso: ${est.completado ? "100" : "60"}%</div>
                        <div class="tc-prog-bg">
                            <div class="tc-prog-fill ${est.completado ? "green" : "orange"}"
                                 style="width:${est.completado ? 100 : 60}%"></div>
                        </div>
                    </div>
                `;
            }
        }

        const cardClass = est.completado
            ? "completed"
            : est.visitado
              ? "visited"
              : "";
        const sbadge = est.completado
            ? `<span class="tc-sbadge done">✓ completado</span>`
            : est.visitado
              ? `<span class="tc-sbadge prog">en progreso</span>`
              : "";

        return `
            <div class="topic-card ${cardClass}" data-id="${t.id}" style="opacity:0;transform:translateY(14px)">
                <div class="tc-top">
                    <div class="tc-icon-box">${ICONS[t.icon] ?? ICONS["doc"]}</div>
                    <div class="tc-info">
                        <div class="tc-title">${t.titulo}${sbadge}</div>
                        <div class="tc-badges">
                            <span class="tc-nivel ${nivelClass}">${t.nivel}</span>
                            <span class="tc-dur">
                                <svg width="11" height="11" viewBox="0 0 24 24" fill="none"
                                    stroke="currentColor" stroke-width="2">
                                    <circle cx="12" cy="12" r="10"/>
                                    <polyline points="12 6 12 12 16 14"/>
                                </svg>
                                ${t.duracion}
                            </span>
                        </div>
                    </div>
                </div>
                <p class="tc-desc">${t.descripcion}</p>
                <div class="tc-foot">
                    ${botonHtml}
                    ${progHtml}
                </div>
            </div>`;
    }

    function actualizarProgreso(temas: (typeof RUTAS)[string]["temas"]) {
        const total = temas.length;
        const completados = temas.filter(
            (t) => store.temas[t.id]?.completado,
        ).length;
        const pct = total > 0 ? Math.round((completados / total) * 100) : 0;

        const numEl = document.querySelector<HTMLElement>("[data-prog-num]");
        const totEl = document.querySelector<HTMLElement>("[data-prog-tot]");
        const barEl = document.querySelector<HTMLElement>("[data-prog-bar]");
        const pctEl = document.querySelector<HTMLElement>("[data-prog-pct]");

        if (numEl) numEl.textContent = String(completados);
        if (totEl) totEl.textContent = `/${total}`;
        if (barEl) barEl.style.width = `${pct}%`;
        if (pctEl) pctEl.textContent = `${pct}% COMPLETADO`;
    }

    async function mostrarGrid(
        claveRuta: string,
        sinTransicion = false,
        soloRefresh = false,
    ) {
        const ruta = RUTAS[claveRuta];
        if (!ruta) return;

        const esAvanzada =
            claveRuta === "educator_avanzada" ||
            claveRuta === "learner_avanzada";

        document.getElementById("grid-titulo")!.textContent = ruta.titulo;
        document.getElementById("grid-badge")!.textContent =
            `✦ ${ruta.subtitulo}`;
        document.getElementById("grid-desc")!.textContent = ruta.desc;

        // Pasar esAvanzada a construirCard
        topicsCont.innerHTML = ruta.temas
            .map((t) => construirCard(t, esAvanzada))
            .join("");
        actualizarProgreso(ruta.temas);

        // ... resto del código igual, pero cuidado con registrarBotones
        if (soloRefresh) {
            topicsCont
                .querySelectorAll<HTMLElement>(".topic-card")
                .forEach((card, i) => {
                    setTimeout(() => {
                        card.style.transition = `opacity .35s ease ${i * 60}ms, transform .35s ease ${i * 60}ms`;
                        card.style.opacity = "1";
                        card.style.transform = "translateY(0)";
                    }, 40);
                });
            if (!esAvanzada) registrarBotones(ruta.temas);
            return;
        }

        // ... animaciones
        if (sinTransicion) {
            viewHome.classList.add("oculto");
            viewGrid.classList.add("visible");
        } else {
            await runAnim(viewHome, "homeExit", 210);
            viewHome.classList.add("oculto");
            viewGrid.classList.add("visible");
            await runAnim(viewGrid, "gridEnter", 360);
        }

        const delay = sinTransicion ? 80 : 40;
        topicsCont
            .querySelectorAll<HTMLElement>(".topic-card")
            .forEach((card, i) => {
                setTimeout(() => {
                    card.style.transition = `opacity .35s ease ${i * 60}ms, transform .35s ease ${i * 60}ms`;
                    card.style.opacity = "1";
                    card.style.transform = "translateY(0)";
                }, delay);
            });

        if (!esAvanzada) registrarBotones(ruta.temas);
    }

    async function volverAlHome() {
        await runAnim(viewGrid, "gridExit", 210);
        viewGrid.classList.remove("visible");
        viewHome.classList.remove("oculto");
        await runAnim(viewHome, "homeEnter", 320);
    }

    // ── BOTONES DE CARDS ─────────────────────────────────────────────────────────

    function registrarBotones(temas: (typeof RUTAS)[string]["temas"]) {
        topicsCont
            .querySelectorAll<HTMLButtonElement>("button.btn-iniciar")
            .forEach((btn) => {
                btn.addEventListener("click", (e) => {
                    e.stopPropagation();
                    const id = btn.dataset.id!;
                    const est = store.temas[id] ?? {};

                    if (!est.completado) {
                        setTema(id, { visitado: true });
                        toast("Módulo iniciado — progreso guardado");

                        setTimeout(() => {
                            setTema(id, { completado: true });
                            toast("✓ Módulo completado");
                            mostrarGrid(
                                resolverRuta(store.rol ?? "", store.ruta ?? ""),
                                false,
                                true,
                            );
                        }, 1500);
                    } else {
                        toast("Módulo completado — revisando contenido");
                    }
                });
            });

        topicsCont
            .querySelectorAll<HTMLAnchorElement>("a.btn-iniciar")
            .forEach((enlace) => {
                enlace.addEventListener("click", () => {
                    const id = enlace.dataset.id!;
                    const est = store.temas[id] ?? {
                        visitado: false,
                        completado: false,
                    };
                    if (!est.visitado && !est.completado) {
                        setTema(id, { visitado: true });
                    }
                });
            });
    }

    // ── EVENT LISTENERS ──────────────────────────────────────────────────────────

    // Abrir modal desde el botón CTA del hero
    document.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        if (target.closest("[data-open-profile-modal]")) {
            abrirModal();
        }
    });

    // Cerrar modal
    document
        .getElementById("btn-close")!
        .addEventListener("click", cerrarModal);

    overlay.addEventListener("click", (e) => {
        if (e.target === overlay) cerrarModal();
    });

    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && overlay.classList.contains("open"))
            cerrarModal();
    });

    // Paso 1: selección de rol
    document.querySelectorAll<HTMLElement>("[data-rol]").forEach((card) => {
        card.addEventListener("click", () => {
            document
                .querySelectorAll("[data-rol]")
                .forEach((c) => c.classList.remove("chosen", "pulse"));
            card.classList.add("chosen", "pulse");
            rolActual = card.dataset.rol!;
            setStore({ rol: rolActual });
            setTimeout(() => irAPaso2(rolActual!), 300);
        });
    });

    // Paso 2: selección de ruta
    document.querySelectorAll<HTMLElement>("[data-ruta]").forEach((card) => {
        card.addEventListener("click", () => {
            const ruta = card.dataset.ruta!;
            setStore({ ruta });
            cerrarModal();
            setTimeout(
                () => mostrarGrid(resolverRuta(store.rol ?? "", ruta)),
                320,
            );
        });
    });

    // Volver al paso 1
    document.getElementById("btn-volver")!.addEventListener("click", irAPaso1);

    // Volver al home desde el grid
    document.getElementById("btn-cambiar")!.addEventListener("click", () => {
        setStore({ rol: null, ruta: null });
        volverAlHome();
    });

    // ── RESTAURACIÓN DESDE LOCALSTORAGE ─────────────────────────────────────────

    document.addEventListener("DOMContentLoaded", () => {
        overlay.classList.remove("open");
        document.body.style.overflow = "";
        const forceHome = sessionStorage.getItem("ua_force_home");

        if (forceHome) {
            sessionStorage.removeItem("ua_force_home");
            setStore({ rol: null, ruta: null });
            return;
        }

        if (store.rol && store.ruta) {
            mostrarGrid(resolverRuta(store.rol, store.ruta), true);
        }
    });
</script>
