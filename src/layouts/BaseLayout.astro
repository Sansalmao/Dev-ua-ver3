---
import "../styles/global.css";

interface Props {
    title: string;
    description?: string;
    canonicalURL?: string;
}

const {
    title,
    description = "Plataforma de aprendizaje en Aceptación Universal — UA Working Group LACNOG",
    canonicalURL = Astro.url.href,
} = Astro.props;
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <!-- SEO básico -->
        <title>{title} | Skills UA</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalURL} />

        <!-- Favicon -->
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

        <!--
      Fuentes: Sora + JetBrains Mono
      Fuente: Guía Visual v2.0 — UA WG LACNOG
      preconnect  → conexión anticipada con Google Fonts
      display=swap → fuente del sistema mientras carga la web font
    -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600;700&display=swap"
            rel="stylesheet"
        />
    </head>

    <body>
        <header>
            <slot name="navbar" />
        </header>

        <main>
            <slot />
        </main>

        <footer>
            <slot name="footer" />
        </footer>
    </body>
</html>
