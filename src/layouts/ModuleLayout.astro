---
import BaseLayout from "./BaseLayout.astro";
import NavBar from "../components/NavBar.astro";
import BreadCrumb from "../components/BreadCrumb.astro";
import PageHeader from "../components/PageHeader.astro";
import MetadataCard from "../components/MetadataCard.astro";
import TabsNav from "../components/TabsNav.astro";
import TabsPanel from "../components/TabsPanel.astro"; // ← nuevo
import type { ModuleSection } from "../lib/module-schema";

interface Props {
    title: string;
    description?: string;
    padre: string;
    padreHref: string;
    titulo: string;
    subtitulo: string;
    dificultad: string;
    duracion: string;
    objetivo: string;
    progreso?: number;
    filename: string;
    sections?: ModuleSection[];
}

const {
    title,
    description,
    padre,
    padreHref,
    titulo,
    subtitulo,
    dificultad,
    duracion,
    objetivo,
    progreso = 0,
    filename,
    sections = [],
} = Astro.props;

const hasNav = sections.length > 0;

// El defaultPanel es el panelId del primer ítem de la primera sección.
// Se pasa a TabsPanel para que active ese panel al cargar sin esperar
// el primer click del usuario.
const defaultPanel = sections[0]?.items[0]?.panelId ?? "";
---

<BaseLayout title={title} description={description}>
    <NavBar slot="navbar" />

    <div class="module-wrap">
        <BreadCrumb padre={padre} padreHref={padreHref} actual={titulo} />
        <PageHeader titulo={titulo} descripcion={subtitulo} />
        <MetadataCard
            dificultad={dificultad}
            tiempo={duracion}
            objetivo={objetivo}
            progreso={progreso}
            filename={filename}
        />

        <div
            class={hasNav ? "module-body module-body--with-nav" : "module-body"}
        >
            {
                hasNav && (
                    <aside class="module-sidebar">
                        {/* TabsNav con el primer panel activo por defecto */}
                        <TabsNav
                            sections={sections}
                            activePanel={defaultPanel}
                        />
                    </aside>
                )
            }

            <div class="module-content">
                {
                    hasNav ? (
                        /*
                         * Con navegación: el slot se renderiza dentro de TabsPanel,
                         * que lo segmenta en paneles y escucha los eventos tabchange.
                         */
                        <TabsPanel defaultPanel={defaultPanel}>
                            <slot />
                        </TabsPanel>
                    ) : (
                        /*
                         * En módulos simples el contenido se muestra
                         * completo sin segmentar.*/
                        <slot />
                    )
                }
            </div>
        </div>
    </div>

    <script>
        // Botón copiar en bloques de código MDX
        function initCopyButtons() {
            const codeBlocks = document.querySelectorAll(".module-content pre");

            codeBlocks.forEach((pre) => {
                const btn = document.createElement("button");
                btn.type = "button";
                btn.className = "copy-btn";
                btn.setAttribute("aria-label", "Copiar código");
                btn.innerHTML = `
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <rect x="9" y="9" width="13" height="13" rx="2"/>
                        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                    </svg>
                    <span>Copiar</span>
                `;

                btn.addEventListener("click", async () => {
                    const code = pre.querySelector("code");
                    const text = code?.textContent ?? pre.textContent ?? "";
                    try {
                        await navigator.clipboard.writeText(text);
                        btn.classList.add("copied");
                        btn.querySelector("span")!.textContent = "✓ Copiado";
                        setTimeout(() => {
                            btn.classList.remove("copied");
                            btn.querySelector("span")!.textContent = "Copiar";
                        }, 2000);
                    } catch {
                        const ta = document.createElement("textarea");
                        ta.value = text;
                        ta.style.cssText = "position:fixed;opacity:0";
                        document.body.appendChild(ta);
                        ta.select();
                        document.execCommand("copy");
                        document.body.removeChild(ta);
                    }
                });

                pre.appendChild(btn);
            });
        }

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", initCopyButtons);
        } else {
            initCopyButtons();
        }
    </script>
</BaseLayout>

<style>
    .module-wrap {
        max-width: 1100px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
    }

    .module-body {
        width: 100%;
    }

    .module-body--with-nav {
        display: grid;
        grid-template-columns: 280px 1fr;
        gap: 40px;
        align-items: flex-start;
    }

    .module-sidebar {
        position: sticky;
        top: 88px;
    }

    .module-content {
        min-width: 0;
        max-width: 760px;
        padding-left: 8px;
    }

    @media (max-width: 900px) {
        .module-body--with-nav {
            grid-template-columns: 1fr;
        }

        .module-sidebar {
            position: static;
        }

        .module-content {
            padding-left: 0;
        }
    }
</style>
