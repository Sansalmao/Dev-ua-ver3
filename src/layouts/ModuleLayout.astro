---
import BaseLayout from "./BaseLayout.astro";
import NavBar from "../components/NavBar.astro";
import BreadCrumb from "../components/BreadCrumb.astro";
import PageHeader from "../components/PageHeader.astro";
import MetadataCard from "../components/MetadataCard.astro";
import TabsNav from "../components/TabsNav.astro";
import TabsPanel from "../components/TabsPanel.astro"; // ← nuevo
import type { ModuleSection } from "../lib/module-schema";

interface Props {
    title: string;
    description?: string;
    padre: string;
    padreHref: string;
    titulo: string;
    subtitulo: string;
    dificultad: string;
    duracion: string;
    objetivo: string;
    progreso?: number;
    filename: string;
    sections?: ModuleSection[];
}

const {
    title,
    description,
    padre,
    padreHref,
    titulo,
    subtitulo,
    dificultad,
    duracion,
    objetivo,
    progreso = 0,
    filename,
    sections = [],
} = Astro.props;

const hasNav = sections.length > 0;

// El defaultPanel es el panelId del primer ítem de la primera sección.
// Se pasa a TabsPanel para que active ese panel al cargar sin esperar
// el primer click del usuario.
const defaultPanel = sections[0]?.items[0]?.panelId ?? "";
---

<BaseLayout title={title} description={description}>
    <NavBar slot="navbar" />

    <div class="module-wrap">
        <div class="module-topbar">
            <BreadCrumb padre={padre} padreHref={padreHref} actual={titulo} />
            <a href="/" class="btn-back-ruta" id="btn-back-ruta">
                <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path d="M19 12H5M12 19l-7-7 7-7"></path>
                </svg>
                Volver a la ruta
            </a>
        </div>
        <PageHeader titulo={titulo} descripcion={subtitulo} />
        <MetadataCard
            dificultad={dificultad}
            tiempo={duracion}
            objetivo={objetivo}
            progreso={progreso}
            filename={filename}
        />

        <div
            class={hasNav ? "module-body module-body--with-nav" : "module-body"}
        >
            {
                hasNav && (
                    <aside class="module-sidebar">
                        {/* TabsNav con el primer panel activo por defecto */}
                        <TabsNav
                            sections={sections}
                            activePanel={defaultPanel}
                        />
                    </aside>
                )
            }

            <div class="module-content">
                {
                    hasNav ? (
                        /*
                         * Con navegación: el slot se renderiza dentro de TabsPanel,
                         * que lo segmenta en paneles y escucha los eventos tabchange.
                         */
                        <TabsPanel defaultPanel={defaultPanel}>
                            <slot />
                        </TabsPanel>
                    ) : (
                        /*
                         * En módulos simples el contenido se muestra
                         * completo sin segmentar.*/
                        <slot />
                    )
                }
            </div>
        </div>
    </div>

    <script>
        // ═══════════════════════════════════════════════════════════════════════
        // NÚMEROS DE LÍNEA + FOLD (acoplamiento de bloques {}, [], ())
        // ═══════════════════════════════════════════════════════════════════════
        //
        // processCodeBlock():
        //   1. Divide el innerHTML del <code> por \n
        //   2. Detecta líneas que abren bloque ({ [ ( al final) para añadir
        //      una flecha ▶ de fold en el gutter
        //   3. Envuelve cada línea en:
        //        <span class="code-line [code-line--foldable]" data-fold-id="N">
        //          <span class="code-line-num">
        //            [<button class="fold-btn">▶</button>]
        //            N
        //          </span>
        //          <span class="code-line-content">...</span>
        //        </span>
        //   4. Las líneas interiores de un bloque foldable reciben
        //      data-fold-child="N" para poder ocultarlas todas al colapsar.
        //   5. join("") — sin \n entre spans, elimina las líneas vacías
        //      que aparecían entre cada línea de código.

        // Abre bloque: termina en { o [ o ( (ignorando espacios y comentarios)
        const OPENS = /[{\[(]\s*(?:\/\/.*)?(?:\/\*.*)?$/;
        // Cierra bloque: empieza en } o ] o )
        const CLOSES = /^\s*[}\])]/;

        function processCodeBlock(codeEl: HTMLElement) {
            if (codeEl.querySelector(".code-line")) return;

            const rawHtml = codeEl.innerHTML;
            const lines = rawHtml.split("\n");

            // Quitar trailing newline vacío del fenced block
            if (lines.length > 0 && lines[lines.length - 1].trim() === "") {
                lines.pop();
            }

            // ── Detectar bloques foldables ─────────────────────────────────
            // Cada entrada: { open: lineIndex, close: lineIndex }
            type FoldRange = { open: number; close: number };
            const foldRanges: FoldRange[] = [];
            const stack: number[] = [];

            lines.forEach((lineHtml, i) => {
                const text = lineHtml.replace(/<[^>]+>/g, ""); // strip tags
                if (OPENS.test(text)) stack.push(i);
                if (CLOSES.test(text) && stack.length > 0) {
                    const openIdx = stack.pop()!;
                    // Solo registrar si el bloque tiene >1 línea interior
                    if (i - openIdx > 1) {
                        foldRanges.push({ open: openIdx, close: i });
                    }
                }
            });

            // Mapa: lineIndex → foldId (para líneas que abren bloque)
            const foldOpeners = new Map<number, number>();
            // Mapa: lineIndex → Set<foldId> (para líneas interiores)
            const foldChildren = new Map<number, Set<number>>();

            foldRanges.forEach((range, foldId) => {
                foldOpeners.set(range.open, foldId);
                for (let i = range.open + 1; i <= range.close; i++) {
                    if (!foldChildren.has(i)) foldChildren.set(i, new Set());
                    foldChildren.get(i)!.add(foldId);
                }
            });

            // ── Construir HTML de las líneas ───────────────────────────────
            const html = lines
                .map((lineHtml, i) => {
                    const num = i + 1;
                    const content = lineHtml === "" ? "\u00A0" : lineHtml;
                    const foldId = foldOpeners.get(i);
                    const children = foldChildren.get(i);

                    const isFoldable = foldId !== undefined;
                    const isChild = children && children.size > 0;
                    const childAttr = isChild
                        ? ` data-fold-child="${[...children!].join(" ")}"`
                        : "";
                    const foldAttr = isFoldable
                        ? ` data-fold-id="${foldId}"`
                        : "";
                    const lineClass = [
                        "code-line",
                        isFoldable ? "code-line--foldable" : "",
                    ]
                        .filter(Boolean)
                        .join(" ");

                    // Flecha de fold — solo en líneas que abren bloque
                    const foldBtn = isFoldable
                        ? `<button class="fold-btn" aria-label="Colapsar bloque" data-fold-target="${foldId}">` +
                          `<svg width="8" height="8" viewBox="0 0 8 8" fill="currentColor" aria-hidden="true">` +
                          `<path d="M2 1l4 3-4 3V1z"/>` +
                          `</svg></button>`
                        : "";

                    return (
                        `<span class="${lineClass}"${foldAttr}${childAttr}>` +
                        `<span class="code-line-num" aria-hidden="true">${foldBtn}${num}</span>` +
                        `<span class="code-line-content">${content}</span>` +
                        `</span>`
                    );
                })
                .join(""); // ← join("") sin \n evita líneas vacías entre spans

            codeEl.innerHTML = html;

            // ── Listeners de fold ──────────────────────────────────────────
            codeEl
                .querySelectorAll<HTMLButtonElement>(".fold-btn")
                .forEach((btn) => {
                    btn.addEventListener("click", (e) => {
                        e.stopPropagation();
                        const foldId = btn.dataset.foldTarget!;
                        const opener = codeEl.querySelector<HTMLElement>(
                            `.code-line[data-fold-id="${foldId}"]`,
                        );
                        if (!opener) return;

                        const isCollapsed = opener.classList.toggle(
                            "code-line--collapsed",
                        );

                        // Ocultar/mostrar todas las líneas hijas
                        codeEl
                            .querySelectorAll<HTMLElement>(
                                `[data-fold-child~="${foldId}"]`,
                            )
                            .forEach((child) => {
                                child.style.display = isCollapsed ? "none" : "";
                            });

                        // Rotar la flecha
                        btn.classList.toggle("fold-btn--open", !isCollapsed);
                    });
                });
        }

        function initLineNumbers() {
            document
                .querySelectorAll<HTMLElement>(".code-switcher pre code")
                .forEach(processCodeBlock);
        }

        // ── LANG SWITCHER ─────────────────────────────────────────────────────
        function initSwitchers() {
            document
                .querySelectorAll<HTMLElement>(".code-switcher")
                .forEach((switcher) => {
                    const btns =
                        switcher.querySelectorAll<HTMLButtonElement>(
                            ".lang-btn",
                        );
                    const blocks =
                        switcher.querySelectorAll<HTMLElement>(".lang-block");

                    btns.forEach((btn) => {
                        btn.addEventListener("click", () => {
                            const lang = btn.dataset.lang;
                            if (!lang) return;

                            btns.forEach((b) => b.classList.remove("active"));
                            blocks.forEach((b) => b.classList.remove("active"));

                            btn.classList.add("active");
                            const activeBlock =
                                switcher.querySelector<HTMLElement>(
                                    `.lang-block[data-lang="${lang}"]`,
                                );
                            activeBlock?.classList.add("active");

                            if (activeBlock) {
                                const code =
                                    activeBlock.querySelector<HTMLElement>(
                                        "pre code",
                                    );
                                if (code) processCodeBlock(code);
                            }
                        });
                    });
                });
        }

        // ── BOTÓN COPIAR ──────────────────────────────────────────────────────
        function addCopyButton(pre: HTMLElement) {
            if (pre.querySelector(".copy-btn")) return;

            const btn = document.createElement("button");
            btn.type = "button";
            btn.className = "copy-btn";
            btn.setAttribute("aria-label", "Copiar código");
            btn.innerHTML = `
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <rect x="9" y="9" width="13" height="13" rx="2"/>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                </svg>
                <span>Copiar</span>
            `;

            btn.addEventListener("click", async () => {
                const code = pre.querySelector("code");
                // Extraer texto plano sin los números de línea del gutter
                const lines =
                    code?.querySelectorAll<HTMLElement>(".code-line-content");
                const text =
                    lines && lines.length > 0
                        ? Array.from(lines)
                              .map((l) => l.textContent ?? "")
                              .join("\n")
                        : (code?.textContent ?? pre.textContent ?? "");

                try {
                    await navigator.clipboard.writeText(text);
                } catch {
                    const ta = document.createElement("textarea");
                    ta.value = text;
                    ta.style.cssText = "position:fixed;opacity:0";
                    document.body.appendChild(ta);
                    ta.select();
                    document.execCommand("copy");
                    document.body.removeChild(ta);
                }
                btn.classList.add("copied");
                btn.querySelector("span")!.textContent = "✓ Copiado";
                setTimeout(() => {
                    btn.classList.remove("copied");
                    btn.querySelector("span")!.textContent = "Copiar";
                }, 2000);
            });

            pre.appendChild(btn);
        }

        function initCopyButtons() {
            // Bloques sueltos fuera del switcher
            document
                .querySelectorAll<HTMLElement>(".module-content pre")
                .forEach((pre) => {
                    if (pre.closest(".code-switcher")) return;
                    addCopyButton(pre);
                });

            // Bloques dentro del switcher — incluyendo los ocultos
            document
                .querySelectorAll<HTMLElement>(".code-switcher pre")
                .forEach((pre) => {
                    addCopyButton(pre);
                });
        }

        // ── BOTÓN VOLVER ──────────────────────────────────────────────────────
        const btnRuta = document.getElementById("btn-back-ruta");
        if (btnRuta) {
            btnRuta.addEventListener("click", (e) => {
                e.preventDefault();
                const wrap = document.querySelector(
                    ".module-wrap",
                ) as HTMLElement;
                if (wrap) {
                    wrap.style.transition =
                        "opacity 0.2s ease, transform 0.2s ease";
                    wrap.style.opacity = "0";
                    wrap.style.transform = "translateY(8px)";
                }
                setTimeout(() => {
                    window.location.href = "/";
                }, 220);
            });
        }

        // ── INIT ──────────────────────────────────────────────────────────────
        function initAll() {
            initLineNumbers();
            initSwitchers();
            initCopyButtons();
        }

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", initAll);
        } else {
            initAll();
        }
    </script>
</BaseLayout>

<style>
    .module-wrap {
        max-width: 1100px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
    }

    /* Fila superior: breadcrumb a la izquierda, botón a la derecha */
    .module-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
    }

    /* Anular el margin-bottom del breadcrumb porque ahora lo controla el topbar */
    .module-topbar :global(.breadcrumb) {
        margin-bottom: 0;
    }

    /* Botón "Volver a la ruta" */
    .btn-back-ruta {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 18px;
        border-radius: 8px;
        background: var(--accent);
        color: var(--card-bg);
        font-family: var(--font-body);
        font-size: 13px;
        font-weight: 600;
        border: none;
        cursor: pointer;
        white-space: nowrap;
        flex-shrink: 0;
        text-decoration: none;
        transition:
            background var(--transition-fast),
            transform var(--transition-fast),
            opacity var(--transition-fast);
    }

    .btn-back-ruta:hover {
        background: var(--accent-hover);
        color: var(--card-bg);
        transform: translateX(-2px);
    }

    .btn-back-ruta:active {
        transform: translateX(0);
    }

    .module-body {
        width: 100%;
    }

    .module-body--with-nav {
        display: grid;
        grid-template-columns: 280px 1fr;
        gap: 40px;
        align-items: flex-start;
    }

    .module-sidebar {
        position: sticky;
        top: 88px;
    }

    .module-content {
        min-width: 0;
        max-width: 760px;
        padding-left: 8px;
    }

    @media (max-width: 900px) {
        .module-body--with-nav {
            grid-template-columns: 1fr;
        }

        .module-sidebar {
            position: static;
        }

        .module-content {
            padding-left: 0;
        }
    }
</style>
