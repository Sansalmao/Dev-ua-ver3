---
import BaseLayout from "./BaseLayout.astro";
import NavBar from "../components/NavBar.astro";
import BreadCrumb from "../components/BreadCrumb.astro";
import PageHeader from "../components/PageHeader.astro";
import MetadataCard from "../components/MetadataCard.astro";

interface Props {
    title: string;
    description?: string;
    padre: string;
    padreHref: string;
    titulo: string;
    subtitulo: string;
    dificultad: string;
    duracion: string;
    objetivo: string;
    progreso?: number;
}

const {
    title,
    description,
    padre,
    padreHref,
    titulo,
    subtitulo,
    dificultad,
    duracion,
    objetivo,
    progreso = 0,
} = Astro.props;
---

<BaseLayout title={title} description={description}>
    <NavBar slot="navbar" />

    <div class="module-wrap">
        <BreadCrumb padre={padre} padreHref={padreHref} actual={titulo} />

        <PageHeader titulo={titulo} descripcion={subtitulo} />

        <MetadataCard
            dificultad={dificultad}
            tiempo={duracion}
            objetivo={objetivo}
            progreso={progreso}
        />

        <slot />
    </div>
</BaseLayout>

<style>
    .module-wrap {
        max-width: 760px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
    }
</style>
