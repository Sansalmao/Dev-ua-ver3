# ── Desarrollo local ──
# Un archivo SQLite local. No requiere Turso ni token.
DATABASE_URL="file:./dev.db"

# ── Alternativa: réplica local con `turso dev` ──
# DATABASE_URL="http://127.0.0.1:8080"

# ── Producción: Turso (Para más adelante) ──
# Si estas dos están presentes, tienen prioridad sobre DATABASE_URL.
# TURSO_DATABASE_URL="libsql://tu-base.turso.io"
# TURSO_AUTH_TOKEN="tu-token"

