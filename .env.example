# ── Base de datos ───────────────────────────────────────────────────────────
# Desarrollo local:
DATABASE_URL="file:./dev.db"

# ── Producción: Turso ───────────────────────────────────────────────────────
# TURSO_DATABASE_URL="libsql://tu-base.turso.io"
# TURSO_AUTH_TOKEN="tu-token"

# ── Turnstile (registro) ─────────────────────────────────────────────────────
# Secret usado en el servidor para verificar el token (src/lib/turnstile.js).
# TURNSTILE_SECRET_KEY= secret de prueba de Cloudflare que siempre pasa
#
# Site key PÚBLICA usada por el widget en el navegador (AuthModal.astro).
# Astro solo expone al cliente las variables con prefijo PUBLIC_.
# Para dev local podés usar la site key de prueba de Cloudflare que siempre
# pasa: 1x00000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"

# ── Better Auth (OBLIGATORIO) ───────────────────────────────────────────────
# Genera un valor con: openssl rand -base64 32
BETTER_AUTH_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"
# URL base donde corre el backend
BETTER_AUTH_URL="http://localhost:4321"

# ── Sentry ──────────────────────────────────────────────────────────────────
# SENTRY_DSN="https://...ingest.us.sentry.io/..."
# SENTRY_AUTH_TOKEN="sntrys_..."
