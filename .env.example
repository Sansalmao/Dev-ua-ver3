# ── Base de datos ───────────────────────────────────────────────────────────
# Desarrollo local:
DATABASE_URL="file:./dev.db"

# ── Producción: Turso ───────────────────────────────────────────────────────
# Si estas dos están presentes, tienen PRIORIDAD sobre DATABASE_URL.
# No hay que cambiar código: src/lib/prisma.js las detecta solo.
# TURSO_DATABASE_URL="libsql://tu-base.turso.io"
# TURSO_AUTH_TOKEN="tu-token"

# ── Better Auth (OBLIGATORIO) ───────────────────────────────────────────────
# Genera un valor con: openssl rand -base64 32
BETTER_AUTH_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"
# URL base donde corre el backend. En dev es la de astro dev; en producción,
# el dominio real (afecta el dominio de la cookie de sesión).
BETTER_AUTH_URL="http://localhost:4321"

# ── Sentry ──────────────────────────────────────────────────────────────────
# El DSN es PÚBLICO (identifica el proyecto, no da acceso). Ya está por defecto
# en astro.config.mjs; solo defínelo aquí si quieres sobreescribirlo.
# SENTRY_DSN="https://...ingest.us.sentry.io/..."
#
# El AUTH TOKEN es SECRETO: sube source maps en el build. NUNCA se versiona.
# Genéralo/rótalo en https://wg-ua.sentry.io  →  Settings → Auth Tokens
# SENTRY_AUTH_TOKEN="sntrys_..."
