# ── Base de datos ───────────────────────────────────────────────────────────
# Desarrollo local (archivo SQLite/libSQL).
DATABASE_URL="file:./dev.db"

# ── Producción: Turso ───────────────────────────────────────────────────────
# Si estas dos están presentes, TIENEN PRIORIDAD sobre DATABASE_URL.
# No hay que tocar código: src/lib/prisma.js las detecta solo.
# OJO: con estas puestas, `node prisma/seed.js` escribiría en producción.
# TURSO_DATABASE_URL="libsql://tu-base.turso.io"
# TURSO_AUTH_TOKEN="tu-token"

# ── Better Auth (OBLIGATORIO) ───────────────────────────────────────────────
# Firma las sesiones. Generar con: openssl rand -base64 32
# En producción debe ser DISTINTO al de desarrollo.
BETTER_AUTH_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"
# URL base pública de la app (en prod: el dominio real, con https).
BETTER_AUTH_URL="http://localhost:4321"

# ── Cloudflare Turnstile (OBLIGATORIO) ──────────────────────────────────────
# Las llaves van DE A PARES: no mezclar una de prueba con una real.
#
#   Desarrollo → site key: 1x00000000000000000000AA
#                secret:   1x0000000000000000000000000000000AA
#   Producción → las dos del dashboard: https://dash.cloudflare.com/?to=/:account/turnstile
#
# Secret: solo servidor (src/lib/turnstile.js). NO lleva prefijo PUBLIC_.
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
# Site key: pública, la usa el widget en el navegador (AuthModal.astro).
PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"

# ── Sentry ──────────────────────────────────────────────────────────────────
# El DSN es PÚBLICO (identifica el proyecto, no da acceso). Ya hay uno por
# defecto en sentry.*.config.js; definilo acá solo para sobreescribirlo.
# SENTRY_DSN="https://...ingest.us.sentry.io/..."
#
# El AUTH TOKEN es SECRETO: solo sirve para subir source maps en el build.
# Generar/rotar en: https://wg-ua.sentry.io → Settings → Auth Tokens
# SENTRY_AUTH_TOKEN="sntrys_..."
